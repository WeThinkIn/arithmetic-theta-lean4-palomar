@[expose] public section
elab "matcher1981" : term => return Lean.mkConst (((((Lean.Name.num `_private.Lean.Meta.Match.Match 0).str "Lean").str "Meta").str "Match").str "matcherExt")
elab "captureSupport2035" "[" ns:ident,* "]" "in" cmd:command : command => do
 let saved ← get
 Lean.Elab.Command.elabCommand cmd
 let env ← Lean.getEnv
 let mut rows : Array Lean.ConstantInfo := #[]
 for n in ns.getElems do
  let some ci := env.find? n.getId | throwError "Missing captured support {n.getId}"
  rows := rows.push ci
 set saved
 Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.modifyState env fun st =>
  { st with lemmas := rows.foldl (fun st ci => st.insert
    { type := ci.type, isPrivate := false, defeq := false } (ci.name, ci.levelParams)) st.lemmas }
elab "capturedType2035" n:ident : term => do
 for (key, (name, _)) in (Lean.Meta.auxLemmasExt.getState (← Lean.getEnv)).lemmas.toList do
  if name == n.getId then return key.type
 throwError "Missing captured type {n.getId}"

private meta partial def supportName2024 (j : Lean.Json) : Except String Lean.Name := do
 let a ← j.getArr?
 if a.isEmpty then return .anonymous
 match ← a[0]!.getStr? with
 | "s" => return .str (← supportName2024 a[1]!) (← a[2]!.getStr?)
 | "n" => return .num (← supportName2024 a[1]!) (← a[2]!.getNat?)
 | _ => throw "Invalid name"

private meta partial def supportLevel2024 (j : Lean.Json) : Except String Lean.Level := do
 let a ← j.getArr?
 match ← a[0]!.getStr? with
 | "z" => return .zero
 | "s" => return .succ (← supportLevel2024 a[1]!)
 | "m" => return .max (← supportLevel2024 a[1]!) (← supportLevel2024 a[2]!)
 | "i" => return .imax (← supportLevel2024 a[1]!) (← supportLevel2024 a[2]!)
 | "p" => return .param (← supportName2024 a[1]!)
 | _ => throw "Invalid level"

private meta def supportExpr2024 (data : String) (root : Nat) : Except String Lean.Expr := do
 let nodes ← (← Lean.Json.parse data).getArr?
 let mut es : Array Lean.Expr := #[]
 for j in nodes do
  let a ← j.getArr?
  let ref (i : Nat) : Except String Lean.Expr := do
   let n ← a[i]!.getNat?
   if h : n < es.size then return es[n] else throw "Invalid DAG reference"
  let e ← match ← a[0]!.getStr? with
   | "b" => pure <| .bvar (← a[1]!.getNat?)
   | "s" => pure <| .sort (← supportLevel2024 a[1]!)
   | "c" => pure <| .const (← supportName2024 a[1]!) ((← (← a[2]!.getArr?).mapM supportLevel2024).toList)
   | "a" => pure <| .app (← ref 1) (← ref 2)
   | "l" | "f" => do
    let bi ← match ← a[4]!.getStr? with
     | "default" => pure Lean.BinderInfo.default
     | "implicit" => pure .implicit
     | "strictImplicit" => pure .strictImplicit
     | "instImplicit" => pure .instImplicit
     | _ => throw "Invalid binder"
    if (← a[0]!.getStr?) == "l" then
     pure <| .lam (← supportName2024 a[1]!) (← ref 2) (← ref 3) bi
    else pure <| .forallE (← supportName2024 a[1]!) (← ref 2) (← ref 3) bi
   | "e" => pure <| .letE (← supportName2024 a[1]!) (← ref 2) (← ref 3) (← ref 4) (← a[5]!.getBool?)
   | "n" => pure <| .lit (.natVal (← a[1]!.getNat?))
   | "t" => pure <| .lit (.strVal (← a[1]!.getStr?))
   | "p" => pure <| .proj (← supportName2024 a[1]!) (← a[2]!.getNat?) (← ref 3)
   | _ => throw "Invalid expression node"
  es := es.push e
 if h : root < es.size then return es[root] else throw "Invalid root"

