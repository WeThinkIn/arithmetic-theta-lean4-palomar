def poleFormal {hr : 0 < r} (h3 : 3 ≤ r) (T : Tower k r hr) (d : ℕ) (j : Fin d) :
    FormalNumerators k (T := T) d :=
  ⟨fun n => ⟨poleNumerator k r n d j, poleNumerator_compatible k h3 T n d j⟩,
    fun n N h i => poleNumerator_reduce k h3 T n N h d j i⟩

def poleDual {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    (d : ℕ) (j : Fin d) : Dual k M s d :=
  (algebraize_formal k h3 M hM s hs d (poleFormal k h3 T d j)).exists.choose

lemma poleDual_realizes {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    (d : ℕ) (j : Fin d) :
    FormalRealizes k M s d (poleFormal k h3 T d j) (poleDual k h3 M hM s hs d j) :=
  (algebraize_formal k h3 M hM s hs d (poleFormal k h3 T d j)).exists.choose_spec

lemma pulled_sum {C S : Scheme.{u}} (f : S ⟶ C) {L : C.Modules}
    {ι : Type*} (J : Finset ι) (φ : ι → (L ⟶ (𝟙_ C.Modules))) :
    pulledInclusion f (∑ j ∈ J, φ j) = ∑ j ∈ J, pulledInclusion f (φ j) := by
  classical
  induction J using Finset.induction_on with
  | empty => simp [pulledInclusion]
  | @insert j J hj ih =>
    simp only [Finset.sum_insert hj]
    rw [show pulledInclusion f (φ j + ∑ a ∈ J, φ a) = pulledInclusion f (φ j) + pulledInclusion f (∑ a ∈ J, φ a) by
      simp only [pulledInclusion, Functor.map_add, Preadditive.add_comp], ih]

lemma fromSection_unit_sum {C : Scheme.{u}} {ι : Type*} (J : Finset ι)
    (a : ι → Γ(C,⊤)) :
    unitScalar (∑ j ∈ J, a j) = ∑ j ∈ J, unitScalar (a j) := by
  classical
  induction J using Finset.induction_on with
  | empty => apply unit_hom_ext; simp [unitScalar, fromSection_apply]
  | @insert j J hj ih => simp only [Finset.sum_insert hj, fromSection_unit_add, ih]

lemma algebraic_higher_pole_span {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    (d : ℕ) (hd : 0 < d) (φ : Dual k M s d) :
    ∃ c : Fin d → PowerSeries k, φ = ∑ j : Fin d,
      dualScale (L := powerModule k M s d)
        (M.p.appTop ((Scheme.ΓSpecIso (CommRingCat.of (PowerSeries k))).inv (c j)))
        (poleDual k h3 M hM s hs d j) := by
  classical
  let v := AlgebraizedThetaSaturationR0138.algebraicFormal k h3 M hM s hs d φ
  obtain ⟨c, hc, -⟩ := formal_higher_pole_basis k h3 T d hd v
  refine ⟨c, ?_⟩
  apply model_chart_hom_ext k M hM (powerModule k M s d)
    (AlgebraizedThetaSectionsR0138.power_invertible k h3 M hM s hs d).isInvertible_module
  intro n i
  have hφ := chartFrame_formal_value k h3 M hM s hs d φ v
    (AlgebraizedThetaSaturationR0138.algebraicFormal_realizes k h3 M hM s hs d φ) n i
  apply (cancel_epi (chartFrame k h3 M hM s hs d n i)).mp
  rw [pulled_sum, Preadditive.comp_sum, hφ]
  have hj (j : Fin d) : chartFrame k h3 M hM s hs d n i ≫
      pulledInclusion (chartMap k M n i)
        (dualScale (M.p.appTop ((Scheme.ΓSpecIso (CommRingCat.of (PowerSeries k))).inv (c j)))
          (poleDual k h3 M hM s hs d j)) =
      unitScalar (C := specA k n)
        ((Scheme.ΓSpecIso (CommRingCat.of (A k n))).inv
          (base k n (trunc (PowerSeries k) PowerSeries.X n (c j)) * poleNumerator k r n d j i)) := by
    rw [pulled_dualScale, dualScale, ← Category.assoc,
      chartFrame_formal_value k h3 M hM s hs d _ _ (poleDual_realizes k h3 M hM s hs d j),
      chart_scalar k M hM]
    change unitScalar (C := specA k n) _ ≫ unitScalar (C := specA k n) _ = _
    rw [fromSection_unit_comp]
    congr 1
    rw [map_mul]
    exact mul_comm _ _
  simp_rw [hj]
  rw [← fromSection_unit_sum]
  change unitScalar (C := specA k n) _ = _
  congr 1
  rw [hc, map_sum]


lemma sum_dual_app {C : Scheme.{u}} {L : C.Modules} {ι : Type*}
    (S : Finset ι) (φ : ι → (L ⟶ (𝟙_ C.Modules))) (U : C.Opens) (v : Γ(L,U)) :
    (∑ j ∈ S, φ j).app U v = ∑ j ∈ S, (φ j).app U v := by
  classical
  induction S using Finset.induction_on with
  | empty => rfl
  | @insert j S hj ih =>
    simp only [Finset.sum_insert hj]
    change (φ j).app U v + (∑ a ∈ S, φ a).app U v = _
    rw [ih]

lemma scaled_sum_cancel {F R ι : Type*} [Field F] [CommRing R] (ρ : F →+* R)
    (S : Finset ι) (t : F) (ht : t ≠ 0) (a : ι → F) (z : R) (x : ι → R)
    (h : ρ t * z = ∑ j ∈ S, ρ (a j) * x j) :
    z = ∑ j ∈ S, ρ (t⁻¹*a j) * x j := by
  calc
    z = (ρ t⁻¹ * ρ t) * z := by rw [← map_mul, inv_mul_cancel₀ ht, map_one, one_mul]
    _ = _ := by rw [mul_assoc, h, Finset.mul_sum]; simp only [map_mul, mul_assoc]

open ArithmeticThetaGenericEvaluationR0140.GenericDualLocalizationR0140
lemma generic_higher_pole_span {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    (d : ℕ) (hd : 0 < d) (ψ : GenericDual k M s d) :
    ∃ c : Fin d → LaurentSeries k, ψ = ∑ j : Fin d,
      dualScale (L := genericPower k M s d) (genericScalar k M (c j))
        (restrictDual k M s d (poleDual k h3 M hM s hs d j)) := by
  classical
  obtain ⟨n, φ, hφ⟩ := (generic_dual_localization k r hr h3 T M hM s hs d).2 ψ
  obtain ⟨a, ha⟩ := algebraic_higher_pole_span k h3 M hM s hs d hd φ
  let t := (algebraMap (PowerSeries k) (LaurentSeries k) PowerSeries.X)^n
  have ht : t ≠ 0 := pow_ne_zero n (by
    intro hx
    apply PowerSeries.X_ne_zero (R := k)
    apply IsFractionRing.injective (PowerSeries k) (LaurentSeries k)
    exact hx.trans (map_zero (algebraMap (PowerSeries k) (LaurentSeries k))).symm)
  have heq : restrictDual k M s d φ = ∑ j : Fin d,
      dualScale (L := genericPower k M s d)
        (genericScalar k M (algebraMap (PowerSeries k) (LaurentSeries k) (a j)))
        (restrictDual k M s d (poleDual k h3 M hM s hs d j)) := by
    rw [ha]
    change pulledInclusion (genericInclusion k M) _ = _
    rw [pulled_sum]
    apply Finset.sum_congr rfl
    intro j hj
    rw [pulled_dualScale, ← genericScalar_base k M (a j)]
    rfl
  refine ⟨fun j => t⁻¹ * algebraMap (PowerSeries k) (LaurentSeries k) (a j), ?_⟩
  apply Scheme.Modules.hom_ext
  intro U
  ext v
  let ρ : LaurentSeries k →+* Γ(genericScheme k M,U) :=
    ((genericScheme k M).presheaf.map (homOfLE (show U ≤ ⊤ from le_top)).op).hom.comp (genericScalar k M)
  have hv := hφ U v
  change scalarAt k M U t * (show Γ(genericScheme k M,U) from ψ.app U v) =
    (restrictDual k M s d φ).app U v at hv
  rw [heq] at hv
  have happ (c : Fin d → LaurentSeries k) :
      (∑ j : Fin d, dualScale (L := genericPower k M s d) (genericScalar k M (c j))
        (restrictDual k M s d (poleDual k h3 M hM s hs d j))).app U v =
      ∑ j : Fin d, ρ (c j) *
        (show Γ(genericScheme k M,U) from (restrictDual k M s d (poleDual k h3 M hM s hs d j)).app U v) := by
    rw [sum_dual_app]
    apply Finset.sum_congr rfl
    intro j hj
    exact dualScale_app _ _ U v
  have hv' := hv.trans (happ (fun j => algebraMap (PowerSeries k) (LaurentSeries k) (a j)))
  exact (scaled_sum_cancel ρ Finset.univ t ht _ _ _ hv').trans
    (happ (fun j => t⁻¹ * algebraMap (PowerSeries k) (LaurentSeries k) (a j))).symm


attribute [local instance] Scheme.Modules.pullback_monoidal
def dualTriple {S : Scheme.{u}} {L P Q : S.Modules}
    (a : L ⟶ (𝟙_ S.Modules)) (b : P ⟶ (𝟙_ S.Modules)) (c : Q ⟶ (𝟙_ S.Modules)) :
    L ⊗ (P ⊗ Q) ⟶ (𝟙_ S.Modules) := dualMul a (dualMul b c)

def triplePullIso {S Z : Scheme.{u}} (f : S ⟶ Z) (L P Q : Z.Modules) :
    (Scheme.Modules.pullback f).obj (L ⊗ (P ⊗ Q)) ≅
      (Scheme.Modules.pullback f).obj L ⊗
        ((Scheme.Modules.pullback f).obj P ⊗ (Scheme.Modules.pullback f).obj Q) :=
  Scheme.Modules.pullbackTensorObjIso f _ _ ≪≫
    (Iso.refl _ ⊗ᵢ Scheme.Modules.pullbackTensorObjIso f P Q)

lemma pull_dualTriple {S Z : Scheme.{u}} (f : S ⟶ Z) {L P Q : Z.Modules}
    (a : L ⟶ (𝟙_ Z.Modules)) (b : P ⟶ (𝟙_ Z.Modules)) (c : Q ⟶ (𝟙_ Z.Modules)) :
    pulledInclusion f (dualTriple a b c) =
      (triplePullIso f L P Q).hom ≫ dualTriple
        (pulledInclusion f a) (pulledInclusion f b) (pulledInclusion f c) := by
  simp only [dualTriple, pull_dualMul_eq, triplePullIso, Iso.trans_hom,
    tensorIso_hom, Iso.refl_hom, Category.assoc]
  have hh := dualMul_precomp (𝟙 _) (Scheme.Modules.pullbackTensorObjIso f P Q).hom
    (pulledInclusion f a) (dualMul (pulledInclusion f b) (pulledInclusion f c))
  simpa only [Category.id_comp] using congrArg
    (fun q => (Scheme.Modules.pullbackTensorObjIso f L (P ⊗ Q)).hom ≫ q) hh

lemma tripleFrame_eval {S : Scheme.{u}} {L P Q : S.Modules}
    (f : (𝟙_ S.Modules) ⟶ L) (g : (𝟙_ S.Modules) ⟶ P) (h : (𝟙_ S.Modules) ⟶ Q)
    (a : L ⟶ (𝟙_ S.Modules)) (b : P ⟶ (𝟙_ S.Modules)) (c : Q ⟶ (𝟙_ S.Modules))
    (av bv cv : Γ(S, ⊤))
    (ha : f ≫ a = fromSection (𝟙_ S.Modules) av)
    (hb : g ≫ b = fromSection (𝟙_ S.Modules) bv)
    (hc : h ≫ c = fromSection (𝟙_ S.Modules) cv) :
    pairFrame f (pairFrame g h) ≫ dualTriple a b c =
      fromSection (𝟙_ S.Modules) (av*(bv*cv)) :=
  pairFrame_eval _ _ _ _ _ _ ha (pairFrame_eval _ _ _ _ _ _ hb hc)

lemma regularValue_triple {S : Scheme.{u}} {L P Q : S.Modules}
    (j : L ⟶ (𝟙_ S.Modules)) (l : P ⟶ (𝟙_ S.Modules)) (m : Q ⟶ (𝟙_ S.Modules))
    [IsIso j] [IsIso l] [IsIso m]
    (a : L ⟶ (𝟙_ S.Modules)) (b : P ⟶ (𝟙_ S.Modules)) (c : Q ⟶ (𝟙_ S.Modules))
    (heq : dualTriple a l m = dualTriple j b c) :
    regularValue j a = regularValue l b * regularValue m c := by
  have frame (L : S.Modules) (j q : L ⟶ (𝟙_ S.Modules)) [IsIso j] :
      inv j ≫ q = fromSection (𝟙_ S.Modules) (regularValue j q) := by
    apply unit_hom_ext
    simp only [Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply,
      fromSection_apply, regularValue]
    simp
  have hj : inv j ≫ j = fromSection (𝟙_ S.Modules) (1 : Γ(S,⊤)) := by
    simpa only [show regularValue j j = 1 from inverse_inclusion_one j] using frame _ j j
  have hl : inv l ≫ l = fromSection (𝟙_ S.Modules) (1 : Γ(S,⊤)) := by
    simpa only [show regularValue l l = 1 from inverse_inclusion_one l] using frame _ l l
  have hm : inv m ≫ m = fromSection (𝟙_ S.Modules) (1 : Γ(S,⊤)) := by
    simpa only [show regularValue m m = 1 from inverse_inclusion_one m] using frame _ m m
  have hleft := tripleFrame_eval (inv j) (inv l) (inv m) a l m
    (regularValue j a) 1 1 (frame L j a) hl hm
  have hright := tripleFrame_eval (inv j) (inv l) (inv m) j b c
    1 (regularValue l b) (regularValue m c) hj (frame P l b) (frame Q m c)
  have hv := hleft.symm.trans ((congrArg (fun f => pairFrame (inv j) (pairFrame (inv l) (inv m)) ≫ f) heq).trans hright)
  have hw := ConcreteCategory.congr_hom (congrArg (fun f => Scheme.Modules.Hom.app f ⊤) hv) (1 : Γ(S,⊤))
  simpa [fromSection_apply] using hw

variable (k : Type u) [Field k] [CharZero k] {r : ℕ} {hr : 0 < r} {T : Tower k r hr}
lemma formal_product_cross (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    (d e : ℕ) (v : FormalNumerators k (T := T) d) (w : FormalNumerators k (T := T) e)
    (z : FormalNumerators k (T := T) (d+e))
    (a : Dual k M s (d+e)) (b : Dual k M s d) (c : Dual k M s e)
    (ha : FormalRealizes k M s (d+e) z a) (hb : FormalRealizes k M s d v b)
    (hc : FormalRealizes k M s e w c)
    (hz : ∀ n i, (z.val n).val i = (v.val n).val i * (w.val n).val i) :
    dualTriple a (idealInclusion (s.ker^d)) (idealInclusion (s.ker^e)) =
      dualTriple (idealInclusion (s.ker^(d+e))) b c := by
  have hI (m : ℕ) := (power_invertible k h3 M hM s hs m).isInvertible_module
  apply model_chart_hom_ext k M hM
    (powerModule k M s (d+e) ⊗ (powerModule k M s d ⊗ powerModule k M s e))
    ((hI (d+e)).tensor_monoidalV2 ((hI d).tensor_monoidalV2 (hI e)))
  intro n i
  rw [pull_dualTriple, pull_dualTriple]
  congr 1
  letI (m : ℕ) : IsIso (chartFrame k h3 M hM s hs m n i) := chartFrame_isIso k h3 M hM s hs m n i
  apply (cancel_epi (pairFrame (chartFrame k h3 M hM s hs (d+e) n i)
    (pairFrame (chartFrame k h3 M hM s hs d n i) (chartFrame k h3 M hM s hs e n i)))).mp
  rw [tripleFrame_eval _ _ _ _ _ _ _ _ _
      (chartFrame_formal_value k h3 M hM s hs (d+e) a z ha n i)
      (chartFrame_inclusion k h3 M hM s hs d n i)
      (chartFrame_inclusion k h3 M hM s hs e n i),
    tripleFrame_eval _ _ _ _ _ _ _ _ _
      (chartFrame_inclusion k h3 M hM s hs (d+e) n i)
      (chartFrame_formal_value k h3 M hM s hs d b v hb n i)
      (chartFrame_formal_value k h3 M hM s hs e c w hc n i)]
  congr 1
  let ρ := (Scheme.ΓSpecIso (CommRingCat.of (A k n))).inv.hom
  change ρ ((z.val n).val i) * (ρ (equation k r n i ^ d) * ρ (equation k r n i ^ e)) =
    ρ (equation k r n i ^ (d+e)) * (ρ ((v.val n).val i) * ρ ((w.val n).val i))
  rw [hz, map_mul, pow_add (equation k r n i) d e, map_mul]
  ring

lemma complementCoordinate_product (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    (d e : ℕ) (v : FormalNumerators k (T := T) d) (w : FormalNumerators k (T := T) e)
    (z : FormalNumerators k (T := T) (d+e))
    (a : Dual k M s (d+e)) (b : Dual k M s d) (c : Dual k M s e)
    (ha : FormalRealizes k M s (d+e) z a) (hb : FormalRealizes k M s d v b)
    (hc : FormalRealizes k M s e w c)
    (hz : ∀ n i, (z.val n).val i = (v.val n).val i * (w.val n).val i) :
    complementCoordinate k M s (d+e) a =
      complementCoordinate k M s d b * complementCoordinate k M s e c := by
  have hh := congrArg (pulledInclusion (complementInclusion k M s))
    (formal_product_cross k h3 M hM s hs d e v w z a b c ha hb hc hz)
  rw [pull_dualTriple, pull_dualTriple] at hh
  have ht := (cancel_epi (triplePullIso (complementInclusion k M s)
    (powerModule k M s (d+e)) (powerModule k M s d) (powerModule k M s e)).hom).mp hh
  letI (m : ℕ) : IsIso (pulledInclusion (complementInclusion k M s)
      (idealInclusion (s.ker^m))) := complement_power_inclusion_isIso k r M s m
  exact regularValue_triple _ _ _ _ _ _ ht



open ArithmeticThetaPolygonCohomologyR0131

def formalDual (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    {d : ℕ} (v : FormalNumerators k (T := T) d) : Dual k M s d :=
  (algebraize_formal k h3 M hM s hs d v).exists.choose

lemma formalDual_realizes (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    {d : ℕ} (v : FormalNumerators k (T := T) d) :
    FormalRealizes k M s d v (formalDual k h3 M hM s hs v) :=
  (algebraize_formal k h3 M hM s hs d v).exists.choose_spec

def formalValue (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    {d : ℕ} (v : FormalNumerators k (T := T) d) : Γ(complementScheme k M s,⊤) :=
  complementCoordinate k M s d (formalDual k h3 M hM s hs v)

lemma formalValue_eq (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    {d : ℕ} (v : FormalNumerators k (T := T) d) (φ : Dual k M s d)
    (hφ : FormalRealizes k M s d v φ) :
    formalValue k h3 M hM s hs v = complementCoordinate k M s d φ := by
  have h := (algebraize_formal k h3 M hM s hs d v).unique
    (formalDual_realizes k h3 M hM s hs v) hφ
  exact congrArg (complementCoordinate k M s d) h

lemma formalValue_congr (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    {d e : ℕ} (h : d = e) (v : FormalNumerators k (T := T) d)
    (w : FormalNumerators k (T := T) e)
    (hv : ∀ n i, (v.val n).val i = (w.val n).val i) :
    formalValue k h3 M hM s hs v = formalValue k h3 M hM s hs w := by
  subst e
  have hh : v = w := by
    apply Subtype.ext
    funext n
    apply Subtype.ext
    funext i
    exact hv n i
  rw [hh]

def formalMul {d e : ℕ} (v : FormalNumerators k (T := T) d)
    (w : FormalNumerators k (T := T) e) : FormalNumerators k (T := T) (d+e) :=
  ⟨fun n => ⟨fun i => (v.val n).val i * (w.val n).val i,
      compatible_mul k (v.val n).property (w.val n).property⟩,
    by intro n N h i; simp only [map_mul, v.property n N h i, w.property n N h i]⟩

def formalPow {d : ℕ} (v : FormalNumerators k (T := T) d) (a : ℕ) :
    FormalNumerators k (T := T) (d*a) :=
  ⟨fun n => ⟨fun i => (v.val n).val i ^ a, compatible_pow k (v.val n).property a⟩,
    by intro n N h i; simp only [map_pow, v.property n N h i]⟩

def equationFormal (d : ℕ) : FormalNumerators k (T := T) d :=
  ⟨fun n => ⟨fun i => equation k r n i ^ d, compatible_equation k d⟩,
    by intro n N h i; simp only [map_pow, reduce_equation]⟩

lemma formalValue_mul (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    {d e : ℕ} (v : FormalNumerators k (T := T) d) (w : FormalNumerators k (T := T) e) :
    formalValue k h3 M hM s hs (formalMul k v w) =
      formalValue k h3 M hM s hs v * formalValue k h3 M hM s hs w :=
  complementCoordinate_product k h3 M hM s hs d e v w (formalMul k v w)
    _ _ _ (formalDual_realizes k h3 M hM s hs _) (formalDual_realizes k h3 M hM s hs _)
      (formalDual_realizes k h3 M hM s hs _) (by intro n i; rfl)

lemma formalDual_equation (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s) (d : ℕ) :
    formalDual k h3 M hM s hs (equationFormal k (T := T) d) = idealInclusion (s.ker^d) := by
  apply model_chart_hom_ext k M hM (powerModule k M s d)
    (power_invertible k h3 M hM s hs d).isInvertible_module
  intro n i
  letI := chartFrame_isIso k h3 M hM s hs d n i
  apply (cancel_epi (chartFrame k h3 M hM s hs d n i)).mp
  rw [chartFrame_formal_value k h3 M hM s hs d _ _ (formalDual_realizes k h3 M hM s hs _),
    chartFrame_inclusion]
  rfl

lemma formalValue_equation (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s) (d : ℕ) :
    formalValue k h3 M hM s hs (equationFormal k (T := T) d) = 1 := by
  unfold formalValue
  rw [formalDual_equation]
  letI : IsIso (pulledInclusion (complementInclusion k M s) (idealInclusion (s.ker^d))) :=
    complement_power_inclusion_isIso k r M s d
  exact inverse_inclusion_one _

lemma formalValue_pow (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    {d : ℕ} (v : FormalNumerators k (T := T) d) (a : ℕ) :
    formalValue k h3 M hM s hs (formalPow k v a) = formalValue k h3 M hM s hs v ^ a := by
  induction a with
  | zero =>
    rw [formalValue_congr k h3 M hM s hs (Nat.mul_zero d) (formalPow k v 0)
      (equationFormal k (T := T) 0) (by intro n i; simp [formalPow, equationFormal]),
      formalValue_equation, pow_zero]
  | succ a ih =>
    rw [formalValue_congr k h3 M hM s hs (Nat.mul_succ d a) (formalPow k v (a+1))
      (formalMul k (formalPow k v a) v) (by intro n i; exact pow_succ _ a),
      formalValue_mul, ih, pow_succ]


def coordinateFormal (h3 : 3 ≤ r) (T : Tower k r hr) (odd : Bool) :
    FormalNumerators k (T := T) (degree odd) :=
  let hc : CompatibleSystem k odd T := by
    cases odd
    · exact tate_x_numerator_system k r hr h3 T
    · exact tate_y_numerator_system k r hr h3 T
  ⟨fun n => ⟨numerator k odd r n, hc.1 n⟩, hc.2⟩

lemma poleDual_coordinate (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    (X : Dual k M s 2) (Y : Dual k M s 3)
    (hX : RealizesCoordinate k false M s X) (hY : RealizesCoordinate k true M s Y)
    (d : ℕ) (j : Fin d) :
    complementCoordinate k M s d (poleDual k h3 M hM s hs d j) =
      complementCoordinate k M s 2 X ^ poleXExponent j.val *
        complementCoordinate k M s 3 Y ^ poleYExponent j.val := by
  have hdeg : d = d-poleWeight j.val + (2*poleXExponent j.val+3*poleYExponent j.val) := by
    rw [poleWeight_decompose, Nat.sub_add_cancel (poleWeight_le j)]
  have hv := formalValue_congr k h3 M hM s hs hdeg (poleFormal k h3 T d j)
    (formalMul k (equationFormal k (T := T) (d-poleWeight j.val))
      (formalMul k (formalPow k (coordinateFormal k h3 T false) (poleXExponent j.val))
        (formalPow k (coordinateFormal k h3 T true) (poleYExponent j.val))))
    (by intro n i; rfl)
  have hx : formalValue k h3 M hM s hs (coordinateFormal k h3 T false) =
      complementCoordinate k M s 2 X := formalValue_eq k h3 M hM s hs _ X hX
  have hy : formalValue k h3 M hM s hs (coordinateFormal k h3 T true) =
      complementCoordinate k M s 3 Y := formalValue_eq k h3 M hM s hs _ Y hY
  change complementCoordinate k M s d (poleDual k h3 M hM s hs d j) = _ at hv
  rw [formalValue_mul, formalValue_mul, formalValue_equation, formalValue_pow,
    formalValue_pow, hx, hy, one_mul] at hv
  exact hv


lemma principal_complement_inter {C : Scheme.{u}} (I : C.IdealSheafData)
    (V : C.affineOpens) (h : Γ(C,V.1)) (hI : I.ideal V = Ideal.span {h}) :
    I.support.compl ⊓ V.1 = C.basicOpen h := by
  ext x
  change (x ∉ I.support ∧ x ∈ V.1) ↔ x ∈ C.basicOpen h
  constructor
  · rintro ⟨hx, hxV⟩
    have he := I.mem_support_iff_of_mem hxV
    rw [hI, Scheme.zeroLocus_span] at he
    simpa only [Scheme.mem_zeroLocus_iff, Set.mem_singleton_iff, forall_eq, not_not] using
      not_iff_not.mpr he |>.mp hx
  · intro hx
    have hxV := C.basicOpen_le h hx
    refine ⟨?_, hxV⟩
    rw [I.mem_support_iff_of_mem hxV, hI, Scheme.zeroLocus_span]
    simpa only [Scheme.mem_zeroLocus_iff, Set.mem_singleton_iff, forall_eq, not_not] using hx

/-- On an affine principal Cartier chart, a regular function away from the
Cartier support has a denominator bounded by a power of the actual equation. -/
lemma affine_pole_clearing {C : Scheme.{u}} (I : C.IdealSheafData)
    (V : C.affineOpens) (h : Γ(C,V.1)) (hI : I.ideal V = Ideal.span {h})
    (f : Γ(C,I.support.compl)) :
    ∃ (n : ℕ) (g : Γ(C,V.1)),
      C.presheaf.map (homOfLE (show C.basicOpen h ≤ I.support.compl from
        (principal_complement_inter I V h hI).symm.trans_le inf_le_left)).op f *
          C.presheaf.map (homOfLE (C.basicOpen_le h)).op h ^ n =
        C.presheaf.map (homOfLE (C.basicOpen_le h)).op g := by
  letI := V.2.isLocalization_basicOpen h
  exact IsLocalization.Away.surj h _


/-- A single Cartier support point admits a two-open cover on which every
regular function of the complement has one finite denominator bound. -/
lemma single_point_pole_clearing {C : Scheme.{u}} (I : C.IdealSheafData)
    (hI : I.IsInvertible) (p : C) (hs : (I.support : Set C) = {p})
    (f : Γ(C,I.support.compl)) :
    ∃ (V : C.affineOpens) (h : Γ(C,V.1)) (n : ℕ) (g : Γ(C,V.1)),
      p ∈ V.1 ∧ IsRegular h ∧ I.ideal V = Ideal.span {h} ∧
      I.support.compl ⊔ V.1 = ⊤ ∧
      ∃ hU : C.basicOpen h ≤ I.support.compl,
        C.presheaf.map (homOfLE hU).op f *
          C.presheaf.map (homOfLE (C.basicOpen_le h)).op h ^ n =
        C.presheaf.map (homOfLE (C.basicOpen_le h)).op g := by
  obtain ⟨W, a, hpa, h, hh, hIh⟩ := hI p
  let V := C.affineBasicOpen a
  have hreg : IsRegular h := isRegular_iff_mem_nonZeroDivisors.mpr hh
  obtain ⟨n, g, hg⟩ := affine_pole_clearing I V h hIh f
  refine ⟨V, h, n, g, hpa, hreg, hIh, ?_, _, hg⟩
  ext x
  change (x ∉ (I.support : Set C) ∨ x ∈ V.1) ↔ True
  rw [hs]
  simp only [Set.mem_singleton_iff, iff_true]
  by_cases hx : x = p
  · exact Or.inr (hx ▸ hpa)
  · exact Or.inl hx

lemma invertible_support_complement_nonempty {C : Scheme.{u}} [Nonempty C] [IsReduced C]
    (I : C.IdealSheafData) (hI : I.IsInvertible) : Nonempty I.support.compl := by
  classical
  let p : C := Classical.choice inferInstance
  obtain ⟨V, a, hpa, h, hh, hIh⟩ := hI p
  let W := C.affineBasicOpen a
  haveI : Nonempty W.1 := ⟨⟨p,hpa⟩⟩
  haveI : Nontrivial Γ(C,W.1) := Scheme.component_nontrivial C W.1
  have hne : h ≠ 0 := nonZeroDivisors.ne_zero hh
  have hnon : Nonempty (C.basicOpen h) := by
    by_contra hn
    have hz : C.basicOpen h = ⊥ := by
      ext x
      exact iff_false_intro (fun hx => hn ⟨⟨x,hx⟩⟩)
    exact hne ((AlgebraicGeometry.basicOpen_eq_bot_iff h).mp hz)
  obtain ⟨x⟩ := hnon
  have hx : x.val ∈ I.support.compl ⊓ W.1 :=
    (principal_complement_inter I W h hIh).symm ▸ x.property
  exact ⟨⟨x.val,hx.1⟩⟩


open ArithmeticThetaPolygonCartierR0133
open GlobalCartierIdealLineR0133 CanonicalCartierLineReductionR0133

/-- A regular principal ideal admits every prescribed numerator, with its
cross-multiplied identity in the actual structure sheaf. -/
lemma principal_dual_numerator {C : Scheme.{u}} [IsAffine C]
    (I : C.IdealSheafData) (L : C.Modules) (j : L ⟶ (𝟙_ C.Modules))
    (hj : IdealRealization I L j) (h g : Γ(C,⊤)) (hreg : IsRegular h)
    (hI : I.ideal ⟨⊤, isAffineOpen_top C⟩ = Ideal.span {h}) :
    ∃ φ : L ⟶ (𝟙_ C.Modules), φ ≫ unitScalar h = j ≫ unitScalar g := by
  obtain ⟨t, ht⟩ : ∃ t, j.app ⊤ t = h := by
    have hh : h ∈ I.ideal ⟨⊤, isAffineOpen_top C⟩ := by
      rw [hI]
      exact Ideal.subset_span (Set.mem_singleton h)
    have hrange : Set.range (fun t => (show Γ(C,⊤) from j.app ⊤ t)) =
        (I.ideal ⟨⊤, isAffineOpen_top C⟩).carrier := hj.2 ⟨⊤, isAffineOpen_top C⟩
    exact (Set.ext_iff.mp hrange h).mpr hh
  let δ : (𝟙_ C.Modules) ⟶ L := fromSection L t
  letI : IsIso δ := principal_frame I L j hj h hreg hI t ht
  have hδ : δ ≫ j = unitScalar h := by
    apply unit_hom_ext
    simpa [δ, unitScalar, fromSection_apply] using ht
  refine ⟨inv δ ≫ unitScalar g, ?_⟩
  apply (cancel_epi δ).mp
  simp only [← Category.assoc, IsIso.hom_inv_id, Category.id_comp, hδ]
  rw [fromSection_unit_comp, fromSection_unit_comp, mul_comm]

lemma principal_power_dual_numerator {C : Scheme.{u}} [IsAffine C]
    (I : C.IdealSheafData) (h g : Γ(C,⊤)) (hreg : IsRegular h)
    (hI : I.ideal ⟨⊤, isAffineOpen_top C⟩ = Ideal.span {h}) (n : ℕ) :
    ∃ φ : idealModule (I^n) ⟶ (𝟙_ C.Modules),
      φ ≫ unitScalar (h^n) = idealInclusion (I^n) ≫ unitScalar g := by
  apply principal_dual_numerator (I^n) _ _ (ideal_realization (I^n)) (h^n) g (hreg.pow n)
  rw [Scheme.IdealSheafData.ideal_pow, Pi.pow_apply, hI, Ideal.span_singleton_pow]


lemma complement_nonempty (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s) :
    Nonempty (complement k M s) := by
  letI := generic_integral k h3 M hM
  have hI : (s.ker.comap (genericInclusion k M)).IsInvertible := by
    rw [genericPoint_ker k M hM s hs.1]
    simpa only [pow_one] using generic_power_invertible k h3 M hM s hs 1
  exact invertible_support_complement_nonempty _ hI

lemma generic_identity_support_singleton (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : s ≫ M.p = 𝟙 _)
    (q : Spec (CommRingCat.of (LaurentSeries k))) :
    ((s.ker.comap (genericInclusion k M)).support : Set (genericScheme k M)) =
      {genericPoint k M s hs q} := by
  letI := genericPoint_closed k M hM s hs
  rw [genericPoint_ker k M hM s hs, Scheme.Hom.support_ker,
    ((genericPoint k M s hs).isClosedEmbedding.isClosed_range).closure_eq]
  ext x
  constructor
  · rintro ⟨a, rfl⟩
    exact congrArg (genericPoint k M s hs) (Subsingleton.elim a q)
  · intro hx
    exact ⟨q,hx.symm⟩

lemma generic_local_pole_bound (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    (f : Γ(genericScheme k M,complement k M s)) :
    ∃ (V : (genericScheme k M).affineOpens) (h : Γ(genericScheme k M,V.1))
      (n : ℕ) (g : Γ(genericScheme k M,V.1)),
      IsRegular h ∧ (s.ker.comap (genericInclusion k M)).ideal V = Ideal.span {h} ∧
      complement k M s ⊔ V.1 = ⊤ ∧
      ∃ hU : (genericScheme k M).basicOpen h ≤ complement k M s,
        (genericScheme k M).presheaf.map (homOfLE hU).op f *
          (genericScheme k M).presheaf.map (homOfLE ((genericScheme k M).basicOpen_le h)).op h ^ n =
        (genericScheme k M).presheaf.map (homOfLE ((genericScheme k M).basicOpen_le h)).op g := by
  have hI : (s.ker.comap (genericInclusion k M)).IsInvertible := by
    rw [genericPoint_ker k M hM s hs.1]
    simpa only [pow_one] using generic_power_invertible k h3 M hM s hs 1
  let q : Spec (CommRingCat.of (LaurentSeries k)) := Classical.choice inferInstance
  obtain ⟨V,h,n,g,hp,hh,hIh,hcov,hU,hg⟩ := single_point_pole_clearing _ hI
    (genericPoint k M s hs.1 q) (generic_identity_support_singleton k M hM s hs.1 q) f
  exact ⟨V,h,n,g,hh,hIh,hcov,hU,hg⟩


open ArithmeticThetaPositiveLineR0134.GlobalPositiveSectionDescentR0134
lemma openScalar_restrict {C : Scheme.{u}} (V W : C.Opens) (hWV : W ≤ V) (a : Γ(C,V)) :
    V.ι.app W (C.presheaf.map (homOfLE hWV).op a) =
      V.toScheme.presheaf.map (homOfLE (show V.ι ⁻¹ᵁ W ≤ ⊤ from le_top)).op (V.topIso.inv a) := by
  change C.presheaf.map _ (C.presheaf.map _ a) = C.presheaf.map _ (C.presheaf.map _ a)
  rw [← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply, ← Functor.map_comp, ← Functor.map_comp]
  rfl

lemma localValue_post_scalar {C D : Scheme.{u}} (f : D ⟶ C) [IsOpenImmersion f]
    {L : C.Modules} (q : (Scheme.Modules.pullback f).obj L ⟶ (𝟙_ D.Modules))
    (a : Γ(D,⊤)) (W : C.Opens) (hW : W ≤ f.opensRange) (z : Γ(C,W))
    (hz : f.app W z = D.presheaf.map (homOfLE le_top).op a) (m : Γ(L,W)) :
    localValue f (q ≫ unitScalar a) W hW m = z * localValue f q W hW m := by
  letI := f.isIso_app W hW
  apply (ConcreteCategory.bijective_of_isIso (f.app W)).1
  rw [localValue_spec, map_mul, localValue_spec, hz]
  have ha : adjoint f (q ≫ unitScalar a) =
      adjoint f q ≫ (Scheme.Modules.pushforward f).map (unitScalar a) := by
    exact Adjunction.homEquiv_naturality_right _ _ _
  rw [ha]
  change (Scheme.Modules.Hom.app (unitScalar (C := D) a) (f ⁻¹ᵁ W)) ((adjoint f q).app W m) = _
  rw [unitScalar, fromSection_apply]
  change (show Γ(D,f ⁻¹ᵁ W) from (adjoint f q).app W m) * _ = _
  exact mul_comm _ _

lemma localValue_pulled {C D : Scheme.{u}} (f : D ⟶ C) [IsOpenImmersion f]
    {L : C.Modules} (j : L ⟶ (𝟙_ C.Modules))
    (W : C.Opens) (hW : W ≤ f.opensRange) (m : Γ(L,W)) :
    localValue f (pulledInclusion f j) W hW m = j.app W m := by
  letI := f.isIso_app W hW
  apply (ConcreteCategory.bijective_of_isIso (f.app W)).1
  rw [localValue_spec, adjoint_pulled]
  rfl

lemma localValue_open_scalar {C : Scheme.{u}} (V W : C.Opens) (hWV : W ≤ V)
    {L : C.Modules} (q : (Scheme.Modules.pullback V.ι).obj L ⟶ (𝟙_ V.toScheme.Modules))
    (a : Γ(C,V)) (m : Γ(L,W)) :
    localValue V.ι (q ≫ unitScalar (V.topIso.inv a)) W
        (by simpa only [Scheme.Opens.opensRange_ι] using hWV) m =
      C.presheaf.map (homOfLE hWV).op a * localValue V.ι q W
        (by simpa only [Scheme.Opens.opensRange_ι] using hWV) m :=
  localValue_post_scalar V.ι q _ W _ _ (openScalar_restrict V W hWV a) m

lemma ideal_comap_open_top {C : Scheme.{u}} (I : C.IdealSheafData)
    (V : C.affineOpens) :
    (I.comap V.1.ι).ideal ⟨⊤, show IsAffineOpen (⊤ : V.1.toScheme.Opens) from
      @isAffineOpen_top V.1.toScheme V.2⟩ =
    Ideal.map V.1.topIso.inv.hom (I.ideal V) := by
  rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion, Scheme.Opens.ι_appIso]
  change I.ideal ⟨V.1.ι ''ᵁ ⊤, _⟩ = _
  exact (I.map_ideal (V := V) (U := ⟨V.1.ι ''ᵁ ⊤,
    (show IsAffineOpen (⊤ : V.1.toScheme.Opens) from @isAffineOpen_top V.1.toScheme V.2).image_of_isOpenImmersion V.1.ι⟩)
    V.1.ι_image_top.le).symm


lemma local_principal_power_dual {C : Scheme.{u}} (I : C.IdealSheafData)
    (V : C.affineOpens) (h g : Γ(C,V.1)) (hreg : IsRegular h)
    (hI : I.ideal V = Ideal.span {h}) (n : ℕ) :
    ∃ φ : (Scheme.Modules.pullback V.1.ι).obj (idealModule (I^n)) ⟶ (𝟙_ V.1.toScheme.Modules),
      φ ≫ unitScalar (V.1.topIso.inv (h^n)) =
        pulledInclusion V.1.ι (idealInclusion (I^n)) ≫ unitScalar (V.1.topIso.inv g) := by
  letI : IsAffine V.1.toScheme := V.2
  have hgen : ((I^n).comap V.1.ι).ideal ⟨⊤, isAffineOpen_top V.1.toScheme⟩ =
      Ideal.span {V.1.topIso.inv (h^n)} := by
    rw [ideal_comap_open_top, Scheme.IdealSheafData.ideal_pow, Pi.pow_apply,
      hI, Ideal.span_singleton_pow, Ideal.map_span, Set.image_singleton]
  exact principal_dual_numerator _ _ _
    (pullback_open_realization V.1.ι (I^n) _ _ (ideal_realization (I^n))) _ _
    (regular_equiv V.1.topIso.symm.commRingCatIsoToRingEquiv (hreg.pow n)) hgen

lemma restriction_comp {C : Scheme.{u}} {U V W : C.Opens}
    (hUV : U ≤ V) (hVW : V ≤ W) (a : Γ(C,W)) :
    C.presheaf.map (homOfLE hUV).op (C.presheaf.map (homOfLE hVW).op a) =
      C.presheaf.map (homOfLE (hUV.trans hVW)).op a := by
  rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
  rfl

lemma overlap_pole_values {C : Scheme.{u}} (I : C.IdealSheafData)
    (V : C.affineOpens) (h : Γ(C,V.1)) (hI : I.ideal V = Ideal.span {h})
    (n : ℕ) (g : Γ(C,V.1)) (f : Γ(C,I.support.compl))
    (hU : C.basicOpen h ≤ I.support.compl)
    (hfg : C.presheaf.map (homOfLE hU).op f *
          C.presheaf.map (homOfLE (C.basicOpen_le h)).op h ^ n =
        C.presheaf.map (homOfLE (C.basicOpen_le h)).op g)
    (q : (Scheme.Modules.pullback V.1.ι).obj (idealModule (I^n)) ⟶ (𝟙_ V.1.toScheme.Modules))
    (hq : q ≫ unitScalar (V.1.topIso.inv (h^n)) =
        pulledInclusion V.1.ι (idealInclusion (I^n)) ≫ unitScalar (V.1.topIso.inv g))
    (W : C.Opens) (hWU : W ≤ I.support.compl) (hWV : W ≤ V.1)
    (m : Γ(idealModule (I^n),W)) :
    localValue V.1.ι q W (by simpa only [Scheme.Opens.opensRange_ι] using hWV) m =
      C.presheaf.map (homOfLE hWU).op f * (show Γ(C,W) from (idealInclusion (I^n)).app W m) := by
  have hWB : W ≤ C.basicOpen h := (le_inf hWU hWV).trans_eq (principal_complement_inter I V h hI)
  have hu : IsUnit (C.presheaf.map (homOfLE hWV).op h) := by
    have hh := (C.toRingedSpace.isUnit_res_basicOpen h).map (C.presheaf.map (homOfLE hWB).op).hom
    change IsUnit (C.presheaf.map (homOfLE hWB).op
      (C.presheaf.map (homOfLE (C.basicOpen_le h)).op h)) at hh
    simpa only [restriction_comp] using hh
  have heq := congrArg (fun φ => localValue V.1.ι φ W
    (by simpa only [Scheme.Opens.opensRange_ι] using hWV) m) hq
  rw [localValue_open_scalar V.1 W hWV, localValue_open_scalar V.1 W hWV,
    localValue_pulled, map_pow] at heq
  have hfgW := congrArg (C.presheaf.map (homOfLE hWB).op) hfg
  simp only [map_mul, map_pow, restriction_comp] at hfgW
  apply (hu.pow n).mul_left_cancel
  calc
    _ = C.presheaf.map (homOfLE hWV).op g *
        (show Γ(C,W) from (idealInclusion (I^n)).app W m) := heq
    _ = _ := by rw [← hfgW]; ring


lemma global_pole_extension {C : Scheme.{u}} (I : C.IdealSheafData)
    (hI : I.IsInvertible) (p : C) (hs : (I.support : Set C) = {p})
    (f : Γ(C,I.support.compl)) :
    ∃ (n : ℕ) (φ : idealModule (I^n) ⟶ (𝟙_ C.Modules)),
      pulledInclusion (show C.Opens from I.support.compl).ι φ =
        pulledInclusion (show C.Opens from I.support.compl).ι (idealInclusion (I^n)) ≫
          unitScalar ((show C.Opens from I.support.compl).topIso.inv f) := by
  obtain ⟨V,h,n,g,hp,hreg,hIh,hcov,hU,hfg⟩ := single_point_pole_clearing I hI p hs f
  obtain ⟨q,hq⟩ := local_principal_power_dual I V h g hreg hIh n
  let U : C.Opens := I.support.compl
  let B : Bool → C.Opens := fun b => if b then V.1 else U
  let Z : Bool → Scheme.{u} := fun b => (B b).toScheme
  let c : ∀ b, Z b ⟶ C := fun b => (B b).ι
  let qs : ∀ b, (Scheme.Modules.pullback (c b)).obj (idealModule (I^n)) ⟶ (𝟙_ (Z b).Modules) :=
    fun b => match b with
      | false => pulledInclusion U.ι (idealInclusion (I^n)) ≫ unitScalar (U.topIso.inv f)
      | true => q
  have hv (W : C.Opens) (hWU : W ≤ U) (hWV : W ≤ V.1) (m : Γ(idealModule (I^n),W)) :
      localValue (c false) (qs false) W (by simpa [c,B,U] using hWU) m =
        localValue (c true) (qs true) W (by simpa [c,B] using hWV) m := by
    change localValue U.ι (pulledInclusion U.ι (idealInclusion (I^n)) ≫ unitScalar (U.topIso.inv f)) W _ m =
      localValue V.1.ι q W _ m
    rw [localValue_open_scalar U W hWU, localValue_pulled]
    exact (overlap_pole_values I V h hIh n g f hU hfg q hq W hWU hWV m).symm
  obtain ⟨φ,hφ⟩ := glue_local_maps Z c (fun b => inferInstance) (by
    intro x
    have hx : x ∈ U ⊔ V.1 := by rw [hcov]; trivial
    rcases hx with hx | hx
    · exact ⟨false, ⟨x,hx⟩, rfl⟩
    · exact ⟨true, ⟨x,hx⟩, rfl⟩)
    (idealModule (I^n)) qs (by
      intro a b W ha hb m
      cases a <;> cases b
      · rfl
      · exact hv W (by simpa [c,B,U] using ha) (by simpa [c,B] using hb) m
      · exact (hv W (by simpa [c,B,U] using hb) (by simpa [c,B] using ha) m).symm
      · rfl)
  exact ⟨n,φ,hφ false⟩


lemma global_positive_pole_extension {C : Scheme.{u}} (I : C.IdealSheafData)
    (hI : I.IsInvertible) (p : C) (hs : (I.support : Set C) = {p})
    (f : Γ(C,I.support.compl)) :
    ∃ (n : ℕ) (_ : 0 < n) (φ : idealModule (I^n) ⟶ (𝟙_ C.Modules)),
      pulledInclusion (show C.Opens from I.support.compl).ι φ =
        pulledInclusion (show C.Opens from I.support.compl).ι (idealInclusion (I^n)) ≫
          unitScalar ((show C.Opens from I.support.compl).topIso.inv f) := by
  obtain ⟨n,φ,hφ⟩ := global_pole_extension I hI p hs f
  let j := idealModuleLE (idealPower_le I (Nat.le_succ n))
  refine ⟨n+1, Nat.succ_pos n, j ≫ φ, ?_⟩
  have hj : j ≫ idealInclusion (I^n) = idealInclusion (I^(n+1)) := idealModuleLE_inclusion _
  change (Scheme.Modules.pullback _).map (j ≫ φ) ≫ unitPullback _ = _
  rw [Functor.map_comp, Category.assoc]
  change (Scheme.Modules.pullback _).map j ≫ pulledInclusion _ φ = _
  rw [hφ]
  simp only [pulledInclusion, ← Category.assoc, ← Functor.map_comp, hj]

open ArithmeticThetaInfinitesimalPolygonR0129 ArithmeticThetaProjectiveEffectivityR0135
