/-- Uniqueness uses the required isomorphism of the pulled ideal inclusions;
it does not assume affineness of the identity complement. -/
lemma coordinateIso_unique {hr : 0 < r} {T : Tower k r hr}
    (M : Model k T) (s : baseScheme k ⟶ M.X)
    (X : Dual k M s 2) (Y : Dual k M s 3)
    (e e' : complementScheme k M s ≅ cubicScheme k r)
    (he : IsCoordinateIso k M s X Y e)
    (he' : IsCoordinateIso k M s X Y e') : e = e' := by
  apply Iso.ext
  apply cubicScheme_hom_ext k r e.hom e'.hom (he.1.trans he'.1.symm)
  intro odd
  let f := complementInclusion k M s
  let L := (Scheme.Modules.pullback f).obj (powerModule k M s (degree odd))
  let j : L ⟶ (SheafOfModules.unit (complementScheme k M s).ringCatSheaf :
      (complementScheme k M s).Modules) :=
    (Scheme.Modules.pullback f).map
      (GlobalCartierIdealLineR0133.idealInclusion (s.ker ^ degree odd)) ≫ unitPullback f
  have hj : IsIso j := (he.2 odd).1
  letI := hj
  let v : Γ(L, ⊤) := (inv j).app ⊤ (1 : Γ(complementScheme k M s, ⊤))
  have hv : (show Γ(complementScheme k M s, ⊤) from j.app ⊤ v) = 1 := by
    have h := congrArg (fun q => q.app ⊤ (1 : Γ(complementScheme k M s, ⊤))) (IsIso.inv_hom_id j)
    simpa only [Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply,
      Scheme.Modules.Hom.id_app, ConcreteCategory.id_apply] using h
  have h := ((he.2 odd).2 ⊤ v).symm.trans ((he'.2 odd).2 ⊤ v)
  change _ * (show Γ(complementScheme k M s, ⊤) from j.app ⊤ v) =
    _ * (show Γ(complementScheme k M s, ⊤) from j.app ⊤ v) at h
  simpa [hv] using h

