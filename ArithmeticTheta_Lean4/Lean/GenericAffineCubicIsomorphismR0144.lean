lemma coordinateBasis_all {hr : 0 < r} (h3 : 3 ≤ r) (T : Tower k r hr)
    (odd : Bool) (n : ℕ) : CoordinateBasis k odd (r := r) (hr := hr) (T.overlap n) := by
  cases odd
  · exact degree_two_coordinate_basis k r hr h3 T n
  · exact degree_three_coordinate_basis k r hr h3 T n

lemma basisNumerator_reduce {hr : 0 < r} (h3 : 3 ≤ r) (T : Tower k r hr)
    (odd : Bool) (n N : ℕ) (h : n ≤ N) (j : Fin (degree odd)) (i : Fin r) :
    truncReduce (ArithmeticThetaNodeCharts.Node k) (ArithmeticThetaNodeCharts.t k) n N h
      (basisNumerator k odd r N j i) = basisNumerator k odd r n j i := by
  have hx := (tate_x_numerator_system k r hr h3 T).2 n N h i
  have hy := (tate_y_numerator_system k r hr h3 T).2 n N h i
  cases odd <;>
    simp only [basisNumerator, Bool.false_eq_true, ↓reduceIte] <;>
    split_ifs <;>
    simp only [map_pow, map_mul, one_mul, reduce_equation, hx, hy]

/-- The finite coordinate bases give unique full power-series coefficients
for every compatible formal section. No finite truncation is discarded. -/
lemma formal_coordinate_basis {hr : 0 < r} (h3 : 3 ≤ r) (T : Tower k r hr)
    (odd : Bool) (v : FormalNumerators k (T := T) (degree odd)) :
    ∃! c : Fin (degree odd) → PowerSeries k, ∀ n i,
      (v.val n).val i = ∑ j, base k n (trunc (PowerSeries k) PowerSeries.X n (c j)) *
        basisNumerator k odd r n j i := by
  classical
  have hb := fun n => coordinateBasis_all k h3 T odd n
  choose c hc using fun n => ((hb n).2 (v.val n)).exists
  have hred : ∀ n N (h : n ≤ N) j,
      truncReduce (PowerSeries k) PowerSeries.X n N h (c N j) = c n j := by
    intro n N h j
    have heq : (fun j => truncReduce (PowerSeries k) PowerSeries.X n N h (c N j)) = c n := by
      apply ((hb n).2 (v.val n)).unique
      · intro i
        have hv := congrArg
          (truncReduce (ArithmeticThetaNodeCharts.Node k) (ArithmeticThetaNodeCharts.t k) n N h)
          (hc N i)
        simpa only [v.property n N h i, map_sum, map_mul,
          ArithmeticThetaPositiveLineR0134.PositiveSectionsReductionR0134.reduce_base,
          basisNumerator_reduce k h3 T odd n N h] using hv
      · exact hc n
    exact congrFun heq j
  choose a ha using fun j =>
    (ArithmeticThetaPositiveLineR0134.CompatibleFormalSectionBasisR0134.powerSeries_limit k
      (fun n => c n j) (fun n N h => hred n N h j)).exists
  refine ⟨a, ?_, ?_⟩
  · intro n i
    simp only [ha]
    exact hc n i
  · intro b hb'
    funext j
    apply AlgebraizedThetaSaturationR0138.powerSeries_ext
    intro n
    rw [ha]
    have heq : (fun j => trunc (PowerSeries k) PowerSeries.X n (b j)) = c n :=
      ((hb n).2 (v.val n)).unique (hb' n) (hc n)
    exact congrFun heq j


