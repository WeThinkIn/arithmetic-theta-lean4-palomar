/-! The generic coordinate isomorphism: construction and uniqueness.

The actual generic identity complement is affine. Its regular functions are
generated by the two realized coordinates, with precisely the displayed cubic
relation. The resulting scheme isomorphism preserves the structural map and
all local coordinate formulas, and is unique with these properties.
-/
set_option autoImplicit false
set_option linter.style.haveILetI false
set_option backward.isDefEq.respectTransparency false
noncomputable section
universe u

namespace ArithmeticThetaCubicModelR0144.GenericAffineCubicIsomorphismR0144
open CategoryTheory AlgebraicGeometry

variable (k : Type u) [Field k] [CharZero k] (r : ℕ)

/-- The displayed affine cubic is generated by the actual coefficient map and
its two displayed coordinate classes. -/
lemma cubicRing_hom_ext {R : Type u} [CommRing R]
    (f g : CubicRing k r →+* R)
    (hc : ∀ c, f (algebraMap (LaurentSeries k) (CubicRing k r) c) =
      g (algebraMap (LaurentSeries k) (CubicRing k r) c))
    (hx : ∀ odd, f (cubicCoordinate k r odd) = g (cubicCoordinate k r odd)) :
    f = g := by
  apply Ideal.Quotient.ringHom_ext
  apply MvPolynomial.ringHom_ext
  · intro c
    exact hc c
  · intro i
    fin_cases i
    · exact hx false
    · exact hx true

/-- Maps to the cubic are determined by the structural morphism and the
pullbacks of the two coordinates, for an arbitrary source scheme. -/
lemma cubicScheme_hom_ext {S : Scheme.{u}} (f g : S ⟶ cubicScheme k r)
    (hc : f ≫ cubicStructure k r = g ≫ cubicStructure k r)
    (hx : ∀ odd, f.appTop ((Scheme.ΓSpecIso (CommRingCat.of (CubicRing k r))).inv
      (cubicCoordinate k r odd)) =
      g.appTop ((Scheme.ΓSpecIso (CommRingCat.of (CubicRing k r))).inv
      (cubicCoordinate k r odd))) : f = g := by
  letI : IsAffine (cubicScheme k r) := inferInstanceAs (IsAffine (Spec _))
  apply ext_of_isAffine
  apply (cancel_epi (Scheme.ΓSpecIso (CommRingCat.of (CubicRing k r))).inv).mp
  apply CommRingCat.hom_ext
  apply cubicRing_hom_ext k r
  · intro c
    have h := congrArg (fun q => q.appTop) hc
    simp only [Scheme.Hom.comp_appTop] at h
    have hn := Scheme.ΓSpecIso_inv_naturality
      (show CommRingCat.of (LaurentSeries k) ⟶ CommRingCat.of (CubicRing k r) from
        CommRingCat.ofHom (algebraMap (LaurentSeries k) (CubicRing k r)))
    have hv := congrArg (fun q => q ((Scheme.ΓSpecIso
      (CommRingCat.of (LaurentSeries k))).inv c)) h
    change f.appTop ((cubicStructure k r).appTop _) =
      g.appTop ((cubicStructure k r).appTop _) at hv
    have hn' := ConcreteCategory.congr_hom hn c
    change (Scheme.ΓSpecIso (CommRingCat.of (CubicRing k r))).inv
      (algebraMap (LaurentSeries k) (CubicRing k r) c) =
      (cubicStructure k r).appTop
        ((Scheme.ΓSpecIso (CommRingCat.of (LaurentSeries k))).inv c) at hn'
    exact (congrArg f.appTop hn').trans (hv.trans (congrArg g.appTop hn').symm)
  · exact hx

