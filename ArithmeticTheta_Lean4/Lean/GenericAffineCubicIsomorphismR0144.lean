/-- The entire actual generic identity complement is uniquely the displayed
split affine cubic, with its structural map and both realized local coordinates. -/
theorem generic_affine_cubic_isomorphism
    (k : Type u) [Field k] [CharZero k] (r : ℕ) (hr : 0 < r) (h3 : 3 ≤ r)
    (T : Tower k r hr) (he : Even r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    (X : Dual k M s 2) (Y : Dual k M s 3)
    (hX : RealizesCoordinate k false M s X) (hY : RealizesCoordinate k true M s Y) :
    ∃! e : complementScheme k M s ≅ cubicScheme k r, IsCoordinateIso k M s X Y e := by
  letI := coordinateMorphism_isIso_of_bijective k h3 he M hM s hs X Y hX hY
    ⟨coordinateRingHom_injective k h3 he M hM s hs X Y hX hY,
      coordinateRingHom_surjective k h3 he M hM s hs X Y hX hY⟩
  let e := asIso (coordinateMorphism k h3 he M hM s hs X Y hX hY)
  have hec : IsCoordinateIso k M s X Y e :=
    ⟨coordinateMorphism_structure k h3 he M hM s hs X Y hX hY,
      coordinateMorphism_local k h3 he M hM s hs X Y hX hY⟩
  exact ⟨e, hec, fun e' he' => coordinateIso_unique k r M s X Y e' e he' hec⟩

end ArithmeticThetaCubicModelR0144

