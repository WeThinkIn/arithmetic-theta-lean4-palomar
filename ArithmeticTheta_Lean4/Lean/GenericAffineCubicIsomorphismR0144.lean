lemma algebraic_pole_coefficients_zero (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    (d : ℕ) (c : Fin d → PowerSeries k)
    (hc : (∑ j : Fin d, dualScale (L := powerModule k M s d)
      (M.p.appTop ((Scheme.ΓSpecIso (CommRingCat.of (PowerSeries k))).inv (c j)))
      (poleDual k h3 M hM s hs d j)) = 0) : c = 0 := by
  classical
  have hcoeff (n : ℕ) : (fun j => trunc (PowerSeries k) PowerSeries.X n (c j)) = 0 := by
    apply poleNumerator_coefficients_zero k r n d hr h3
    intro i
    have hv := congrArg (fun q => chartFrame k h3 M hM s hs d n i ≫
      pulledInclusion (chartMap k M n i) q) hc
    rw [pulled_sum, Preadditive.comp_sum] at hv
    have hj (j : Fin d) : chartFrame k h3 M hM s hs d n i ≫
      pulledInclusion (chartMap k M n i)
        (dualScale (M.p.appTop ((Scheme.ΓSpecIso (CommRingCat.of (PowerSeries k))).inv (c j)))
          (poleDual k h3 M hM s hs d j)) =
      unitScalar (C := specA k n)
        ((Scheme.ΓSpecIso (CommRingCat.of (A k n))).inv
          (base k n (trunc (PowerSeries k) PowerSeries.X n (c j)) * poleNumerator k r n d j i)) := by
      rw [pulled_dualScale, dualScale, ← Category.assoc,
        chartFrame_formal_value k h3 M hM s hs d _ _ (poleDual_realizes k h3 M hM s hs d j),
        chart_scalar k M hM]
      change unitScalar (C := specA k n) _ ≫ unitScalar (C := specA k n) _ = _
      rw [fromSection_unit_comp]
      congr 1
      rw [map_mul]
      exact mul_comm _ _
    simp_rw [hj] at hv
    rw [← fromSection_unit_sum] at hv
    have hz : pulledInclusion (chartMap k M n i) (0 : powerModule k M s d ⟶ 𝟙_ M.X.Modules) = 0 := by
      simp only [pulledInclusion, Functor.map_zero, zero_comp]
    rw [hz, comp_zero] at hv
    have hval := ConcreteCategory.congr_hom (congrArg (fun q => Scheme.Modules.Hom.app q ⊤) hv)
      (1 : Γ(specA k n,⊤))
    have hh : ∑ j : Fin d, (Scheme.ΓSpecIso (CommRingCat.of (A k n))).inv
        (base k n (trunc (PowerSeries k) PowerSeries.X n (c j)) * poleNumerator k r n d j i) = 0 := by
      simpa [unitScalar, fromSection_apply] using hval
    apply (Scheme.ΓSpecIso (CommRingCat.of (A k n))).commRingCatIsoToRingEquiv.symm.injective
    change (Scheme.ΓSpecIso (CommRingCat.of (A k n))).inv _ =
      (Scheme.ΓSpecIso (CommRingCat.of (A k n))).inv 0
    simpa only [map_sum, map_zero] using hh
  funext j
  apply AlgebraizedThetaSaturationR0138.powerSeries_ext
  intro n
  simpa only [Pi.zero_apply, map_zero] using congrFun (hcoeff n) j

lemma complement_pole_coefficients_zero (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    (d : ℕ) (c : Fin d → PowerSeries k)
    (hc : ∑ j : Fin d, complementScalar k M s (algebraMap (PowerSeries k) (LaurentSeries k) (c j)) *
      complementCoordinate k M s d (poleDual k h3 M hM s hs d j) = 0) : c = 0 := by
  apply algebraic_pole_coefficients_zero k h3 M hM s hs d c
  apply complementCoordinate_injective k h3 M hM s hs d
  letI : IsIso (pulledInclusion (complementInclusion k M s)
      (idealInclusion (s.ker^d))) := complement_power_inclusion_isIso k r M s d
  unfold complementCoordinate
  rw [pulled_sum, regularValue_sum]
  have hterm (j : Fin d) :
      regularValue (pulledInclusion (complementInclusion k M s) (idealInclusion (s.ker^d)))
        (pulledInclusion (complementInclusion k M s)
          (dualScale (M.p.appTop ((Scheme.ΓSpecIso (CommRingCat.of (PowerSeries k))).inv (c j)))
            (poleDual k h3 M hM s hs d j))) =
      complementScalar k M s (algebraMap (PowerSeries k) (LaurentSeries k) (c j)) *
        complementCoordinate k M s d (poleDual k h3 M hM s hs d j) := by
    rw [pulled_dualScale, regularValue_scale, complementScalar_base]
    rfl
  simp_rw [hterm]
  rw [hc]
  simp [pulledInclusion, regularValue]

lemma laurent_pole_coefficients_zero (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    (d : ℕ) (c : Fin d → LaurentSeries k)
    (hc : ∑ j : Fin d, complementScalar k M s (c j) *
      complementCoordinate k M s d (poleDual k h3 M hM s hs d j) = 0) : c = 0 := by
  classical
  obtain ⟨b,hb⟩ := IsLocalization.exist_integer_multiples_of_finite
    (nonZeroDivisors (PowerSeries k)) c
  choose a ha using hb
  have ha' (j : Fin d) : algebraMap (PowerSeries k) (LaurentSeries k) (a j) =
      algebraMap (PowerSeries k) (LaurentSeries k) b.val * c j := by
    simpa only [Algebra.smul_def] using ha j
  have hz : a = 0 := by
    apply complement_pole_coefficients_zero k h3 M hM s hs d a
    simp_rw [ha', map_mul, mul_assoc]
    rw [← Finset.mul_sum, hc, mul_zero]
  have hb0 : algebraMap (PowerSeries k) (LaurentSeries k) b.val ≠ 0 := by
    intro h
    apply nonZeroDivisors.ne_zero b.property
    apply IsFractionRing.injective (PowerSeries k) (LaurentSeries k)
    exact h.trans (map_zero (algebraMap (PowerSeries k) (LaurentSeries k))).symm
  funext j
  have hh := ha' j
  rw [hz, Pi.zero_apply, map_zero] at hh
  exact (mul_eq_zero.mp hh.symm).resolve_left hb0


lemma finite_regroup {K R ι : Type*} [CommRing K] [CommRing R] [Fintype ι]
    (ρ : K →+* R) (d : ℕ) (f : ι → Fin d) (c : ι → K) (v : Fin d → R) :
    (∑ j : Fin d, ρ (∑ i : ι, if f i = j then c i else 0) * v j) =
      ∑ i : ι, ρ (c i) * v (f i) := by
  classical
  simp only [map_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i hi
  simp only [apply_ite ρ, map_zero, ite_mul, zero_mul]
  simp

lemma pole_exponents_even (a : ℕ) :
    poleXExponent (if a = 0 then 0 else 2*a-1) = a ∧
      poleYExponent (if a = 0 then 0 else 2*a-1) = 0 := by
  unfold poleXExponent poleYExponent poleWeight
  split_ifs <;> omega

lemma pole_exponents_odd (a : ℕ) :
    poleXExponent (2*a+2) = a ∧ poleYExponent (2*a+2) = 1 := by
  unfold poleXExponent poleYExponent poleWeight
  have hne : 2*a+2 ≠ 0 := by omega
  simp only [if_neg hne]
  omega

lemma polynomial_pair_pole_span {K R : Type*} [CommRing K] [CommRing R]
    (ρ : K →+* R) (x y : R) (a b : Polynomial K) :
    ∃ (d : ℕ) (c : Fin d → K),
      Polynomial.eval₂ ρ x a + Polynomial.eval₂ ρ x b * y = ∑ j : Fin d,
        ρ (c j) * (x ^ poleXExponent j.val * y ^ poleYExponent j.val) := by
  classical
  let d := 2*(a.natDegree+b.natDegree)+4
  let ι := Fin (a.natDegree+1) ⊕ Fin (b.natDegree+1)
  let f : ι → Fin d := fun i => match i with
    | .inl n => ⟨if n.val = 0 then 0 else 2*n.val-1, by dsimp [d]; split_ifs <;> omega⟩
    | .inr n => ⟨2*n.val+2, by dsimp [d]; omega⟩
  let c : ι → K := fun i => match i with
    | .inl n => a.coeff n.val
    | .inr n => b.coeff n.val
  refine ⟨d, fun j => ∑ i : ι, if f i = j then c i else 0, ?_⟩
  change Polynomial.eval₂ ρ x a + Polynomial.eval₂ ρ x b * y = ∑ j : Fin d, ρ
    (∑ i : ι, if f i = j then c i else 0) *
      (x ^ poleXExponent j.val * y ^ poleYExponent j.val)
  rw [finite_regroup (ρ) d f c
    (fun j => x ^ poleXExponent j.val * y ^ poleYExponent j.val)]
  rw [Fintype.sum_sum_type]
  have hx (n : Fin (a.natDegree+1)) :
      x ^ poleXExponent (f (.inl n)).val *
        y ^ poleYExponent (f (.inl n)).val =
      x ^ n.val := by
    dsimp [f]
    rw [(pole_exponents_even n.val).1, (pole_exponents_even n.val).2, pow_zero, mul_one]
  have hy (n : Fin (b.natDegree+1)) :
      x ^ poleXExponent (f (.inr n)).val *
        y ^ poleYExponent (f (.inr n)).val =
      x ^ n.val * y := by
    dsimp [f]
    rw [(pole_exponents_odd n.val).1, (pole_exponents_odd n.val).2, pow_one]
  simp_rw [hx, hy]
  dsimp [c]
  rw [Polynomial.eval₂_eq_sum_range, Polynomial.eval₂_eq_sum_range,
    ← Fin.sum_univ_eq_sum_range, ← Fin.sum_univ_eq_sum_range, Finset.sum_mul]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  exact mul_assoc _ _ _

lemma cubicRing_pole_span (r : ℕ) (z : CubicRing k r) :
    ∃ (d : ℕ) (c : Fin d → LaurentSeries k), z = ∑ j : Fin d,
      algebraMap (LaurentSeries k) (CubicRing k r) (c j) *
        (cubicCoordinate k r false ^ poleXExponent j.val *
          cubicCoordinate k r true ^ poleYExponent j.val) := by
  obtain ⟨a,b,hab⟩ := cubicRing_normal_form k r z
  rw [hab]
  exact polynomial_pair_pole_span (algebraMap (LaurentSeries k) (CubicRing k r))
    (cubicCoordinate k r false) (cubicCoordinate k r true) a b

lemma coordinateRingHom_injective (h3 : 3 ≤ r) (he : Even r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    (X : Dual k M s 2) (Y : Dual k M s 3)
    (hX : RealizesCoordinate k false M s X) (hY : RealizesCoordinate k true M s Y) :
    Function.Injective (coordinateRingHom k h3 he M hM s hs X Y hX hY) := by
  classical
  apply (injective_iff_map_eq_zero _).mpr
  intro z hz
  obtain ⟨d,c,hc⟩ := cubicRing_pole_span k r z
  have hzero : c = 0 := by
    apply laurent_pole_coefficients_zero k h3 M hM s hs d c
    rw [hc, map_sum] at hz
    simp only [map_mul, map_pow, coordinateRingHom_scalar, coordinateRingHom_coordinate] at hz
    simpa only [poleDual_coordinate k h3 M hM s hs X Y hX hY] using hz
  rw [hc, hzero]
  simp

end ArithmeticThetaCubicModelR0144.GenericAffineCubicIsomorphismR0144

