lemma pulled_open_hom_injective {C : Scheme.{u}} [IsIntegral C]
    (U : C.Opens) [Nonempty U] (L : C.Modules) :
    Function.Injective (fun φ : L ⟶ (𝟙_ C.Modules) => pulledInclusion U.ι φ) := by
  intro φ ψ h
  have ha := congrArg (adjoint U.ι) h
  rw [adjoint_pulled, adjoint_pulled] at ha
  apply Scheme.Modules.hom_ext
  intro V
  ext v
  by_cases hV : Nonempty V
  · letI := hV
    have hUV : Nonempty (U ⊓ V : C.Opens) := by
      have hh := nonempty_preirreducible_inter U.isOpen V.isOpen
        (Set.nonempty_coe_sort.mp (inferInstance : Nonempty U))
        (Set.nonempty_coe_sort.mp hV)
      exact ⟨⟨hh.choose, hh.choose_spec⟩⟩
    letI := hUV
    apply map_injective_of_isIntegral C (homOfLE (inf_le_right : U ⊓ V ≤ V))
    have hv := ConcreteCategory.congr_hom (congrArg (fun q => Scheme.Modules.Hom.app q V) ha) v
    change U.ι.app V (φ.app V v) = U.ι.app V (ψ.app V v) at hv
    have he : U.ι ''ᵁ (U.ι ⁻¹ᵁ V) = U ⊓ V := U.ι.image_preimage_eq_opensRange_inf V |>.trans (by rw [Scheme.Opens.opensRange_ι])
    have ht := congrArg (C.presheaf.map (eqToHom he.symm).op) hv
    change C.presheaf.map (homOfLE he.symm.le).op
      (C.presheaf.map (homOfLE (U.ι.image_preimage_le V)).op (φ.app V v)) =
      C.presheaf.map (homOfLE he.symm.le).op
      (C.presheaf.map (homOfLE (U.ι.image_preimage_le V)).op (ψ.app V v)) at ht
    simpa only [restriction_comp] using ht
  · have he : V = ⊥ := by
      ext x
      exact iff_false_intro (fun hx => hV ⟨⟨x,hx⟩⟩)
    haveI : Subsingleton Γ(C,V) := CommRingCat.subsingleton_of_isTerminal (C.sheaf.isTerminalOfEqEmpty he)
    exact Subsingleton.elim (α := Γ(C,V)) _ _

lemma regularValue_injective {C : Scheme.{u}} {L : C.Modules}
    (j : L ⟶ (𝟙_ C.Modules)) [IsIso j] : Function.Injective (fun q : L ⟶ (𝟙_ C.Modules) => regularValue j q) := by
  intro φ ψ h
  apply Scheme.Modules.hom_ext
  intro U
  ext v
  exact (regularValue_spec j φ U v).trans
    ((congrArg (fun a : Γ(C,⊤) => C.presheaf.map (homOfLE le_top).op a *
      (show Γ(C,U) from j.app U v)) h).trans (regularValue_spec j ψ U v).symm)

variable (k : Type u) [Field k] [CharZero k] {r : ℕ} {hr : 0 < r} {T : Tower k r hr}
lemma genericComplementValue_injective (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s) (d : ℕ) :
    Function.Injective (genericComplementValue k M s d) := by
  letI := generic_integral k h3 M hM
  letI := complement_nonempty k h3 M hM s hs
  letI := generic_complement_inclusion_isIso k M s d
  intro φ ψ h
  apply pulled_open_hom_injective (complement k M s) (genericPower k M s d)
  have hh := regularValue_injective
    (pulledInclusion (complement k M s).ι (restrictDual k M s d (idealInclusion (s.ker^d))))
  apply hh
  exact h

lemma complementCoordinate_injective (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s) (d : ℕ) :
    Function.Injective (complementCoordinate k M s d) := by
  intro φ ψ h
  apply (generic_dual_localization k r hr h3 T M hM s hs d).1
  apply genericComplementValue_injective k h3 M hM s hs d
  simpa only [genericComplementValue_restrict] using h


