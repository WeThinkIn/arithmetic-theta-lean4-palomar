variable (k : Type u) [Field k] [CharZero k] {r : ℕ} {hr : 0 < r} {T : Tower k r hr}

lemma generic_pole_extension (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    (f : Γ(complementScheme k M s,⊤)) :
    ∃ (n : ℕ) (_ : 0 < n) (ψ : GenericDual k M s n),
      pulledInclusion (complement k M s).ι ψ =
        pulledInclusion (complement k M s).ι (restrictDual k M s n (idealInclusion (s.ker^n))) ≫
          unitScalar f := by
  letI : IsOpenImmersion (genericInclusion k M) :=
    AlgebraizedGenericSmoothnessR0135.generic_inclusion_open k M
  let I := s.ker.comap (genericInclusion k M)
  have hI : I.IsInvertible := by
    dsimp only [I]
    rw [genericPoint_ker k M hM s hs.1]
    simpa only [pow_one] using generic_power_invertible k h3 M hM s hs 1
  let q : Spec (CommRingCat.of (LaurentSeries k)) := Classical.choice inferInstance
  obtain ⟨n,hn,φ,hφ⟩ := global_positive_pole_extension I hI
    (genericPoint k M s hs.1 q) (generic_identity_support_singleton k M hM s hs.1 q)
    ((complement k M s).topIso.hom f)
  have hreal := pullback_open_realization (genericInclusion k M) (s.ker^n)
    _ _ (ideal_realization (s.ker^n))
  have hpow : (s.ker^n).comap (genericInclusion k M) = I^n := comap_power _ _ _
  rw [hpow] at hreal
  obtain ⟨e,he,hu⟩ := realization_unique_iso (I^n) _ _
    (pulledInclusion (genericInclusion k M) (idealInclusion (s.ker^n)))
    (idealInclusion (I^n)) hreal (ideal_realization (I^n))
  refine ⟨n,hn,e.hom ≫ φ, ?_⟩
  have hf : (show (genericScheme k M).Opens from I.support.compl).topIso.inv
      ((complement k M s).topIso.hom f) = f :=
    ConcreteCategory.congr_hom (complement k M s).topIso.hom_inv_id f
  change pulledInclusion (complement k M s).ι φ =
    pulledInclusion (complement k M s).ι (idealInclusion (I^n)) ≫ unitScalar _ at hφ
  rw [hf] at hφ
  change (Scheme.Modules.pullback _).map (e.hom ≫ φ) ≫ unitPullback _ = _
  rw [Functor.map_comp, Category.assoc]
  change (Scheme.Modules.pullback _).map e.hom ≫ pulledInclusion _ φ = _
  rw [hφ]
  simp only [pulledInclusion, ← Category.assoc, ← Functor.map_comp, he]
  rfl


lemma regularValue_from_equation {C : Scheme.{u}} {L : C.Modules}
    (j q : L ⟶ (𝟙_ C.Modules)) [IsIso j] (a : Γ(C,⊤))
    (hq : q = j ≫ unitScalar a) : regularValue j q = a := by
  have hv := congrArg (fun φ => (inv j ≫ φ).app ⊤ (1 : Γ(C,⊤))) hq
  rw [IsIso.inv_hom_id_assoc] at hv
  simpa [regularValue, unitScalar, fromSection_apply] using hv

lemma regularValue_precomp {C : Scheme.{u}} {L P : C.Modules}
    (e : P ≅ L) (j q : L ⟶ (𝟙_ C.Modules)) [IsIso j] :
    regularValue (e.hom ≫ j) (e.hom ≫ q) = regularValue j q := by
  apply regularValue_from_equation
  have hq : q = j ≫ unitScalar (regularValue j q) := by
    apply Scheme.Modules.hom_ext
    intro U
    ext v
    exact (regularValue_spec j q U v).trans (by
      change _ = (Scheme.Modules.Hom.app (unitScalar (C := C) (regularValue j q)) U) (j.app U v)
      rw [unitScalar, fromSection_apply]
      exact mul_comm _ (show Γ(C,U) from j.app U v))
  exact (congrArg (fun v => e.hom ≫ v) hq).trans (Category.assoc _ _ _).symm

lemma regularValue_sum {C : Scheme.{u}} {L : C.Modules}
    (j : L ⟶ (𝟙_ C.Modules)) [IsIso j] {ι : Type*} (S : Finset ι)
    (q : ι → (L ⟶ (𝟙_ C.Modules))) :
    regularValue j (∑ a ∈ S, q a) = ∑ a ∈ S, regularValue j (q a) := by
  exact sum_dual_app S q ⊤ _

lemma regularValue_scale {C : Scheme.{u}} {L : C.Modules}
    (j q : L ⟶ (𝟙_ C.Modules)) [IsIso j] (a : Γ(C,⊤)) :
    regularValue j (dualScale a q) = a * regularValue j q := by
  unfold regularValue
  have hv := dualScale_app a q ⊤ ((inv j).app ⊤ (1 : Γ(C,⊤)))
  simpa using hv

variable (k : Type u) [Field k] [CharZero k] {r : ℕ} {hr : 0 < r} {T : Tower k r hr}
lemma generic_complement_inclusion_isIso (M : Model k T) (s : baseScheme k ⟶ M.X) (d : ℕ) :
    IsIso (pulledInclusion (complement k M s).ι (restrictDual k M s d (idealInclusion (s.ker^d)))) := by
  change IsIso (pulledInclusion (complement k M s).ι
    (pulledInclusion (genericInclusion k M) (idealInclusion (s.ker^d))))
  rw [← pulledInclusion_comp]
  letI : IsIso (pulledInclusion ((complement k M s).ι ≫ genericInclusion k M)
      (idealInclusion (s.ker^d))) := complement_power_inclusion_isIso k r M s d
  infer_instance

def genericComplementValue (M : Model k T) (s : baseScheme k ⟶ M.X) (d : ℕ)
    (ψ : GenericDual k M s d) : Γ(complementScheme k M s,⊤) :=
  letI := generic_complement_inclusion_isIso k M s d
  regularValue (pulledInclusion (complement k M s).ι (restrictDual k M s d (idealInclusion (s.ker^d))))
    (pulledInclusion (complement k M s).ι ψ)

lemma genericComplementValue_restrict (M : Model k T) (s : baseScheme k ⟶ M.X) (d : ℕ)
    (φ : Dual k M s d) :
    genericComplementValue k M s d (restrictDual k M s d φ) = complementCoordinate k M s d φ := by
  letI : IsIso (pulledInclusion ((complement k M s).ι ≫ genericInclusion k M)
      (idealInclusion (s.ker^d))) := complement_power_inclusion_isIso k r M s d
  letI : IsIso (pulledInclusion (complement k M s).ι
      (pulledInclusion (genericInclusion k M) (idealInclusion (s.ker^d)))) :=
    generic_complement_inclusion_isIso k M s d
  change regularValue
    (pulledInclusion (complement k M s).ι (pulledInclusion (genericInclusion k M) (idealInclusion (s.ker^d))))
    (pulledInclusion (complement k M s).ι (pulledInclusion (genericInclusion k M) φ)) = _
  have hv := regularValue_precomp ((Scheme.Modules.pullbackComp (complement k M s).ι (genericInclusion k M)).app _)
    (pulledInclusion ((complement k M s).ι ≫ genericInclusion k M) (idealInclusion (s.ker^d)))
    (pulledInclusion ((complement k M s).ι ≫ genericInclusion k M) φ)
  change regularValue
    ((Scheme.Modules.pullbackComp (complement k M s).ι (genericInclusion k M)).hom.app _ ≫
      pulledInclusion ((complement k M s).ι ≫ genericInclusion k M) (idealInclusion (s.ker^d)))
    ((Scheme.Modules.pullbackComp (complement k M s).ι (genericInclusion k M)).hom.app _ ≫
      pulledInclusion ((complement k M s).ι ≫ genericInclusion k M) φ) = _ at hv
  simpa only [pulledInclusion_comp, complementCoordinate, complementInclusion] using hv

lemma genericComplementValue_scale (M : Model k T) (s : baseScheme k ⟶ M.X) (d : ℕ)
    (ψ : GenericDual k M s d) (a : LaurentSeries k) :
    genericComplementValue k M s d (dualScale (genericScalar k M a) ψ) =
      complementScalar k M s a * genericComplementValue k M s d ψ := by
  letI := generic_complement_inclusion_isIso k M s d
  unfold genericComplementValue
  rw [pulled_dualScale, regularValue_scale]
  rfl

lemma genericComplementValue_sum (M : Model k T) (s : baseScheme k ⟶ M.X) (d : ℕ)
    {ι : Type*} (S : Finset ι) (ψ : ι → (genericPower k M s d ⟶ (𝟙_ (genericScheme k M).Modules))) :
    genericComplementValue k M s d (show genericPower k M s d ⟶ (𝟙_ (genericScheme k M).Modules) from ∑ a ∈ S, ψ a) =
      ∑ a ∈ S, genericComplementValue k M s d (ψ a) := by
  letI := generic_complement_inclusion_isIso k M s d
  unfold genericComplementValue
  rw [pulled_sum, regularValue_sum]

lemma genericComplementValue_surjective (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    (f : Γ(complementScheme k M s,⊤)) :
    ∃ (d : ℕ) (_ : 0 < d) (ψ : GenericDual k M s d), genericComplementValue k M s d ψ = f := by
  obtain ⟨d,hd,ψ,hψ⟩ := generic_pole_extension k h3 M hM s hs f
  letI := generic_complement_inclusion_isIso k M s d
  exact ⟨d,hd,ψ,regularValue_from_equation _ _ f hψ⟩


lemma complement_polynomial_span (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    (X : Dual k M s 2) (Y : Dual k M s 3)
    (hX : RealizesCoordinate k false M s X) (hY : RealizesCoordinate k true M s Y)
    (f : Γ(complementScheme k M s,⊤)) :
    ∃ (d : ℕ) (c : Fin d → LaurentSeries k), f = ∑ j : Fin d,
      complementScalar k M s (c j) *
        (complementCoordinate k M s 2 X ^ poleXExponent j.val *
          complementCoordinate k M s 3 Y ^ poleYExponent j.val) := by
  classical
  obtain ⟨d,hd,ψ,hψ⟩ := genericComplementValue_surjective k h3 M hM s hs f
  obtain ⟨c,hc⟩ := generic_higher_pole_span k h3 M hM s hs d hd ψ
  refine ⟨d,c,?_⟩
  rw [← hψ, hc, genericComplementValue_sum]
  apply Finset.sum_congr rfl
  intro j hj
  rw [genericComplementValue_scale, genericComplementValue_restrict,
    poleDual_coordinate k h3 M hM s hs X Y hX hY]

lemma coordinateRingHom_surjective (h3 : 3 ≤ r) (he : Even r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : MarkedLift k M (zeroIndex r hr) 1 s)
    (X : Dual k M s 2) (Y : Dual k M s 3)
    (hX : RealizesCoordinate k false M s X) (hY : RealizesCoordinate k true M s Y) :
    Function.Surjective (coordinateRingHom k h3 he M hM s hs X Y hX hY) := by
  classical
  intro f
  obtain ⟨d,c,hc⟩ := complement_polynomial_span k h3 M hM s hs X Y hX hY f
  refine ⟨∑ j : Fin d, algebraMap (LaurentSeries k) (CubicRing k r) (c j) *
    (cubicCoordinate k r false ^ poleXExponent j.val * cubicCoordinate k r true ^ poleYExponent j.val), ?_⟩
  rw [map_sum, hc]
  apply Finset.sum_congr rfl
  intro j hj
  simp only [map_mul, map_pow, coordinateRingHom_scalar, coordinateRingHom_coordinate]


