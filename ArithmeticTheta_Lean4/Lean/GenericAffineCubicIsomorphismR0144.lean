/-- The ideal of the identity restricts to the unit ideal on its actual open
complement, after the specified generic base change. -/
lemma complement_comap_top {hr : 0 < r} {T : Tower k r hr}
    (M : Model k T) (s : baseScheme k ⟶ M.X) :
    s.ker.comap (complementInclusion k M s) = ⊤ := by
  apply (Scheme.IdealSheafData.support_eq_bot_iff _).mp
  rw [complementInclusion, Scheme.IdealSheafData.comap_comp,
    Scheme.IdealSheafData.support_comap]
  ext x
  change (x.val ∈ (s.ker.comap (genericInclusion k M)).support) ↔ False
  exact iff_false_intro x.property

lemma top_realization_isIso {S : Scheme.{u}} {L : S.Modules}
    (j : L ⟶ (SheafOfModules.unit S.ringCatSheaf : S.Modules))
    (hj : IdealRealization ⊤ L j) : IsIso j := by
  have hid : IdealRealization (⊤ : S.IdealSheafData)
      (SheafOfModules.unit S.ringCatSheaf : S.Modules) (𝟙 _) := by
    refine ⟨inferInstance, ?_⟩
    intro U
    ext x
    simp [Scheme.IdealSheafData.ideal_top]
  obtain ⟨e, he, -⟩ := realization_unique_iso ⊤ _ _ j (𝟙 _) hj hid
  have hj' : j = e.hom := by simpa using he.symm
  rw [hj']
  infer_instance

/-- Every pulled-back identity ideal power has an invertible inclusion on the
complement. This also includes degree zero and needs no affineness hypothesis. -/
lemma complement_power_inclusion_isIso {hr : 0 < r} {T : Tower k r hr}
    (M : Model k T) (s : baseScheme k ⟶ M.X) (d : ℕ) :
    IsIso ((Scheme.Modules.pullback (complementInclusion k M s)).map
      (idealInclusion (s.ker ^ d)) ≫ unitPullback (complementInclusion k M s)) := by
  letI : IsOpenImmersion (genericInclusion k M) :=
    AlgebraizedGenericSmoothnessR0135.generic_inclusion_open k M
  letI : IsOpenImmersion (complementInclusion k M s) :=
    inferInstanceAs (IsOpenImmersion ((complement k M s).ι ≫ genericInclusion k M))
  have h := pullback_open_realization (complementInclusion k M s) (s.ker ^ d)
    _ _ (ideal_realization (s.ker ^ d))
  rw [comap_power, complement_comap_top k r M s,
    ← Scheme.IdealSheafData.one_eq_top, one_pow] at h
  exact top_realization_isIso _ h

/-- Dividing a dual section by an invertible ideal inclusion gives a global
regular function, through the inverse of that actual inclusion. -/
def regularValue {S : Scheme.{u}} {L : S.Modules}
    (j q : L ⟶ (SheafOfModules.unit S.ringCatSheaf : S.Modules)) [IsIso j] :
    Γ(S, ⊤) := q.app ⊤ ((inv j).app ⊤ (1 : Γ(S, ⊤)))

lemma regularValue_spec {S : Scheme.{u}} {L : S.Modules}
    (j q : L ⟶ (SheafOfModules.unit S.ringCatSheaf : S.Modules)) [IsIso j]
    (U : S.Opens) (v : Γ(L, U)) :
    q.app U v = S.presheaf.map (homOfLE (show U ≤ ⊤ from le_top)).op
      (regularValue j q) * (show Γ(S, U) from j.app U v) := by
  have he : q = j ≫ fromSection (SheafOfModules.unit S.ringCatSheaf : S.Modules)
      (regularValue j q) := by
    apply (cancel_epi (inv j)).mp
    rw [IsIso.inv_hom_id_assoc]
    apply unit_hom_ext
    simp [regularValue, fromSection_apply]
  calc
    q.app U v = (fromSection (SheafOfModules.unit S.ringCatSheaf : S.Modules)
      (regularValue j q)).app U (j.app U v) := congrArg (fun a => a.app U v) he
    _ = _ := by
      rw [fromSection_apply]
      exact mul_comm (show Γ(S, U) from j.app U v) _

variable {r}

def complementCoordinate {hr : 0 < r} {T : Tower k r hr}
    (M : Model k T) (s : baseScheme k ⟶ M.X) (d : ℕ) (φ : Dual k M s d) :
    Γ(complementScheme k M s, ⊤) :=
  letI : IsIso (pulledInclusion (complementInclusion k M s)
      (idealInclusion (s.ker^d))) := complement_power_inclusion_isIso k r M s d
  regularValue (pulledInclusion (complementInclusion k M s) (idealInclusion (s.ker^d)))
    (pulledInclusion (complementInclusion k M s) φ)

lemma complementCoordinate_spec {hr : 0 < r} {T : Tower k r hr}
    (M : Model k T) (s : baseScheme k ⟶ M.X) (d : ℕ) (φ : Dual k M s d)
    (U : (complementScheme k M s).Opens)
    (v : Γ((Scheme.Modules.pullback (complementInclusion k M s)).obj
      (powerModule k M s d), U)) :
    (pulledInclusion (complementInclusion k M s) φ).app U v =
      (complementScheme k M s).presheaf.map (homOfLE (show U ≤ ⊤ from le_top)).op
        (complementCoordinate k M s d φ) *
      (show Γ(complementScheme k M s, U) from
        (pulledInclusion (complementInclusion k M s) (idealInclusion (s.ker^d))).app U v) := by
  letI : IsIso (pulledInclusion (complementInclusion k M s)
      (idealInclusion (s.ker^d))) := complement_power_inclusion_isIso k r M s d
  exact regularValue_spec (pulledInclusion (complementInclusion k M s)
    (idealInclusion (s.ker^d))) (pulledInclusion (complementInclusion k M s) φ) U v

open MonoidalCategory AlgebraicModelCubicR0144

/-- The checked model cubic also holds after arbitrary scheme base change,
as an equality of the fivefold tensor morphisms. -/
lemma pulled_tensor_cubic {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (he : Even r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X)
    (hs : ArithmeticThetaAlgebraizedMarkedLineR0136.MarkedLift k M (zeroIndex r hr) 1 s)
    (X : Dual k M s 2) (Y : Dual k M s 3)
    (hX : RealizesCoordinate k false M s X) (hY : RealizesCoordinate k true M s Y)
    {S : Scheme.{u}} (f : S ⟶ M.X) :
    let j₂ := pulledInclusion f (idealInclusion (s.ker^2))
    let j₃ := pulledInclusion f (idealInclusion (s.ker^3))
    let x := pulledInclusion f X
    let y := pulledInclusion f Y
    let v (j : Fin 3) := f.appTop
      (M.p.appTop ((Scheme.ΓSpecIso (CommRingCat.of (PowerSeries k))).inv (rootSeries k r j)))
    dualFive j₂ j₂ j₂ y y =
      dualFive (shift x j₂ (v 0)) (shift x j₂ (v 1)) (shift x j₂ (v 2)) j₃ j₃ := by
  let L := powerModule k M s 2
  let P := powerModule k M s 3
  let j₂ : L ⟶ (𝟙_ M.X.Modules) := idealInclusion (s.ker^2)
  let j₃ : P ⟶ (𝟙_ M.X.Modules) := idealInclusion (s.ker^3)
  let v (j : Fin 3) : Γ(M.X,⊤) := M.p.appTop
    ((Scheme.ΓSpecIso (CommRingCat.of (PowerSeries k))).inv (rootSeries k r j))
  have hL := (ArithmeticThetaIdentitySectionsR0138.AlgebraizedThetaSectionsR0138.power_invertible
    k h3 M hM s hs 2).isInvertible_module
  have hP := (ArithmeticThetaIdentitySectionsR0138.AlgebraizedThetaSectionsR0138.power_invertible
    k h3 M hM s hs 3).isInvertible_module
  have heq : dualFive j₂ j₂ j₂ Y Y =
      dualFive (shift X j₂ (v 0)) (shift X j₂ (v 1)) (shift X j₂ (v 2)) j₃ j₃ := by
    apply model_chart_hom_ext k M hM (fiveSource L P)
      (hL.tensor_monoidalV2 (hL.tensor_monoidalV2 hL) |>.tensor_monoidalV2
        (hP.tensor_monoidalV2 hP))
    intro n i
    exact model_chart_cubic k h3 he M hM s hs X Y hX hY n i
  have hp := congrArg (pulledInclusion f) heq
  rw [pull_dualFive, pull_dualFive] at hp
  have ht := (cancel_epi (fivePullIso f L P).hom).mp hp
  simpa only [pull_shift] using ht

lemma inverse_inclusion_one {S : Scheme.{u}} {L : S.Modules}
    (j : L ⟶ (SheafOfModules.unit S.ringCatSheaf : S.Modules)) [IsIso j] :
    (show Γ(S, ⊤) from j.app ⊤ ((inv j).app ⊤ (1 : Γ(S, ⊤)))) = 1 := by
  have h := congrArg (fun q => q.app ⊤ (1 : Γ(S, ⊤))) (IsIso.inv_hom_id j)
  simpa only [Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply,
    Scheme.Modules.Hom.id_app, ConcreteCategory.id_apply] using h

/-- The actual regular functions on the entire complement satisfy the cubic. -/
lemma complementCoordinate_cubic {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (he : Even r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X)
    (hs : ArithmeticThetaAlgebraizedMarkedLineR0136.MarkedLift k M (zeroIndex r hr) 1 s)
    (X : Dual k M s 2) (Y : Dual k M s 3)
    (hX : RealizesCoordinate k false M s X) (hY : RealizesCoordinate k true M s Y) :
    complementCoordinate k M s 3 Y ^ 2 =
      ∏ j : Fin 3, (complementCoordinate k M s 2 X -
        (complementInclusion k M s).appTop (M.p.appTop
          ((Scheme.ΓSpecIso (CommRingCat.of (PowerSeries k))).inv (rootSeries k r j)))) := by
  let f := complementInclusion k M s
  let j₂ := pulledInclusion f (idealInclusion (s.ker^2))
  let j₃ := pulledInclusion f (idealInclusion (s.ker^3))
  letI : IsIso j₂ := complement_power_inclusion_isIso k r M s 2
  letI : IsIso j₃ := complement_power_inclusion_isIso k r M s 3
  let a := (inv j₂).app ⊤ (1 : Γ(complementScheme k M s, ⊤))
  let b := (inv j₃).app ⊤ (1 : Γ(complementScheme k M s, ⊤))
  have ha : (show Γ(complementScheme k M s, ⊤) from j₂.app ⊤ a) = 1 :=
    inverse_inclusion_one j₂
  have hb : (show Γ(complementScheme k M s, ⊤) from j₃.app ⊤ b) = 1 :=
    inverse_inclusion_one j₃
  have h := five_equality_local (pulledInclusion f X) j₂ (pulledInclusion f Y) j₃
    (fun j => f.appTop (M.p.appTop
      ((Scheme.ΓSpecIso (CommRingCat.of (PowerSeries k))).inv (rootSeries k r j))))
    (pulled_tensor_cubic k h3 he M hM s hs X Y hX hY f) ⊤ a b
  dsimp only at ha hb h
  erw [ha, hb] at h
  change complementCoordinate k M s 3 Y ^ 2 * 1^3 =
    (∏ j : Fin 3, (complementCoordinate k M s 2 X -
      (complementScheme k M s).presheaf.map (homOfLE (show (⊤ : (complementScheme k M s).Opens) ≤ ⊤ from le_rfl)).op
        (f.appTop (M.p.appTop ((Scheme.ΓSpecIso (CommRingCat.of (PowerSeries k))).inv
          (rootSeries k r j)))) * 1)) * 1^2 at h
  simpa using h

def complementScalar {hr : 0 < r} {T : Tower k r hr}
    (M : Model k T) (s : baseScheme k ⟶ M.X) :
    LaurentSeries k →+* Γ(complementScheme k M s, ⊤) :=
  (complementStructure k M s).appTop.hom.comp
    (Scheme.ΓSpecIso (CommRingCat.of (LaurentSeries k))).inv.hom

lemma complementScalar_base {hr : 0 < r} {T : Tower k r hr}
    (M : Model k T) (s : baseScheme k ⟶ M.X) (a : PowerSeries k) :
    complementScalar k M s (algebraMap (PowerSeries k) (LaurentSeries k) a) =
      (complementInclusion k M s).appTop
        (M.p.appTop ((Scheme.ΓSpecIso (CommRingCat.of (PowerSeries k))).inv a)) := by
  have hc : complementInclusion k M s ≫ M.p =
      complementStructure k M s ≫ genericBase k := by
    simp only [complementInclusion, complementStructure, Category.assoc]
    exact congrArg (fun q => (complement k M s).ι ≫ q)
      (CategoryTheory.Limits.pullback.condition (f := M.p) (g := genericBase k))
  have h := congrArg Scheme.Hom.appTop hc
  simp only [Scheme.Hom.comp_appTop] at h
  have hn := Scheme.ΓSpecIso_inv_naturality
    (show CommRingCat.of (PowerSeries k) ⟶ CommRingCat.of (LaurentSeries k) from
      CommRingCat.ofHom (algebraMap (PowerSeries k) (LaurentSeries k)))
  have hv := congrArg (fun q => q ((Scheme.ΓSpecIso (CommRingCat.of (PowerSeries k))).inv a)) h
  have hn' := ConcreteCategory.congr_hom hn a
  exact (congrArg (complementStructure k M s).appTop hn').trans hv.symm

def coordinateEval {hr : 0 < r} {T : Tower k r hr}
    (M : Model k T) (s : baseScheme k ⟶ M.X)
    (X : Dual k M s 2) (Y : Dual k M s 3) :
    MvPolynomial (Fin 2) (LaurentSeries k) →+* Γ(complementScheme k M s, ⊤) :=
  MvPolynomial.eval₂Hom (complementScalar k M s)
    (fun i => if i = 0 then complementCoordinate k M s 2 X else complementCoordinate k M s 3 Y)

lemma coordinateEval_cubic {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (he : Even r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X)
    (hs : ArithmeticThetaAlgebraizedMarkedLineR0136.MarkedLift k M (zeroIndex r hr) 1 s)
    (X : Dual k M s 2) (Y : Dual k M s 3)
    (hX : RealizesCoordinate k false M s X) (hY : RealizesCoordinate k true M s Y) :
    coordinateEval k M s X Y (cubicPolynomial k r) = 0 := by
  simp only [coordinateEval, cubicPolynomial, map_sub, map_pow, map_prod,
    MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
    show (1 : Fin 2) ≠ 0 from by decide, ↓reduceIte, complementScalar_base]
  exact sub_eq_zero.mpr (complementCoordinate_cubic k h3 he M hM s hs X Y hX hY)

/-- The canonical ring map comes from the actual two regular coordinates. -/
def coordinateRingHom {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (he : Even r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X)
    (hs : ArithmeticThetaAlgebraizedMarkedLineR0136.MarkedLift k M (zeroIndex r hr) 1 s)
    (X : Dual k M s 2) (Y : Dual k M s 3)
    (hX : RealizesCoordinate k false M s X) (hY : RealizesCoordinate k true M s Y) :
    CubicRing k r →+* Γ(complementScheme k M s, ⊤) :=
  Ideal.Quotient.lift _ (coordinateEval k M s X Y) (by
    have hle : Ideal.span {cubicPolynomial k r} ≤ RingHom.ker (coordinateEval k M s X Y) := by
      rw [Ideal.span_le]
      intro p hp
      have hp' : p = cubicPolynomial k r := Set.mem_singleton_iff.mp hp
      subst p
      exact coordinateEval_cubic k h3 he M hM s hs X Y hX hY
    exact fun p hp => hle hp)

/-- This is a genuine morphism of schemes. Proving it is an isomorphism remains
a separate geometric obligation. -/
def coordinateMorphism {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (he : Even r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X)
    (hs : ArithmeticThetaAlgebraizedMarkedLineR0136.MarkedLift k M (zeroIndex r hr) 1 s)
    (X : Dual k M s 2) (Y : Dual k M s 3)
    (hX : RealizesCoordinate k false M s X) (hY : RealizesCoordinate k true M s Y) :
    complementScheme k M s ⟶ cubicScheme k r :=
  (ΓSpec.adjunction.homEquiv _ _) (CommRingCat.ofHom
    (coordinateRingHom k h3 he M hM s hs X Y hX hY)).op

section MorphismProperties
variable {hr : 0 < r} {T : Tower k r hr}
variable (h3 : 3 ≤ r) (he : Even r) (M : Model k T) (hM : IsModel k T M)
variable (s : baseScheme k ⟶ M.X)
variable (hs : ArithmeticThetaAlgebraizedMarkedLineR0136.MarkedLift k M (zeroIndex r hr) 1 s)
variable (X : Dual k M s 2) (Y : Dual k M s 3)
variable (hX : RealizesCoordinate k false M s X) (hY : RealizesCoordinate k true M s Y)

lemma coordinateMorphism_app (a : CubicRing k r) :
    (coordinateMorphism k h3 he M hM s hs X Y hX hY).appTop
      ((Scheme.ΓSpecIso (CommRingCat.of (CubicRing k r))).inv a) =
    coordinateRingHom k h3 he M hM s hs X Y hX hY a := by
  exact ConcreteCategory.congr_hom (ΓSpecIso_inv_ΓSpec_adjunction_homEquiv
    (show CommRingCat.of (CubicRing k r) ⟶ Γ(complementScheme k M s, ⊤) from
      CommRingCat.ofHom (coordinateRingHom k h3 he M hM s hs X Y hX hY))) a

lemma coordinateRingHom_scalar (c : LaurentSeries k) :
    coordinateRingHom k h3 he M hM s hs X Y hX hY
      (algebraMap (LaurentSeries k) (CubicRing k r) c) = complementScalar k M s c := by
  change coordinateEval k M s X Y (MvPolynomial.C c) = _
  exact MvPolynomial.eval₂Hom_C _ _ _

lemma coordinateRingHom_coordinate (odd : Bool) :
    coordinateRingHom k h3 he M hM s hs X Y hX hY (cubicCoordinate k r odd) =
      match odd with
      | false => complementCoordinate k M s 2 X
      | true => complementCoordinate k M s 3 Y := by
  cases odd <;>
    simp [coordinateRingHom, cubicCoordinate, coordinateEval, MvPolynomial.eval₂Hom_X']

lemma coordinateMorphism_structure :
    coordinateMorphism k h3 he M hM s hs X Y hX hY ≫ cubicStructure k r =
      complementStructure k M s := by
  apply ext_of_isAffine
  apply (cancel_epi (Scheme.ΓSpecIso (CommRingCat.of (LaurentSeries k))).inv).mp
  ext c
  have hn := ConcreteCategory.congr_hom (Scheme.ΓSpecIso_inv_naturality
    (show CommRingCat.of (LaurentSeries k) ⟶ CommRingCat.of (CubicRing k r) from
      CommRingCat.ofHom (algebraMap (LaurentSeries k) (CubicRing k r)))) c
  change (Scheme.ΓSpecIso (CommRingCat.of (CubicRing k r))).inv
      (algebraMap (LaurentSeries k) (CubicRing k r) c) =
    (cubicStructure k r).appTop
      ((Scheme.ΓSpecIso (CommRingCat.of (LaurentSeries k))).inv c) at hn
  have h := coordinateMorphism_app k h3 he M hM s hs X Y hX hY
    (algebraMap (LaurentSeries k) (CubicRing k r) c)
  rw [coordinateRingHom_scalar] at h
  exact (congrArg (coordinateMorphism k h3 he M hM s hs X Y hX hY).appTop hn).symm.trans h

/-- The canonical morphism pulls back each displayed cubic coordinate to the
specified ideal-dual coordinate on every open and every local section. -/
lemma coordinateMorphism_local (odd : Bool) :
    let f := complementInclusion k M s
    let φ : Dual k M s (degree odd) := match odd with | true => Y | false => X
    let L := (Scheme.Modules.pullback f).obj (powerModule k M s (degree odd))
    let j := pulledInclusion f (idealInclusion (s.ker^degree odd))
    let q := pulledInclusion f φ
    IsIso j ∧ ∀ (U : (complementScheme k M s).Opens) (v : Γ(L, U)),
      q.app U v = (complementScheme k M s).presheaf.map
        (homOfLE (show U ≤ ⊤ from le_top)).op
        ((coordinateMorphism k h3 he M hM s hs X Y hX hY).appTop
          ((Scheme.ΓSpecIso (CommRingCat.of (CubicRing k r))).inv (cubicCoordinate k r odd))) *
        (show Γ(complementScheme k M s, U) from j.app U v) := by
  refine ⟨complement_power_inclusion_isIso k r M s (degree odd), ?_⟩
  intro U v
  have hv := coordinateMorphism_app k h3 he M hM s hs X Y hX hY (cubicCoordinate k r odd)
  rw [coordinateRingHom_coordinate] at hv
  cases odd
  · exact (complementCoordinate_spec k M s 2 X U v).trans
      (congrArg (fun a => (complementScheme k M s).presheaf.map
        (homOfLE (show U ≤ ⊤ from le_top)).op a *
        (show Γ(complementScheme k M s, U) from
          (pulledInclusion (complementInclusion k M s) (idealInclusion (s.ker^2))).app U v)) hv.symm)
  · exact (complementCoordinate_spec k M s 3 Y U v).trans
      (congrArg (fun a => (complementScheme k M s).presheaf.map
        (homOfLE (show U ≤ ⊤ from le_top)).op a *
        (show Γ(complementScheme k M s, U) from
          (pulledInclusion (complementInclusion k M s) (idealInclusion (s.ker^3))).app U v)) hv.symm)

end MorphismProperties

/-- Smoothness and geometric connectedness give geometric integrality for the
specified generic structural morphism. -/
lemma generic_geometricallyIntegral {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M) :
    GeometricallyIntegral (genericStructure k M) := by
  letI := algebraized_generic_smoothness k r hr h3 T M hM
  letI := algebraized_geometric_connectedness k r hr h3 T M hM
  exact geometricallyIntegral_of_smooth_of_geometricallyConnected (genericStructure k M)

lemma generic_integral {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M) :
    IsIntegral (genericScheme k M) := by
  letI := generic_geometricallyIntegral k h3 M hM
  exact GeometricallyIntegral.isIntegral_of_subsingleton (genericStructure k M)

/-- The dimension-one neighborhood of the actual identity survives generic
base change and determines the relative dimension on the integral generic fiber. -/
lemma generic_relative_one {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X)
    (hs : ArithmeticThetaAlgebraizedMarkedLineR0136.MarkedLift k M (zeroIndex r hr) 1 s) :
    SmoothOfRelativeDimension 1 (genericStructure k M) := by
  letI := algebraized_generic_smoothness k r hr h3 T M hM
  letI : IsIntegral (CategoryTheory.Limits.pullback M.p (genericBase k) : Scheme) :=
    generic_integral k h3 M hM
  obtain ⟨W, hW, hdim⟩ :=
    ArithmeticThetaAlgebraizedMarkedLineR0136.AlgebraizedEffectiveCartierR0136.section_relative_one
      k h3 M hM (zeroIndex r hr) 1 s hs
  let V := genericInclusion k M ⁻¹ᵁ W
  have sq := (isPullback_morphismRestrict (genericInclusion k M) W).paste_vert
    (CategoryTheory.IsPullback.of_hasPullback M.p (genericBase k))
  letI := smoothOfRelativeDimension_isStableUnderBaseChange (n := 1)
  letI : SmoothOfRelativeDimension 1 (V.ι ≫ genericStructure k M) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) sq hdim
  have hx : (V : Set (genericScheme k M)).Nonempty := by
    let b : Spec (CommRingCat.of (LaurentSeries k)) := default
    refine ⟨genericPoint k M s hs.1 b, ?_⟩
    have hpoint : genericInclusion k M (genericPoint k M s hs.1 b) =
        s (genericBase k b) := by
      exact congrArg (fun f => f b)
        (CategoryTheory.Limits.pullback.lift_fst (f := M.p) (g := genericBase k)
          (genericBase k ≫ s) (𝟙 _) (by
            rw [Category.assoc, hs.1]
            dsimp only [baseScheme]
            rw [Category.comp_id, Category.id_comp]))
    change genericInclusion k M (genericPoint k M s hs.1 b) ∈ W
    rw [hpoint]
    exact ((IsLocalRing.specializes_closedPoint (genericBase k b)).map s.continuous).mem_open
      W.isOpen hW
  exact smoothOfRelativeDimension_of_irreducibleSpace 1 (genericStructure k M) V hx

lemma genericPoint_structure {hr : 0 < r} {T : Tower k r hr}
    (M : Model k T) (s : baseScheme k ⟶ M.X) (hs : s ≫ M.p = 𝟙 _) :
    genericPoint k M s hs ≫ genericStructure k M = 𝟙 _ :=
  CategoryTheory.Limits.pullback.lift_snd _ _ _

lemma genericPoint_inclusion {hr : 0 < r} {T : Tower k r hr}
    (M : Model k T) (s : baseScheme k ⟶ M.X) (hs : s ≫ M.p = 𝟙 _) :
    genericPoint k M s hs ≫ genericInclusion k M = genericBase k ≫ s :=
  CategoryTheory.Limits.pullback.lift_fst _ _ _

/-- The actual identity on the generic fiber is the base change of the
specified algebraized identity section, including its scheme structure. -/
lemma genericPoint_isPullback {hr : 0 < r} {T : Tower k r hr}
    (M : Model k T) (s : baseScheme k ⟶ M.X) (hs : s ≫ M.p = 𝟙 _) :
    IsPullback (genericPoint k M s hs) (genericBase k) (genericInclusion k M) s := by
  have houter : IsPullback (genericPoint k M s hs ≫ genericStructure k M)
      (genericBase k) (genericBase k) (s ≫ M.p) := by
    rw [genericPoint_structure, hs]
    dsimp only [baseScheme]
    exact IsPullback.of_id_fst
  exact houter.of_right (genericPoint_inclusion k M s hs)
    (IsPullback.of_hasPullback M.p (genericBase k)).flip

lemma genericPoint_closed {hr : 0 < r} {T : Tower k r hr}
    (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : s ≫ M.p = 𝟙 _) :
    IsClosedImmersion (genericPoint k M s hs) := by
  letI := AlgebraizedGenericSmoothnessR0135.generic_proper k M hM
  haveI : IsClosedImmersion (genericPoint k M s hs ≫ genericStructure k M) := by
    rw [genericPoint_structure]
    infer_instance
  exact IsClosedImmersion.of_comp (genericPoint k M s hs) (genericStructure k M)

lemma genericPoint_ker {hr : 0 < r} {T : Tower k r hr}
    (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : s ≫ M.p = 𝟙 _) :
    s.ker.comap (genericInclusion k M) = (genericPoint k M s hs).ker := by
  letI := ArithmeticThetaAlgebraizedMarkedLineR0136.AlgebraizedSplitMarkedDivisorR0136.section_closed
    k M hM s hs
  let H := genericPoint_isPullback k M s hs
  rw [← Scheme.IdealSheafData.ker_fst_of_isClosedImmersion s (genericInclusion k M),
    ← Scheme.Hom.ker_comp_of_isIso H.isoPullback.hom, H.isoPullback_hom_fst]

lemma complement_eq_genericPoint_compl {hr : 0 < r} {T : Tower k r hr}
    (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : s ≫ M.p = 𝟙 _) :
    (complement k M s : Set (genericScheme k M)) = (Set.range (genericPoint k M s hs))ᶜ := by
  letI := genericPoint_closed k M hM s hs
  unfold complement
  rw [genericPoint_ker k M hM s hs]
  change ((genericPoint k M s hs).ker.support : Set (genericScheme k M))ᶜ = _
  rw [Scheme.Hom.support_ker]
  exact congrArg Set.compl ((genericPoint k M s hs).isClosedEmbedding.isClosed_range).closure_eq


lemma generic_power_invertible {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : ArithmeticThetaAlgebraizedMarkedLineR0136.MarkedLift k M (zeroIndex r hr) 1 s)
    (d : ℕ) : ((genericPoint k M s hs.1).ker ^ d).IsInvertible := by
  letI : IsOpenImmersion (genericInclusion k M) :=
    AlgebraizedGenericSmoothnessR0135.generic_inclusion_open k M
  have h := (ArithmeticThetaIdentitySectionsR0138.AlgebraizedThetaSectionsR0138.power_invertible
    k h3 M hM s hs d).comap_of_isOpenImmersion (genericInclusion k M)
  rwa [comap_power, genericPoint_ker k M hM s hs.1] at h

def genericIdealIso {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : ArithmeticThetaAlgebraizedMarkedLineR0136.MarkedLift k M (zeroIndex r hr) 1 s)
    (d : ℕ) : (Scheme.Modules.pullback (genericInclusion k M)).obj (powerModule k M s d) ≅
      ((genericPoint k M s hs.1).ker ^ d).module :=
  idealPullbackIso (genericInclusion k M) (s.ker ^ d) _
    (ArithmeticThetaIdentitySectionsR0138.AlgebraizedThetaSectionsR0138.power_invertible k h3 M hM s hs d)
    (generic_power_invertible k h3 M hM s hs d)
    (by rw [comap_power, genericPoint_ker k M hM s hs.1])

def genericDual {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : ArithmeticThetaAlgebraizedMarkedLineR0136.MarkedLift k M (zeroIndex r hr) 1 s)
    (d : ℕ) (φ : Dual k M s d) :
    ((genericPoint k M s hs.1).ker ^ d).module ⟶ (𝟙_ (genericScheme k M).Modules) :=
  (genericIdealIso k h3 M hM s hs d).inv ≫ pulledInclusion (genericInclusion k M) φ

lemma genericDual_exact {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : ArithmeticThetaAlgebraizedMarkedLineR0136.MarkedLift k M (zeroIndex r hr) 1 s)
    (odd : Bool) (φ : Dual k M s (degree odd)) (hφ : RealizesCoordinate k odd M s φ) :
    IsIso (pulledInclusion (genericPoint k M s hs.1)
      (genericDual k h3 M hM s hs (degree odd) φ)) := by
  letI := (coordinate_exact_poles k r hr h3 T M hM s hs odd φ hφ).1
  letI := unitPullback_isIso (genericBase k)
  haveI : IsIso (pulledInclusion (genericBase k) (pulledInclusion s φ)) :=
    inferInstanceAs (IsIso ((Scheme.Modules.pullback (genericBase k)).map
      (pulled k M s (degree odd) s φ) ≫ unitPullback (genericBase k)))
  have he := squareIso_inclusion (genericInclusion k M) (genericPoint k M s hs.1)
    s (genericBase k) (genericPoint_inclusion k M s hs.1) (powerModule k M s (degree odd)) φ
  haveI : IsIso (pulledInclusion (genericPoint k M s hs.1)
      (pulledInclusion (genericInclusion k M) φ)) := by
    haveI : IsIso ((squareIso (genericInclusion k M) (genericPoint k M s hs.1)
        s (genericBase k) (genericPoint_inclusion k M s hs.1)
        (powerModule k M s (degree odd))).hom ≫
        pulledInclusion (genericPoint k M s hs.1) (pulledInclusion (genericInclusion k M) φ)) := by
      rw [he]
      infer_instance
    exact IsIso.of_isIso_comp_left
      (squareIso (genericInclusion k M) (genericPoint k M s hs.1)
        s (genericBase k) (genericPoint_inclusion k M s hs.1)
        (powerModule k M s (degree odd))).hom _
  unfold genericDual pulledInclusion
  rw [Functor.map_comp, Category.assoc]
  change IsIso ((Scheme.Modules.pullback (genericPoint k M s hs.1)).map
    (genericIdealIso k h3 M hM s hs (degree odd)).inv ≫
    pulledInclusion (genericPoint k M s hs.1) (pulledInclusion (genericInclusion k M) φ))
  infer_instance


open Scheme.Modules CategoryTheory.Limits
open ArithmeticThetaGenericEvaluationR0140.GenericDualLocalizationR0140

/-- A vanishing pulled section of the dual forces the corresponding pulled
functional to vanish. Both pullbacks use the actual morphism of schemes. -/
lemma dualSection_pullback_zero {C S : Scheme.{u}} (z : S ⟶ C) (L : C.Modules)
    (φ : L ⟶ (𝟙_ C.Modules))
    (hz : pullbackSection z (fromSection (dual L)
      ((ihomGlobalSectionsEquiv L (𝟙_ C.Modules)).symm φ)) = 0) :
    pulledInclusion z φ = 0 := by
  let t := (ihomGlobalSectionsEquiv L (𝟙_ C.Modules)).symm φ
  have hmap : (Scheme.Modules.pullback z).map (fromSection (dual L) t) = 0 := by
    apply (cancel_epi (pullbackUnitIso z).inv).mp
    simpa only [pullbackSection_def, comp_zero] using hz
  have ht : pullbackLocalSection z t = 0 := by
    have hv := pullbackLocalSection_app z (fromSection (dual L) t) (U := ⊤)
      (show Γ(𝟙_ C.Modules, ⊤) from (1 : Γ(C, ⊤)))
    rw [hmap] at hv
    simpa [fromSection_apply] using hv
  have h := dualComparison_global z L t
  rw [ht, map_zero, map_zero] at h
  simpa only [t, AddEquiv.apply_symm_apply, pulledInclusion] using h.symm

lemma unit_id_ne_zero (F : Type u) [Field F] :
    (𝟙 (𝟙_ (Spec (CommRingCat.of F)).Modules)) ≠ 0 := by
  intro h
  have hv := congrArg (fun q => q.app ⊤ (1 : Γ(Spec (CommRingCat.of F), ⊤))) h
  change (1 : Γ(Spec (CommRingCat.of F), ⊤)) = 0 at hv
  exact one_ne_zero hv

lemma dualSection_pullback_ne_zero {C : Scheme.{u}} (F : Type u) [Field F]
    (z : Spec (CommRingCat.of F) ⟶ C) (L : C.Modules)
    (φ : L ⟶ (𝟙_ C.Modules)) [IsIso (pulledInclusion z φ)] :
    pullbackSection z (fromSection (dual L)
      ((ihomGlobalSectionsEquiv L (𝟙_ C.Modules)).symm φ)) ≠ 0 := by
  intro hz
  have hφ := dualSection_pullback_zero z L φ hz
  have h := IsIso.inv_hom_id (pulledInclusion z φ)
  have hh := congrArg (fun q => inv (pulledInclusion z φ) ≫ q) hφ
  rw [h, comp_zero] at hh
  exact unit_id_ne_zero F hh


/-- The genuine complement of the generic identity is affine, as a consequence
of the exact pole of the realized degree-two coordinate. -/
lemma complement_isAffineOpen {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : ArithmeticThetaAlgebraizedMarkedLineR0136.MarkedLift k M (zeroIndex r hr) 1 s)
    (X : Dual k M s 2) (hX : RealizesCoordinate k false M s X) :
    IsAffineOpen (complement k M s) := by
  letI := AlgebraizedGenericSmoothnessR0135.generic_proper k M hM
  letI := generic_relative_one k h3 M hM s hs
  letI := generic_geometricallyIntegral k h3 M hM
  let ε : NeronModelInfra.SchemeHomOver (𝟙 (Spec (CommRingCat.of (LaurentSeries k))))
      (genericStructure k M) := ⟨genericPoint k M s hs.1, genericPoint_structure k M s hs.1⟩
  let L := (ε.1.ker ^ 2).module
  let φ : L ⟶ (𝟙_ (genericScheme k M).Modules) := genericDual k h3 M hM s hs 2 X
  let σ : 𝟙_ (genericScheme k M).Modules ⟶ (ε.1.ker ^ 2).invModule :=
    fromSection (dual L) ((ihomGlobalSectionsEquiv L (𝟙_ (genericScheme k M).Modules)).symm φ)
  have hL : Scheme.Modules.IsInvertible (dual L) :=
    (generic_power_invertible k h3 M hM s hs 2).isInvertible_module.dual.1
  letI : IsIso (pulledInclusion ε.1 φ) := genericDual_exact k h3 M hM s hs false X hX
  have hσ : pullbackSection ε.1 σ ≠ 0 := dualSection_pullback_ne_zero (LaurentSeries k) ε.1 L φ
  have hsupport : ∀ x ∈ Set.range ε.1.base, x ∉ (zeroSchemeIdeal σ).support := by
    rintro x ⟨y, rfl⟩ hx
    apply hσ
    apply (hL.pullbackSection_eq_zero_iff_mem_support_monoidalV2 σ ε.1).mpr
    simpa only [Subsingleton.elim y (IsLocalRing.closedPoint (LaurentSeries k))] using hx
  obtain ⟨U, V, hcov, hU, f, g, -, hUV, hfg, -, hft, -⟩ :=
    SmoothProperCurve.exists_twoChartPoleDatum_of_section_invModule (LaurentSeries k)
      (genericStructure k M) ε 2 (by omega) σ hsupport
  have ha := (Scheme.Opens.isAffineOpen_and_finite_aeval_of_twoChart
    (genericStructure k M) U V f g hcov hUV hfg hft).1
  have heq : U = complement k M s := by
    apply SetLike.coe_injective
    rw [complement_eq_genericPoint_compl k M hM s hs.1]
    ext x
    exact hU x
  exact heq ▸ ha

lemma complement_isAffine {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X) (hs : ArithmeticThetaAlgebraizedMarkedLineR0136.MarkedLift k M (zeroIndex r hr) 1 s)
    (X : Dual k M s 2) (hX : RealizesCoordinate k false M s X) :
    IsAffine (complementScheme k M s) :=
  complement_isAffineOpen k h3 M hM s hs X hX


lemma affine_adjunction_isIso_of_bijective {C : Scheme.{u}} [IsAffine C]
    {R : CommRingCat.{u}} (f : R ⟶ Γ(C, ⊤)) (hf : Function.Bijective f) :
    IsIso ((ΓSpec.adjunction.homEquiv _ _) f.op) := by
  letI : IsIso f := (ConcreteCategory.isIso_iff_bijective f).mpr hf
  rw [Adjunction.homEquiv_apply]
  infer_instance

/-- With affineness now proved for the actual source, ring bijectivity is
sufficient for the geometric identification. This criterion is applied to the checked injectivity and surjectivity below. -/
lemma coordinateMorphism_isIso_of_bijective {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (he : Even r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X)
    (hs : ArithmeticThetaAlgebraizedMarkedLineR0136.MarkedLift k M (zeroIndex r hr) 1 s)
    (X : Dual k M s 2) (Y : Dual k M s 3)
    (hX : RealizesCoordinate k false M s X) (hY : RealizesCoordinate k true M s Y)
    (hbij : Function.Bijective (coordinateRingHom k h3 he M hM s hs X Y hX hY)) :
    IsIso (coordinateMorphism k h3 he M hM s hs X Y hX hY) := by
  letI := complement_isAffine k h3 M hM s hs X hX
  exact affine_adjunction_isIso_of_bijective
    (show CommRingCat.of (CubicRing k r) ⟶ Γ(complementScheme k M s, ⊤) from
      CommRingCat.ofHom (coordinateRingHom k h3 he M hM s hs X Y hX hY)) hbij



