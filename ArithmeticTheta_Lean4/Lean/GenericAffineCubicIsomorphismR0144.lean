lemma chartFrame_formal_value {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X)
    (hs : ArithmeticThetaAlgebraizedMarkedLineR0136.MarkedLift k M (zeroIndex r hr) 1 s)
    (d : ℕ) (φ : Dual k M s d) (v : FormalNumerators k (T := T) d)
    (hφ : FormalRealizes k M s d v φ) (n : ℕ) (i : Fin r) :
    chartFrame k h3 M hM s hs d n i ≫ pulledInclusion (chartMap k M n i) φ =
      fromSection (𝟙_ (specA k n).Modules)
        ((Scheme.ΓSpecIso (CommRingCat.of (A k n))).inv ((v.val n).val i)) := by
  obtain ⟨z, hz, hv⟩ := hφ n i
  letI := chart_mono k h3 M hM s hs d n i
  have hc := ConcreteCategory.congr_hom
    (congrArg (fun f => Scheme.Modules.Hom.app f ⊤)
      (chartFrame_inclusion k h3 M hM s hs d n i)) (1 : Γ(specA k n, ⊤))
  have hz' : (Scheme.Modules.Hom.app (X := specA k n) (chartFrame k h3 M hM s hs d n i) ⊤) (1 : Γ(specA k n, ⊤)) = z := by
    apply mono_app_injective (pulledInclusion (chartMap k M n i) (idealInclusion _)) ⊤
    have hc' : (pulledInclusion (chartMap k M n i) (idealInclusion (s.ker^d))).app ⊤
        ((Scheme.Modules.Hom.app (X := specA k n) (chartFrame k h3 M hM s hs d n i) ⊤) (1 : Γ(specA k n, ⊤))) =
        (Scheme.ΓSpecIso (CommRingCat.of (A k n))).inv (equation k r n i ^ d) := by
      change (pulledInclusion (chartMap k M n i) (idealInclusion (s.ker^d))).app ⊤
        ((Scheme.Modules.Hom.app (X := specA k n) (chartFrame k h3 M hM s hs d n i) ⊤)
          (1 : Γ(specA k n, ⊤))) = _ at hc
      simpa [fromSection_apply] using hc
    exact hc'.trans hz.symm
  apply unit_hom_ext
  change (pulledInclusion (chartMap k M n i) φ).app ⊤
    ((Scheme.Modules.Hom.app (X := specA k n) (chartFrame k h3 M hM s hs d n i) ⊤) (1 : Γ(specA k n, ⊤))) = _
  rw [hz']
  change (pulledInclusion (chartMap k M n i) φ).app ⊤ z = _ at hv
  simpa [fromSection_apply] using hv

def dualScale {C : Scheme.{u}} {L : C.Modules} (a : Γ(C, ⊤)) (φ : L ⟶ (𝟙_ C.Modules)) :
    L ⟶ (𝟙_ C.Modules) := φ ≫ fromSection (𝟙_ C.Modules) a

lemma pulled_dualScale {C S : Scheme.{u}} (f : S ⟶ C) {L : C.Modules}
    (a : Γ(C, ⊤)) (φ : L ⟶ (𝟙_ C.Modules)) :
    pulledInclusion f (dualScale a φ) = dualScale (f.appTop a) (pulledInclusion f φ) := by
  simp only [dualScale, pulledInclusion, Functor.map_comp, Category.assoc]
  erw [pullback_multiplication]
  rfl

def unitScalar {C : Scheme.{u}} (a : Γ(C, ⊤)) :
    (SheafOfModules.unit C.ringCatSheaf : C.Modules) ⟶
      (SheafOfModules.unit C.ringCatSheaf : C.Modules) :=
  fromSection _ a

lemma fromSection_unit_add {C : Scheme.{u}} (a b : Γ(C, ⊤)) :
    unitScalar (C := C) (a + b) = unitScalar (C := C) a + unitScalar (C := C) b := by
  apply unit_hom_ext
  change (fromSection (𝟙_ C.Modules) (a+b)).app ⊤ (1 : Γ(C, ⊤)) =
    (fromSection (𝟙_ C.Modules) a).app ⊤ (1 : Γ(C, ⊤)) +
    (fromSection (𝟙_ C.Modules) b).app ⊤ (1 : Γ(C, ⊤))
  simp [fromSection_apply]

lemma fromSection_unit_comp {C : Scheme.{u}} (a b : Γ(C, ⊤)) :
    unitScalar (C := C) a ≫ unitScalar (C := C) b = unitScalar (C := C) (a*b) := by
  apply unit_hom_ext
  change (fromSection (𝟙_ C.Modules) b).app ⊤
    ((fromSection (𝟙_ C.Modules) a).app ⊤ (1 : Γ(C, ⊤))) = _
  simp [unitScalar, fromSection_apply]

/-- The actual degree-two algebraic dual sections are spanned by the ideal
inclusion and the specified realized coordinate, over the actual base map. -/
lemma algebraic_degree_two_span {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X)
    (hs : ArithmeticThetaAlgebraizedMarkedLineR0136.MarkedLift k M (zeroIndex r hr) 1 s)
    (X : Dual k M s 2) (hX : RealizesCoordinate k false M s X) (φ : Dual k M s 2) :
    ∃ a b : PowerSeries k,
      φ = dualScale (L := powerModule k M s 2) (M.p.appTop ((Scheme.ΓSpecIso (CommRingCat.of (PowerSeries k))).inv a))
          (idealInclusion (s.ker^2)) +
        dualScale (M.p.appTop ((Scheme.ΓSpecIso (CommRingCat.of (PowerSeries k))).inv b)) X := by
  let v := AlgebraizedThetaSaturationR0138.algebraicFormal k h3 M hM s hs 2 φ
  obtain ⟨c, hc, -⟩ := formal_coordinate_basis k h3 T false v
  change Fin 2 → PowerSeries k at c
  refine ⟨c 0, c 1, ?_⟩
  apply model_chart_hom_ext k M hM (powerModule k M s 2)
    (AlgebraizedThetaSectionsR0138.power_invertible k h3 M hM s hs 2).isInvertible_module
  intro n i
  have hφ := chartFrame_formal_value k h3 M hM s hs 2 φ v
    (AlgebraizedThetaSaturationR0138.algebraicFormal_realizes k h3 M hM s hs 2 φ) n i
  apply (cancel_epi (chartFrame k h3 M hM s hs 2 n i)).mp
  simp only [pulledInclusion, Functor.map_add, Preadditive.add_comp]
  change _ ≫ pulledInclusion (chartMap k M n i) φ = _
  change _ = _ ≫ (pulledInclusion (chartMap k M n i) (dualScale (L := powerModule k M s 2) _ (idealInclusion (s.ker^2))) +
    pulledInclusion (chartMap k M n i) (dualScale _ X))
  rw [Preadditive.comp_add, pulled_dualScale, pulled_dualScale, hφ]
  simp only [dualScale, ← Category.assoc]
  have hx : chartFrame k h3 M hM s hs 2 n i ≫ pulledInclusion (chartMap k M n i) X =
      fromSection (𝟙_ (specA k n).Modules)
        ((Scheme.ΓSpecIso (CommRingCat.of (A k n))).inv (numerator k false r n i)) :=
    chartFrame_value k h3 M hM s hs false X hX n i
  rw [chartFrame_inclusion]
  erw [hx]
  rw [chart_scalar k M hM, chart_scalar k M hM]
  have hv := hc n i
  change (v.val n).val i = ∑ j : Fin 2,
    base k n (trunc (PowerSeries k) PowerSeries.X n (c j)) * basisNumerator k false r n j i at hv
  simp only [Fin.sum_univ_two] at hv
  change (v.val n).val i =
    base k n (trunc (PowerSeries k) PowerSeries.X n (c 0)) * equation k r n i ^ 2 +
    base k n (trunc (PowerSeries k) PowerSeries.X n (c 1)) * (1 * numerator k false r n i) at hv
  rw [one_mul] at hv
  change unitScalar (C := specA k n) _ =
    unitScalar (C := specA k n) _ ≫ unitScalar (C := specA k n) _ +
    unitScalar (C := specA k n) _ ≫ unitScalar (C := specA k n) _
  rw [fromSection_unit_comp, fromSection_unit_comp, ← fromSection_unit_add]
  congr 1
  rw [hv, map_add, map_mul, map_mul]
  exact congrArg₂ (· + ·) (mul_comm _ _) (mul_comm _ _)



lemma idealModuleLE_condition {C : Scheme.{u}} {I J : C.IdealSheafData} (h : I ≤ J) :
    idealInclusion I ≫ quotientMap J = 0 := by
  apply hom_ext_affine
  intro U
  ext v
  have hv : (idealInclusion I).app U.1 v ∈ (I.ideal U).carrier := by
    rw [← (ideal_realization I).2 U]
    exact ⟨v, rfl⟩
  have hj := h U hv
  rw [← J.ker_subschemeι_app U] at hj
  exact hj

/-- The canonical inclusion of actual ideal modules for an inequality of
ideal sheaves, with its defining equality against the structure sheaf. -/
def idealModuleLE {C : Scheme.{u}} {I J : C.IdealSheafData} (h : I ≤ J) :
    idealModule I ⟶ idealModule J :=
  kernel.lift (quotientMap J) (idealInclusion I) (idealModuleLE_condition h)

lemma idealModuleLE_inclusion {C : Scheme.{u}} {I J : C.IdealSheafData} (h : I ≤ J) :
    idealModuleLE h ≫ idealInclusion J = idealInclusion I :=
  kernel.lift_ι _ _ _

lemma idealPower_le {C : Scheme.{u}} (I : C.IdealSheafData) {d e : ℕ} (h : d ≤ e) :
    I^e ≤ I^d := by
  intro U
  exact Ideal.pow_le_pow_right h

def raiseDual {hr : 0 < r} {T : Tower k r hr}
    (M : Model k T) (s : baseScheme k ⟶ M.X) {d e : ℕ} (h : d ≤ e)
    (φ : Dual k M s d) : Dual k M s e :=
  idealModuleLE (idealPower_le s.ker h) ≫ φ

lemma pulled_idealModuleLE {C S : Scheme.{u}} (f : S ⟶ C)
    {I J : C.IdealSheafData} (h : I ≤ J) :
    (Scheme.Modules.pullback f).map (idealModuleLE h) ≫ pulledInclusion f (idealInclusion J) =
      pulledInclusion f (idealInclusion I) := by
  unfold pulledInclusion
  rw [← Category.assoc, ← Functor.map_comp, idealModuleLE_inclusion]

lemma raiseDual_chartFrame {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X)
    (hs : ArithmeticThetaAlgebraizedMarkedLineR0136.MarkedLift k M (zeroIndex r hr) 1 s)
    (d e : ℕ) (h : d ≤ e) (n : ℕ) (i : Fin r) :
    chartFrame k h3 M hM s hs e n i ≫
      (Scheme.Modules.pullback (chartMap k M n i)).map (idealModuleLE (idealPower_le s.ker h)) =
    unitScalar (C := specA k n)
        ((Scheme.ΓSpecIso (CommRingCat.of (A k n))).inv (equation k r n i ^ (e-d))) ≫
      chartFrame k h3 M hM s hs d n i := by
  letI := chart_mono k h3 M hM s hs d n i
  apply (cancel_mono (pulledInclusion (chartMap k M n i) (idealInclusion (s.ker^d)))).mp
  rw [Category.assoc, pulled_idealModuleLE, chartFrame_inclusion,
    Category.assoc, chartFrame_inclusion]
  change unitScalar (C := specA k n) _ = unitScalar (C := specA k n) _ ≫ unitScalar (C := specA k n) _
  rw [fromSection_unit_comp]
  congr 1
  have hp : equation k r n i ^ e = equation k r n i ^ (e-d) * equation k r n i ^ d := by
    rw [← pow_add, Nat.sub_add_cancel h]
  exact (congrArg (Scheme.ΓSpecIso (CommRingCat.of (A k n))).inv hp).trans
    ((Scheme.ΓSpecIso (CommRingCat.of (A k n))).inv.hom.map_mul _ _)


lemma raiseDual_frame_value {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X)
    (hs : ArithmeticThetaAlgebraizedMarkedLineR0136.MarkedLift k M (zeroIndex r hr) 1 s)
    (d e : ℕ) (h : d ≤ e) (φ : Dual k M s d) (n : ℕ) (i : Fin r) :
    chartFrame k h3 M hM s hs e n i ≫
        pulledInclusion (chartMap k M n i) (raiseDual k M s h φ) =
      unitScalar (C := specA k n)
        ((Scheme.ΓSpecIso (CommRingCat.of (A k n))).inv (equation k r n i ^ (e-d))) ≫
        (chartFrame k h3 M hM s hs d n i ≫ pulledInclusion (chartMap k M n i) φ) := by
  unfold raiseDual pulledInclusion
  rw [Functor.map_comp, ← Category.assoc, ← Category.assoc,
    raiseDual_chartFrame k h3 M hM s hs d e h n i]
  simp only [Category.assoc]

lemma algebraic_degree_three_span {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X)
    (hs : ArithmeticThetaAlgebraizedMarkedLineR0136.MarkedLift k M (zeroIndex r hr) 1 s)
    (X : Dual k M s 2) (Y : Dual k M s 3)
    (hX : RealizesCoordinate k false M s X) (hY : RealizesCoordinate k true M s Y)
    (φ : Dual k M s 3) :
    ∃ a b c : PowerSeries k,
      φ = dualScale (L := powerModule k M s 3)
          (M.p.appTop ((Scheme.ΓSpecIso (CommRingCat.of (PowerSeries k))).inv a)) (idealInclusion (s.ker^3)) +
        dualScale (M.p.appTop ((Scheme.ΓSpecIso (CommRingCat.of (PowerSeries k))).inv b))
          (raiseDual k M s (by decide : 2 ≤ 3) X) +
        dualScale (M.p.appTop ((Scheme.ΓSpecIso (CommRingCat.of (PowerSeries k))).inv c)) Y := by
  let v := AlgebraizedThetaSaturationR0138.algebraicFormal k h3 M hM s hs 3 φ
  obtain ⟨c, hc, -⟩ := formal_coordinate_basis k h3 T true v
  change Fin 3 → PowerSeries k at c
  refine ⟨c 0, c 1, c 2, ?_⟩
  apply model_chart_hom_ext k M hM (powerModule k M s 3)
    (AlgebraizedThetaSectionsR0138.power_invertible k h3 M hM s hs 3).isInvertible_module
  intro n i
  have hφ := chartFrame_formal_value k h3 M hM s hs 3 φ v
    (AlgebraizedThetaSaturationR0138.algebraicFormal_realizes k h3 M hM s hs 3 φ) n i
  have hx : chartFrame k h3 M hM s hs 2 n i ≫ pulledInclusion (chartMap k M n i) X =
      unitScalar (C := specA k n)
        ((Scheme.ΓSpecIso (CommRingCat.of (A k n))).inv (numerator k false r n i)) :=
    chartFrame_value k h3 M hM s hs false X hX n i
  have hy : chartFrame k h3 M hM s hs 3 n i ≫ pulledInclusion (chartMap k M n i) Y =
      unitScalar (C := specA k n)
        ((Scheme.ΓSpecIso (CommRingCat.of (A k n))).inv (numerator k true r n i)) :=
    chartFrame_value k h3 M hM s hs true Y hY n i
  have hx3 : chartFrame k h3 M hM s hs 3 n i ≫
      pulledInclusion (chartMap k M n i) (raiseDual k M s (by decide : 2 ≤ 3) X) =
      unitScalar (C := specA k n)
        ((Scheme.ΓSpecIso (CommRingCat.of (A k n))).inv (equation k r n i ^ (3-2))) ≫
        unitScalar (C := specA k n)
          ((Scheme.ΓSpecIso (CommRingCat.of (A k n))).inv (numerator k false r n i)) := by
    exact (raiseDual_frame_value k h3 M hM s hs 2 3 (by decide) X n i).trans
      (congrArg (fun q => unitScalar (C := specA k n)
        ((Scheme.ΓSpecIso (CommRingCat.of (A k n))).inv (equation k r n i ^ (3-2))) ≫ q) hx)
  apply (cancel_epi (chartFrame k h3 M hM s hs 3 n i)).mp
  simp only [pulledInclusion, Functor.map_add, Preadditive.add_comp]
  change _ ≫ pulledInclusion (chartMap k M n i) φ = _
  change _ = _ ≫ (pulledInclusion (chartMap k M n i)
      (dualScale (L := powerModule k M s 3) _ (idealInclusion (s.ker^3))) +
    pulledInclusion (chartMap k M n i) (dualScale _ (raiseDual k M s (by decide : 2 ≤ 3) X)) +
    pulledInclusion (chartMap k M n i) (dualScale _ Y))
  rw [Preadditive.comp_add, Preadditive.comp_add,
    pulled_dualScale, pulled_dualScale, pulled_dualScale, hφ]
  simp only [dualScale, ← Category.assoc]
  rw [chartFrame_inclusion]
  rw [hx3, hy]
  rw [chart_scalar k M hM, chart_scalar k M hM, chart_scalar k M hM]
  have hv := hc n i
  change (v.val n).val i = ∑ j : Fin 3,
    base k n (trunc (PowerSeries k) PowerSeries.X n (c j)) * basisNumerator k true r n j i at hv
  simp only [Fin.sum_univ_three] at hv
  change (v.val n).val i =
    base k n (trunc (PowerSeries k) PowerSeries.X n (c 0)) * equation k r n i ^ 3 +
    base k n (trunc (PowerSeries k) PowerSeries.X n (c 1)) * (equation k r n i * numerator k false r n i) +
    base k n (trunc (PowerSeries k) PowerSeries.X n (c 2)) * numerator k true r n i at hv
  change unitScalar (C := specA k n) _ =
    unitScalar (C := specA k n) _ ≫ unitScalar (C := specA k n) _ +
    (unitScalar (C := specA k n) _ ≫ unitScalar (C := specA k n) _) ≫ unitScalar (C := specA k n) _ +
    unitScalar (C := specA k n) _ ≫ unitScalar (C := specA k n) _
  rw [fromSection_unit_comp, fromSection_unit_comp, fromSection_unit_comp,
    fromSection_unit_comp, ← fromSection_unit_add, ← fromSection_unit_add]
  congr 1
  rw [hv, map_add, map_add, map_mul, map_mul, map_mul, map_mul]
  simp only [Nat.reduceSub, pow_one]
  ring


def genericScalar {hr : 0 < r} {T : Tower k r hr} (M : Model k T) :
    LaurentSeries k →+* Γ(genericScheme k M, ⊤) :=
  (genericStructure k M).appTop.hom.comp
    (Scheme.ΓSpecIso (CommRingCat.of (LaurentSeries k))).inv.hom

lemma genericScalar_base {hr : 0 < r} {T : Tower k r hr} (M : Model k T)
    (a : PowerSeries k) :
    genericScalar k M (algebraMap (PowerSeries k) (LaurentSeries k) a) =
      (genericInclusion k M).appTop
        (M.p.appTop ((Scheme.ΓSpecIso (CommRingCat.of (PowerSeries k))).inv a)) := by
  have hc : genericInclusion k M ≫ M.p = genericStructure k M ≫ genericBase k :=
    CategoryTheory.Limits.pullback.condition
  have h := congrArg Scheme.Hom.appTop hc
  simp only [Scheme.Hom.comp_appTop] at h
  have hn := Scheme.ΓSpecIso_inv_naturality
    (show CommRingCat.of (PowerSeries k) ⟶ CommRingCat.of (LaurentSeries k) from
      CommRingCat.ofHom (algebraMap (PowerSeries k) (LaurentSeries k)))
  have hv := congrArg (fun q => q ((Scheme.ΓSpecIso (CommRingCat.of (PowerSeries k))).inv a)) h
  exact (congrArg (genericStructure k M).appTop (ConcreteCategory.congr_hom hn a)).trans hv.symm

lemma dualScale_app {C : Scheme.{u}} {L : C.Modules} (a : Γ(C, ⊤))
    (φ : L ⟶ (𝟙_ C.Modules)) (U : C.Opens) (v : Γ(L,U)) :
    (dualScale a φ).app U v = C.presheaf.map (homOfLE (show U ≤ ⊤ from le_top)).op a *
      (show Γ(C,U) from φ.app U v) := by
  change (fromSection (𝟙_ C.Modules) a).app U (φ.app U v) = _
  rw [fromSection_apply]
  change (show Γ(C,U) from φ.app U v) * _ = _
  exact mul_comm _ _

lemma pulled_add {C S : Scheme.{u}} (f : S ⟶ C) {L : C.Modules}
    (φ ψ : L ⟶ (𝟙_ C.Modules)) :
    pulledInclusion f (φ + ψ) = pulledInclusion f φ + pulledInclusion f ψ := by
  simp only [pulledInclusion, Functor.map_add, Preadditive.add_comp]

lemma restrictDual_scale {hr : 0 < r} {T : Tower k r hr} (M : Model k T)
    (s : baseScheme k ⟶ M.X) (d : ℕ) (a : PowerSeries k) (φ : Dual k M s d) :
    restrictDual k M s d (dualScale
      (M.p.appTop ((Scheme.ΓSpecIso (CommRingCat.of (PowerSeries k))).inv a)) φ) =
      dualScale (genericScalar k M (algebraMap (PowerSeries k) (LaurentSeries k) a))
        (restrictDual k M s d φ) := by
  change pulledInclusion (genericInclusion k M) (dualScale _ φ) = _
  rw [pulled_dualScale, ← genericScalar_base]
  rfl

lemma scaled_pair_cancel {F R : Type*} [Field F] [CommRing R] (ρ : F →+* R)
    (t a b : F) (ht : t ≠ 0) (z x y : R) (h : ρ t * z = ρ a * x + ρ b * y) :
    z = ρ (t⁻¹*a) * x + ρ (t⁻¹*b) * y := by
  calc
    z = (ρ t⁻¹ * ρ t) * z := by rw [← map_mul, inv_mul_cancel₀ ht, map_one, one_mul]
    _ = _ := by rw [mul_assoc, h, mul_add, map_mul, map_mul]; ring

lemma generic_degree_two_span {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X)
    (hs : ArithmeticThetaAlgebraizedMarkedLineR0136.MarkedLift k M (zeroIndex r hr) 1 s)
    (X : Dual k M s 2) (hX : RealizesCoordinate k false M s X)
    (ψ : GenericDual k M s 2) :
    ∃ a b : LaurentSeries k, ψ =
      dualScale (genericScalar k M a) (restrictDual k M s 2 (idealInclusion (s.ker^2))) +
      dualScale (genericScalar k M b) (restrictDual k M s 2 X) := by
  obtain ⟨n, φ, hφ⟩ := (generic_dual_localization k r hr h3 T M hM s hs 2).2 ψ
  obtain ⟨a, b, hab⟩ := algebraic_degree_two_span k h3 M hM s hs X hX φ
  let t := (algebraMap (PowerSeries k) (LaurentSeries k) PowerSeries.X)^n
  have ht : t ≠ 0 := pow_ne_zero n (by
    intro hx
    apply PowerSeries.X_ne_zero (R := k)
    apply IsFractionRing.injective (PowerSeries k) (LaurentSeries k)
    exact hx.trans (map_zero (algebraMap (PowerSeries k) (LaurentSeries k))).symm)
  have heq : restrictDual k M s 2 φ =
      dualScale (genericScalar k M (algebraMap (PowerSeries k) (LaurentSeries k) a))
        (restrictDual k M s 2 (idealInclusion (s.ker^2))) +
      dualScale (genericScalar k M (algebraMap (PowerSeries k) (LaurentSeries k) b))
        (restrictDual k M s 2 X) := by
    rw [hab]
    change pulledInclusion (genericInclusion k M) (_ + _) = _
    rw [pulled_add, pulled_dualScale, pulled_dualScale,
      ← genericScalar_base k M a, ← genericScalar_base k M b]
    rfl
  refine ⟨t⁻¹ * algebraMap (PowerSeries k) (LaurentSeries k) a,
    t⁻¹ * algebraMap (PowerSeries k) (LaurentSeries k) b, ?_⟩
  apply Scheme.Modules.hom_ext
  intro U
  ext v
  let ρ : LaurentSeries k →+* Γ(genericScheme k M,U) :=
    ((genericScheme k M).presheaf.map (homOfLE (show U ≤ ⊤ from le_top)).op).hom.comp (genericScalar k M)
  have hv := hφ U v
  change scalarAt k M U t * (show Γ(genericScheme k M,U) from ψ.app U v) =
    (restrictDual k M s 2 φ).app U v at hv
  rw [heq] at hv
  change scalarAt k M U t * (show Γ(genericScheme k M,U) from ψ.app U v) =
    (dualScale _ (restrictDual k M s 2 (idealInclusion (s.ker^2)))).app U v +
    (dualScale _ (restrictDual k M s 2 X)).app U v at hv
  rw [dualScale_app, dualScale_app] at hv
  change (show Γ(genericScheme k M,U) from ψ.app U v) =
    (dualScale _ (restrictDual k M s 2 (idealInclusion (s.ker^2)))).app U v +
    (dualScale _ (restrictDual k M s 2 X)).app U v
  rw [dualScale_app, dualScale_app]
  exact scaled_pair_cancel ρ t _ _ ht _ _ _ hv


lemma scaled_triple_cancel {F R : Type*} [Field F] [CommRing R] (ρ : F →+* R)
    (t a b c : F) (ht : t ≠ 0) (z x y w : R)
    (h : ρ t * z = ρ a * x + ρ b * y + ρ c * w) :
    z = ρ (t⁻¹*a) * x + ρ (t⁻¹*b) * y + ρ (t⁻¹*c) * w := by
  calc
    z = (ρ t⁻¹ * ρ t) * z := by rw [← map_mul, inv_mul_cancel₀ ht, map_one, one_mul]
    _ = _ := by rw [mul_assoc, h]; simp only [map_mul]; ring

lemma generic_degree_three_span {hr : 0 < r} {T : Tower k r hr}
    (h3 : 3 ≤ r) (M : Model k T) (hM : IsModel k T M)
    (s : baseScheme k ⟶ M.X)
    (hs : ArithmeticThetaAlgebraizedMarkedLineR0136.MarkedLift k M (zeroIndex r hr) 1 s)
    (X : Dual k M s 2) (Y : Dual k M s 3)
    (hX : RealizesCoordinate k false M s X) (hY : RealizesCoordinate k true M s Y)
    (ψ : GenericDual k M s 3) :
    ∃ a b c : LaurentSeries k, ψ =
      dualScale (genericScalar k M a) (restrictDual k M s 3 (idealInclusion (s.ker^3))) +
      dualScale (genericScalar k M b) (restrictDual k M s 3 (raiseDual k M s (by decide : 2 ≤ 3) X)) +
      dualScale (genericScalar k M c) (restrictDual k M s 3 Y) := by
  obtain ⟨n, φ, hφ⟩ := (generic_dual_localization k r hr h3 T M hM s hs 3).2 ψ
  obtain ⟨a, b, c, hab⟩ := algebraic_degree_three_span k h3 M hM s hs X Y hX hY φ
  let t := (algebraMap (PowerSeries k) (LaurentSeries k) PowerSeries.X)^n
  have ht : t ≠ 0 := pow_ne_zero n (by
    intro hx
    apply PowerSeries.X_ne_zero (R := k)
    apply IsFractionRing.injective (PowerSeries k) (LaurentSeries k)
    exact hx.trans (map_zero (algebraMap (PowerSeries k) (LaurentSeries k))).symm)
  have heq : restrictDual k M s 3 φ =
      dualScale (genericScalar k M (algebraMap (PowerSeries k) (LaurentSeries k) a))
        (restrictDual k M s 3 (idealInclusion (s.ker^3))) +
      dualScale (genericScalar k M (algebraMap (PowerSeries k) (LaurentSeries k) b))
        (restrictDual k M s 3 (raiseDual k M s (by decide : 2 ≤ 3) X)) +
      dualScale (genericScalar k M (algebraMap (PowerSeries k) (LaurentSeries k) c))
        (restrictDual k M s 3 Y) := by
    rw [hab]
    change pulledInclusion (genericInclusion k M) (_ + _ + _) = _
    rw [pulled_add, pulled_add, pulled_dualScale, pulled_dualScale, pulled_dualScale,
      ← genericScalar_base k M a, ← genericScalar_base k M b, ← genericScalar_base k M c]
    rfl
  refine ⟨t⁻¹ * algebraMap (PowerSeries k) (LaurentSeries k) a,
    t⁻¹ * algebraMap (PowerSeries k) (LaurentSeries k) b,
    t⁻¹ * algebraMap (PowerSeries k) (LaurentSeries k) c, ?_⟩
  apply Scheme.Modules.hom_ext
  intro U
  ext v
  let ρ : LaurentSeries k →+* Γ(genericScheme k M,U) :=
    ((genericScheme k M).presheaf.map (homOfLE (show U ≤ ⊤ from le_top)).op).hom.comp (genericScalar k M)
  have hv := hφ U v
  change scalarAt k M U t * (show Γ(genericScheme k M,U) from ψ.app U v) =
    (restrictDual k M s 3 φ).app U v at hv
  rw [heq] at hv
  change scalarAt k M U t * (show Γ(genericScheme k M,U) from ψ.app U v) =
    (dualScale _ (restrictDual k M s 3 (idealInclusion (s.ker^3)))).app U v +
    (dualScale _ (restrictDual k M s 3 (raiseDual k M s (by decide : 2 ≤ 3) X))).app U v +
    (dualScale _ (restrictDual k M s 3 Y)).app U v at hv
  rw [dualScale_app, dualScale_app, dualScale_app] at hv
  change (show Γ(genericScheme k M,U) from ψ.app U v) =
    (dualScale _ (restrictDual k M s 3 (idealInclusion (s.ker^3)))).app U v +
    (dualScale _ (restrictDual k M s 3 (raiseDual k M s (by decide : 2 ≤ 3) X))).app U v +
    (dualScale _ (restrictDual k M s 3 Y)).app U v
  rw [dualScale_app, dualScale_app, dualScale_app]
  exact scaled_triple_cancel ρ t _ _ _ ht _ _ _ _ hv

lemma quadratic_normal_form {K R : Type*} [CommRing K] [CommRing R]
    (f : K →+* R) (x y : R) (P : Polynomial K)
    (h : y^2 = Polynomial.eval₂ f x P) (p : MvPolynomial (Fin 2) K) :
    ∃ a b : Polynomial K,
      MvPolynomial.eval₂Hom f ![x,y] p = Polynomial.eval₂ f x a + Polynomial.eval₂ f x b * y := by
  induction p using MvPolynomial.induction_on with
  | C c => exact ⟨Polynomial.C c, 0, by simp⟩
  | add p q hp hq =>
    obtain ⟨a,b,hab⟩ := hp
    obtain ⟨c,d,hcd⟩ := hq
    exact ⟨a+c, b+d, by rw [map_add, hab, hcd]; simp only [Polynomial.eval₂_add]; ring⟩
  | mul_X p i hp =>
    obtain ⟨a,b,hab⟩ := hp
    fin_cases i
    · refine ⟨a * Polynomial.X, b * Polynomial.X, ?_⟩
      rw [map_mul, hab, MvPolynomial.eval₂Hom_X']
      change (Polynomial.eval₂ f x a + Polynomial.eval₂ f x b * y) * x = _
      simp only [Polynomial.eval₂_mul_X]
      ring
    · refine ⟨b * P, a, ?_⟩
      rw [map_mul, hab, MvPolynomial.eval₂Hom_X']
      change (Polynomial.eval₂ f x a + Polynomial.eval₂ f x b * y) * y = _
      simp only [Polynomial.eval₂_mul]
      linear_combination Polynomial.eval₂ f x b * h



def cubicXPolynomial (r : ℕ) : Polynomial (LaurentSeries k) :=
  ∏ j : Fin 3, (Polynomial.X - Polynomial.C
    (algebraMap (PowerSeries k) (LaurentSeries k) (rootSeries k r j)))

lemma cubicCoordinate_relation (r : ℕ) :
    cubicCoordinate k r true ^ 2 = Polynomial.eval₂
      (algebraMap (LaurentSeries k) (CubicRing k r)) (cubicCoordinate k r false) (cubicXPolynomial k r) := by
  have h : Ideal.Quotient.mk (Ideal.span {cubicPolynomial k r}) (cubicPolynomial k r) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
  simp only [cubicPolynomial] at h
  change cubicCoordinate k r true ^ 2 - ∏ j : Fin 3,
    (cubicCoordinate k r false - algebraMap (LaurentSeries k) (CubicRing k r)
      (algebraMap (PowerSeries k) (LaurentSeries k) (rootSeries k r j))) = 0 at h
  unfold cubicXPolynomial
  change _ = (Polynomial.eval₂RingHom (algebraMap (LaurentSeries k) (CubicRing k r))
    (cubicCoordinate k r false)) _
  rw [map_prod]
  rw [sub_eq_zero.mp h]
  apply Finset.prod_congr rfl
  intro j hj
  change _ = Polynomial.eval₂ _ _ _
  simp only [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C]

lemma cubicRing_normal_form (r : ℕ) (z : CubicRing k r) :
    ∃ a b : Polynomial (LaurentSeries k),
      z = Polynomial.eval₂ (algebraMap (LaurentSeries k) (CubicRing k r)) (cubicCoordinate k r false) a +
        Polynomial.eval₂ (algebraMap (LaurentSeries k) (CubicRing k r)) (cubicCoordinate k r false) b *
          cubicCoordinate k r true := by
  have heval : MvPolynomial.eval₂Hom (algebraMap (LaurentSeries k) (CubicRing k r))
      ![cubicCoordinate k r false, cubicCoordinate k r true] =
      Ideal.Quotient.mk (Ideal.span {cubicPolynomial k r}) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      rw [MvPolynomial.eval₂Hom_C]
      rfl
    · intro i
      rw [MvPolynomial.eval₂Hom_X']
      fin_cases i <;> rfl
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
  simpa only [heval] using quadratic_normal_form
    (algebraMap (LaurentSeries k) (CubicRing k r)) (cubicCoordinate k r false) (cubicCoordinate k r true)
    (cubicXPolynomial k r) (cubicCoordinate_relation k r) p

/-- Distinct exact orders are independent even over a nonreduced coefficient
ring, provided the local parameter is regular and evaluation splits the base. -/
lemma exactOrder_coefficients_zero {A R ι : Type*} [CommRing A] [CommRing R]
    (ρ : A →+* R) (ε : R →+* A) (hρ : ∀ a, ε (ρ a) = a)
    (h : R) (hreg : IsRegular h) (he : ε h = 0)
    (S : Finset ι) (n : ι → ℕ) (w : ι → R)
    (hn : Set.InjOn n S) (hw : ∀ i ∈ S, ε (w i) = 1)
    (c : ι → A) (hc : ∑ i ∈ S, ρ (c i) * h^(n i) * w i = 0) :
    ∀ i ∈ S, c i = 0 := by
  classical
  induction S using Finset.strongInductionOn with
  | _ S ih =>
    by_cases hs : S.Nonempty
    · obtain ⟨j, hj, hjmin⟩ := S.exists_min_image n hs
      have hdiv : ∑ i ∈ S, ρ (c i) * h^(n i - n j) * w i = 0 := by
        apply (hreg.pow (n j)).1
        calc
          h^(n j) * (∑ i ∈ S, ρ (c i) * h^(n i - n j) * w i) =
              ∑ i ∈ S, ρ (c i) * h^(n i) * w i := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro i hi
            have hp : h^(n j) * h^(n i - n j) = h^(n i) := by
              rw [← pow_add, Nat.add_sub_of_le (hjmin i hi)]
            calc
              _ = ρ (c i) * (h^(n j) * h^(n i - n j)) * w i := by ring
              _ = _ := by rw [hp]
          _ = h^(n j) * 0 := by rw [hc, mul_zero]
      have hcj : c j = 0 := by
        have hv := congrArg ε hdiv
        rw [map_sum] at hv
        have hsum : ∑ i ∈ S, ε (ρ (c i) * h^(n i - n j) * w i) = c j := by
          rw [Finset.sum_eq_single j]
          · simp [hρ, hw j hj]
          · intro i hi hij
            have hnij : n j < n i := lt_of_le_of_ne (hjmin i hi) (by
              intro heq
              exact hij (hn hi hj heq.symm))
            simp [map_mul, map_pow, hρ, he, zero_pow (by omega : n i - n j ≠ 0), hw i hi]
          · exact fun hj' => False.elim (hj' hj)
        rw [hsum, map_zero] at hv
        exact hv
      have hsmall : S.erase j ⊂ S := Finset.erase_ssubset hj
      have hcrest : ∑ i ∈ S.erase j, ρ (c i) * h^(n i) * w i = 0 := by
        rw [← Finset.sum_erase_add _ _ hj] at hc
        simpa only [hcj, map_zero, zero_mul, add_zero] using hc
      have hcsmall := ih (S.erase j) hsmall (hn.mono (Finset.erase_subset _ _))
        (fun i hi => hw i (Finset.mem_of_mem_erase hi)) hcrest
      intro i hi
      by_cases hij : i = j
      · simpa [hij] using hcj
      · exact hcsmall i (Finset.mem_erase.mpr ⟨hij,hi⟩)
    · simp [Finset.not_nonempty_iff_eq_empty.mp hs]

/-- The nongaps at the identity, in order: zero, two, three, four, ... . -/
def poleWeight (j : ℕ) : ℕ := if j = 0 then 0 else j+1

def poleYExponent (j : ℕ) : ℕ := poleWeight j % 2

def poleXExponent (j : ℕ) : ℕ := (poleWeight j - 3 * poleYExponent j) / 2

lemma poleWeight_decompose (j : ℕ) : 2 * poleXExponent j + 3 * poleYExponent j = poleWeight j := by
  unfold poleXExponent poleYExponent poleWeight
  split_ifs with hj
  · norm_num
  · omega

lemma poleWeight_injective : Function.Injective poleWeight := by
  intro a b h
  unfold poleWeight at h
  split_ifs at h <;> omega

lemma poleWeight_le {d : ℕ} (j : Fin d) : poleWeight j.val ≤ d := by
  unfold poleWeight
  split_ifs <;> omega

variable (k : Type u) [Field k] [CharZero k]

def poleNumerator (r n d : ℕ) (j : Fin d) (i : Fin r) : A k n :=
  equation k r n i ^ (d - poleWeight j.val) *
    (numerator k false r n i ^ poleXExponent j.val * numerator k true r n i ^ poleYExponent j.val)

lemma compatible_mul {r n : ℕ} {hr : 0 < r} {E : B k n false ≃+* B k n true}
    {d e : ℕ} {v w : Fin r → A k n}
    (hv : Compatible k r n hr E d v) (hw : Compatible k r n hr E e w) :
    Compatible k r n hr E (d+e) (fun i => v i * w i) := by
  intro i
  have h := congrArg₂ (· * ·) (hv i) (hw i)
  simp only [map_mul, pow_add]
  convert h using 1 <;> ring

lemma compatible_pow {r n : ℕ} {hr : 0 < r} {E : B k n false ≃+* B k n true}
    {d : ℕ} {v : Fin r → A k n} (hv : Compatible k r n hr E d v) (a : ℕ) :
    Compatible k r n hr E (d*a) (fun i => v i ^ a) := by
  intro i
  have h := congrArg (fun z => z^a) (hv i)
  simpa only [map_pow, mul_pow, pow_mul] using h

lemma compatible_equation {r n : ℕ} {hr : 0 < r} {E : B k n false ≃+* B k n true}
    (d : ℕ) : Compatible k r n hr E d (fun i => equation k r n i ^ d) := by
  intro i
  simp only [map_pow]
  exact mul_comm _ _

lemma poleNumerator_compatible {r : ℕ} {hr : 0 < r} (h3 : 3 ≤ r)
    (T : Tower k r hr) (n d : ℕ) (j : Fin d) :
    Compatible k r n hr (T.overlap n) d (poleNumerator k r n d j) := by
  have hx := compatible_pow k ((tate_x_numerator_system k r hr h3 T).1 n) (poleXExponent j.val)
  have hy := compatible_pow k ((tate_y_numerator_system k r hr h3 T).1 n) (poleYExponent j.val)
  have hh := compatible_mul k (compatible_equation k (d-poleWeight j.val)) (compatible_mul k hx hy)
  change Compatible k r n hr (T.overlap n)
    (d-poleWeight j.val + (2*poleXExponent j.val+3*poleYExponent j.val)) _ at hh
  rw [poleWeight_decompose, Nat.sub_add_cancel (poleWeight_le j)] at hh
  exact hh


open CoordinateExactPolesR0143 ArithmeticThetaGenericEvaluationR0140

lemma poleNumerator_coefficients_zero (r n d : ℕ) (hr : 0 < r) (h3 : 3 ≤ r)
    (c : Fin d → R k n)
    (hc : ∀ i, ∑ j : Fin d, base k n (c j) * poleNumerator k r n d j i = 0) :
    c = 0 := by
  classical
  let z := zeroIndex r hr
  let h := equation k r n z
  have hreg : IsRegular h := by
    simpa [h, z, equation, zeroIndex, show ¬1 = r by omega] using
      (IdentityChartIdealR0138.right_equation k n).2
  have he : markedPoint k n 1 h = 0 := marked_equation k r n hr
  have hn (odd : Bool) : markedPoint k n 1 (numerator k odd r n z) = 1 :=
    numerator_identity k odd r n hr h3
  have hinj : Set.InjOn (fun j : Fin d => d-poleWeight j.val) (Finset.univ : Finset (Fin d)) := by
    intro a ha b hb hab
    change d - poleWeight a.val = d - poleWeight b.val at hab
    have ha' := poleWeight_le a
    have hb' := poleWeight_le b
    apply Fin.ext
    apply poleWeight_injective
    omega
  have hh : ∑ j : Fin d, base k n (c j) * h^(d-poleWeight j.val) *
      (numerator k false r n z ^ poleXExponent j.val *
       numerator k true r n z ^ poleYExponent j.val) = 0 := by
    simpa only [poleNumerator, mul_assoc] using hc z
  have hz := exactOrder_coefficients_zero (base k n) (markedPoint k n 1)
    (AlgebraicIdentityEvaluationR0140.marked_base k n) h hreg he Finset.univ
    (fun j : Fin d => d-poleWeight j.val)
    (fun j : Fin d => numerator k false r n z ^ poleXExponent j.val *
       numerator k true r n z ^ poleYExponent j.val) hinj
    (by intro j hj; simp only [map_mul, map_pow, hn, one_pow, mul_one]) c hh
  funext j
  exact hz j (Finset.mem_univ j)

set_option backward.isDefEq.respectTransparency true
section HigherKernel
variable {k} {n : ℕ}
open IdentityPositiveSectionsRankR0138
attribute [local instance] IdentityPositiveSectionsRankR0138.nodeAlgebra
  IdentityPositiveSectionsRankR0138.nodeModule
  IdentityPositiveSectionsRankR0138.nodeAction
  IdentityPositiveSectionsRankR0138.nodeScalar
  IdentityPositiveSectionsRankR0138.nodeFamilyScalar

variable (r : ℕ) (hr : 0 < r) (h3 : 3 ≤ r) (T : Tower k r hr)
    (L : B k n true ≃+* LaurentPolynomial (R k n)) (hL : LaurentPresentation k n L)
    (d : ℕ)

def poleVector (j : Fin d) :
    LinearMap.ker (difference L hL (T.overlap n) (T.overlap_spec n) r hr d) :=
  ⟨poleNumerator k r n d j,
    (compatible_iff_difference L hL (T.overlap n) (T.overlap_spec n) r hr h3 d _).mp
      (poleNumerator_compatible k h3 T n d j)⟩

def poleCombination : (Fin d → R k n) →ₗ[R k n]
    LinearMap.ker (difference L hL (T.overlap n) (T.overlap_spec n) r hr d) :=
  Fintype.linearCombination (R k n) (poleVector r hr h3 T L hL d)

lemma poleCombination_apply (c : Fin d → R k n) (i : Fin r) :
    (poleCombination r hr h3 T L hL d c).val i =
      ∑ j : Fin d, base k n (c j) * poleNumerator k r n d j i := by
  change (Fintype.linearCombination (R k n) (poleVector r hr h3 T L hL d) c).val i = _
  rw [Fintype.linearCombination_apply]
  simp only [Submodule.coe_sum, Submodule.coe_smul, Finset.sum_apply]
  rfl

lemma poleCombination_injective : Function.Injective (poleCombination r hr h3 T L hL d) := by
  apply LinearMap.ker_eq_bot.mp
  apply LinearMap.ker_eq_bot'.mpr
  intro c hc
  apply poleNumerator_coefficients_zero k r n d hr h3 c
  intro i
  rw [← poleCombination_apply r hr h3 T L hL, hc]
  rfl

lemma poleCombination_surjective (hd : 0 < d) :
    Function.Surjective (poleCombination r hr h3 T L hL d) := by
  let : IsArtinianRing (R k n) := DegreeThreeCoordinateBasisR0144.base_artinian k n
  let e := (kernelCoordinates L hL (T.overlap n) (T.overlap_spec n) r hr h3 d hd).trans
    (Finsupp.linearEquivFunOnFinite (R k n) (R k n) (Fin d))
  let f := e.toLinearMap.comp (poleCombination r hr h3 T L hL d)
  have hf : Function.Injective f := e.injective.comp (poleCombination_injective r hr h3 T L hL d)
  have hs := IsArtinian.surjective_of_injective_endomorphism f hf
  intro v
  obtain ⟨c, hc⟩ := hs (e v)
  exact ⟨c, e.injective hc⟩

end HigherKernel

lemma poleNumerator_degree_two (r n : ℕ) (j : Fin 2) (i : Fin r) :
    basisNumerator k false r n j i = poleNumerator k r n 2 j i := by
  fin_cases j <;> simp [basisNumerator, poleNumerator, poleXExponent, poleYExponent, poleWeight, degree]

lemma poleNumerator_degree_three (r n : ℕ) (j : Fin 3) (i : Fin r) :
    basisNumerator k true r n j i = poleNumerator k r n 3 j i := by
  fin_cases j <;> simp [basisNumerator, poleNumerator, poleXExponent, poleYExponent, poleWeight, degree]

open IdentityPositiveSectionsRankR0138
lemma higher_pole_basis (r : ℕ) (hr : 0 < r) (h3 : 3 ≤ r)
    (T : Tower k r hr) (n d : ℕ) (hd : 0 < d)
    (v : Sections k r n hr (T.overlap n) d) :
    ∃! c : Fin d → R k n, ∀ i,
      v.val i = ∑ j : Fin d, base k n (c j) * poleNumerator k r n d j i := by
  by_cases h2 : d = 2
  · subst d
    have hb : ∃! c : Fin 2 → R k n, ∀ i,
        v.val i = ∑ j : Fin 2, base k n (c j) * basisNumerator k false r n j i :=
      (degree_two_coordinate_basis k r hr h3 T n).2 v
    simpa only [poleNumerator_degree_two] using hb
  by_cases h3d : d = 3
  · subst d
    have hb : ∃! c : Fin 3 → R k n, ∀ i,
        v.val i = ∑ j : Fin 3, base k n (c j) * basisNumerator k true r n j i :=
      (degree_three_coordinate_basis k r hr h3 T n).2 v
    simpa only [poleNumerator_degree_three] using hb
  obtain ⟨L, hL, _⟩ := truncated_laurent_presentation k n
  let w := sectionsKernel L hL (T.overlap n) (T.overlap_spec n) r hr h3 d v
  obtain ⟨c, hc⟩ := poleCombination_surjective r hr h3 T L hL d hd w
  refine ⟨c, ?_, ?_⟩
  · intro i
    have hi := congrArg (fun s => s.val i) hc
    exact hi.symm.trans (poleCombination_apply r hr h3 T L hL d c i)
  · intro b hb
    apply poleCombination_injective r hr h3 T L hL d
    apply Subtype.ext
    funext i
    rw [poleCombination_apply, hc]
    exact (hb i).symm


open ArithmeticThetaIdentitySectionsR0138.AlgebraizedThetaSectionsR0138
variable {r : ℕ}

lemma poleNumerator_reduce {hr : 0 < r} (h3 : 3 ≤ r) (T : Tower k r hr)
    (n N : ℕ) (h : n ≤ N) (d : ℕ) (j : Fin d) (i : Fin r) :
    truncReduce (ArithmeticThetaNodeCharts.Node k) (ArithmeticThetaNodeCharts.t k) n N h
      (poleNumerator k r N d j i) = poleNumerator k r n d j i := by
  have hx := (tate_x_numerator_system k r hr h3 T).2 n N h i
  have hy := (tate_y_numerator_system k r hr h3 T).2 n N h i
  simp only [poleNumerator, map_pow, map_mul, reduce_equation, hx, hy]

lemma formal_higher_pole_basis {hr : 0 < r} (h3 : 3 ≤ r) (T : Tower k r hr)
    (d : ℕ) (hd : 0 < d) (v : FormalNumerators k (T := T) d) :
    ∃! c : Fin d → PowerSeries k, ∀ n i,
      (v.val n).val i = ∑ j, base k n (trunc (PowerSeries k) PowerSeries.X n (c j)) *
        poleNumerator k r n d j i := by
  classical
  have hb := fun n => higher_pole_basis k r hr h3 T n d hd (v.val n)
  choose c hc using fun n => (hb n).exists
  have hred : ∀ n N (h : n ≤ N) j,
      truncReduce (PowerSeries k) PowerSeries.X n N h (c N j) = c n j := by
    intro n N h j
    have heq : (fun j => truncReduce (PowerSeries k) PowerSeries.X n N h (c N j)) = c n := by
      apply (hb n).unique
      · intro i
        have hv := congrArg
          (truncReduce (ArithmeticThetaNodeCharts.Node k) (ArithmeticThetaNodeCharts.t k) n N h)
          (hc N i)
        simpa only [v.property n N h i, map_sum, map_mul,
          ArithmeticThetaPositiveLineR0134.PositiveSectionsReductionR0134.reduce_base,
          poleNumerator_reduce k h3 T n N h d] using hv
      · exact hc n
    exact congrFun heq j
  choose a ha using fun j =>
    (ArithmeticThetaPositiveLineR0134.CompatibleFormalSectionBasisR0134.powerSeries_limit k
      (fun n => c n j) (fun n N h => hred n N h j)).exists
  refine ⟨a, ?_, ?_⟩
  · intro n i
    simp only [ha]
    exact hc n i
  · intro b hb'
    funext j
    apply AlgebraizedThetaSaturationR0138.powerSeries_ext
    intro n
    rw [ha]
    have heq : (fun j => trunc (PowerSeries k) PowerSeries.X n (b j)) = c n :=
      (hb n).unique (hb' n) (hc n)
    exact congrFun heq j



