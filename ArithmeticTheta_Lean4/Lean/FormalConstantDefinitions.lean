import CompletedChartDefinitions
import GeometricConstants
import Mathlib.RingTheory.AdicCompletion.Algebra
import Mathlib.RingTheory.Localization.Away.Basic

open AlgebraicGeometry CategoryTheory
universe u
noncomputable section
namespace ArithmeticThetaFormalConstants

variable (R : Type u) [CommRing R] (X : Scheme.{u})
  (f : X ⟶ Spec (CommRingCat.of R)) (t : R)

/-- Pullback of a base scalar through the specified structural morphism. -/
def structuralMap (U : X.Opens) : R →+* Γ(X, U) :=
  (Scheme.TwoAffineOpenCover.algebraOfHom f U).algebraMap

/-- Ring completion at the ideal generated by the actual image of the parameter. -/
abbrev RingCompleted (U : X.Opens) :=
  AdicCompletion (Ideal.span {structuralMap R X f U t}) Γ(X, U)

/-- The actual completion map of an affine coordinate ring (also defined on overlaps). -/
def ringOf (U : X.Opens) : Γ(X, U) →+* RingCompleted R X f t U :=
  algebraMap Γ(X, U) (RingCompleted R X f t U)

/-- Structural parameter in the completed coordinate ring. -/
def ringParameter (U : X.Opens) : RingCompleted R X f t U :=
  ringOf R X f t U (structuralMap R X f U t)

/-- The actual ring localization, with no domain hypothesis on empty overlaps. -/
abbrev LocalizedRing (U : X.Opens) :=
  Localization.Away (ringParameter R X f t U)

def localizedOf (U : X.Opens) : RingCompleted R X f t U →+* LocalizedRing R X f t U :=
  algebraMap (RingCompleted R X f t U) (LocalizedRing R X f t U)

/-- Comparison families use the structural R-action on each actual chart. -/
abbrev CompletionEquivalences := ∀ U : X.Opens,
  letI := Scheme.TwoAffineOpenCover.algebraOfHom f U
  RingCompleted R X f t U ≃ₗ[R] ArithmeticThetaCompletedCharts.Completed R X f t U

def MatchesCompletion (e : CompletionEquivalences R X f t) : Prop :=
  ∀ (U : X.Opens) (a : Γ(X, U)),
    e U (ringOf R X f t U a) =
      AdicCompletion.of (Ideal.span {t}) (ArithmeticThetaCompletedCharts.Sections R X f U) a

/-- The comparison on localizations is also over that structural action. -/
abbrev LocalizedEquivalences := ∀ U : X.Opens,
  letI := Scheme.TwoAffineOpenCover.algebraOfHom f U
  LocalizedRing R X f t U ≃ₗ[R]
    ArithmeticThetaCompletedCharts.LocalizedCompleted R X f t U

def MatchesLocalization (e : CompletionEquivalences R X f t)
    (ell : LocalizedEquivalences R X f t) : Prop :=
  ∀ (U : X.Opens) (a : RingCompleted R X f t U),
    ell U (localizedOf R X f t U a) =
      ArithmeticThetaCompletedCharts.toLocalized R X f t U (e U a)

/-- Extension of a specified structure-sheaf restriction; no free compatibility field. -/
def ExtendsRestriction {U V : X.Opens} (h : V ≤ U)
    (phi : RingCompleted R X f t U →+* RingCompleted R X f t V) : Prop :=
  ∀ a : Γ(X, U), phi (ringOf R X f t U a) =
    ringOf R X f t V ((X.presheaf.map (homOfLE h).op).hom a)

/-- Compatibility with the actual localization maps. -/
def ExtendsLocalization {U V : X.Opens}
    (phi : RingCompleted R X f t U →+* RingCompleted R X f t V)
    (psi : LocalizedRing R X f t U →+* LocalizedRing R X f t V) : Prop :=
  ∀ a : RingCompleted R X f t U,
    psi (localizedOf R X f t U a) = localizedOf R X f t V (phi a)

/-- Actual localized completed chart sections on the chosen finite affine cover. -/
abbrev RingFamily (C : X.OrderedAffineCover) := ∀ i : C.ι, LocalizedRing R X f t (C.U i)

/-- Compatibility via all extensions of the actual overlap restrictions.
The batch separately proves these extensions exist and are unique, including
on empty overlaps; this predicate is not used as an existence assumption. -/
def RingCompatible (C : X.OrderedAffineCover) (z : RingFamily R X f t C) : Prop :=
  ∀ i j
    (phi : RingCompleted R X f t (C.U i) →+* RingCompleted R X f t (C.U i ⊓ C.U j))
    (phi' : RingCompleted R X f t (C.U j) →+* RingCompleted R X f t (C.U i ⊓ C.U j))
    (psi : LocalizedRing R X f t (C.U i) →+* LocalizedRing R X f t (C.U i ⊓ C.U j))
    (psi' : LocalizedRing R X f t (C.U j) →+* LocalizedRing R X f t (C.U i ⊓ C.U j)),
    ExtendsRestriction R X f t (show C.U i ⊓ C.U j ≤ C.U i from inf_le_left) phi →
    ExtendsRestriction R X f t (show C.U i ⊓ C.U j ≤ C.U j from inf_le_right) phi' →
    ExtendsLocalization R X f t phi psi → ExtendsLocalization R X f t phi' psi' →
    psi (z i) = psi' (z j)

/-- The genuine generic fiber over k((t)), not an independently selected scheme. -/
abbrev genericFiber (k : Type u) [Field k] (Y : Scheme.{u})
    (g : Y ⟶ Spec (CommRingCat.of (PowerSeries k))) :=
  Limits.pullback g (Spec.map (CommRingCat.ofHom
    (algebraMap (PowerSeries k) (LaurentSeries k))))

abbrev genericStructure (k : Type u) [Field k] (Y : Scheme.{u})
    (g : Y ⟶ Spec (CommRingCat.of (PowerSeries k))) :
    genericFiber k Y g ⟶ Spec (CommRingCat.of (LaurentSeries k)) :=
  Limits.pullback.snd g (Spec.map (CommRingCat.ofHom
    (algebraMap (PowerSeries k) (LaurentSeries k))))

/-- Equality with a Laurent scalar is expressed by a common parameter denominator
and the actual completed restrictions of its numerator. This includes c=0. -/
def IsLaurentConstant (k : Type u) [Field k] (Y : Scheme.{u})
    (g : Y ⟶ Spec (CommRingCat.of (PowerSeries k)))
    (C : Y.OrderedAffineCover)
    (z : ArithmeticThetaCompletedCharts.LocalizedFamily
      (PowerSeries k) Y g (PowerSeries.X : PowerSeries k) C)
    (c : LaurentSeries k) : Prop :=
  ∃ (n : ℕ) (r : PowerSeries k),
    algebraMap (PowerSeries k) (LaurentSeries k) r =
      algebraMap (PowerSeries k) (LaurentSeries k) (PowerSeries.X ^ n) * c ∧
    ∀ i : C.ι,
      ArithmeticThetaCompletedCharts.toLocalized (PowerSeries k) Y g PowerSeries.X (C.U i)
        (ArithmeticThetaCompletedCharts.globalToCompleted (PowerSeries k) Y g PowerSeries.X
          (C.U i) (structuralMap (PowerSeries k) Y g ⊤ r)) =
      (PowerSeries.X : PowerSeries k) ^ n • z i

/-- Equality with the structural Laurent scalar in the actual localized chart rings. -/
def IsRingLaurentConstant (k : Type u) [Field k] (Y : Scheme.{u})
    (g : Y ⟶ Spec (CommRingCat.of (PowerSeries k))) (C : Y.OrderedAffineCover)
    (z : RingFamily (PowerSeries k) Y g PowerSeries.X C) (c : LaurentSeries k) : Prop :=
  ∃ (n : ℕ) (r : PowerSeries k),
    algebraMap (PowerSeries k) (LaurentSeries k) r =
      algebraMap (PowerSeries k) (LaurentSeries k) (PowerSeries.X ^ n) * c ∧
    ∀ i : C.ι,
      localizedOf (PowerSeries k) Y g PowerSeries.X (C.U i)
        (ringOf (PowerSeries k) Y g PowerSeries.X (C.U i)
          (structuralMap (PowerSeries k) Y g (C.U i) r)) =
      (localizedOf (PowerSeries k) Y g PowerSeries.X (C.U i)
        (ringParameter (PowerSeries k) Y g PowerSeries.X (C.U i))) ^ n * z i

end ArithmeticThetaFormalConstants
