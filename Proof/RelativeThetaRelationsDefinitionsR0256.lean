variable {R : Type u} [CommRing R] (E : EllipticFamily R)

def multiple (P : point E) (n : ℕ) : point E := E.law.nsmul (𝟙 _) n P

/-- Composition in the actual theta group, with the contravariant pullback order. -/
def compose (m : ℕ) (f g : E.curve ⟶ E.curve)
    (α : Lift E m f) (β : Lift E m g) : Lift E m (f ≫ g) :=
  ((Scheme.Modules.pullbackComp f g).app _).symm ≪≫
    (Scheme.Modules.pullback f).mapIso β ≪≫ α

def identityLift (m : ℕ) : Lift E m (𝟙 E.curve) :=
  (Scheme.Modules.pullbackId E.curve).app _

def changeMap (m : ℕ) {f g : E.curve ⟶ E.curve} (h : f = g)
    (α : Lift E m g) : Lift E m f :=
  (Scheme.Modules.pullbackCongr h).app _ ≪≫ α

/-- The scalar is pulled back by the given structural map, not a self-action. -/
def scalar (c : Rˣ) : Γ(E.curve, ⊤)ˣ :=
  Units.map (((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ E.projection.appTop).hom.toMonoidHom) c

def scaled (m : ℕ) {f : E.curve ⟶ E.curve} (c : Rˣ)
    (α : Lift E m f) : Lift E m f :=
  α ≪≫ P2MW.S_AlgebraicGeometry_Polarisation_subsingleton_rigidifiedIso.AlgebraicGeometry.Scheme.Modules.P2K2.smulIso (scalar E c) (thetaLine E m)

/-- Equality of sheaf isomorphisms, with the actual commuting translations. -/
def Commutator (m : ℕ) (P Q : point E)
    (α : Lift E m (translation E P)) (β : Lift E m (translation E Q))
    (c : Rˣ) : Prop :=
  ∃ h : translation E P ≫ translation E Q = translation E Q ≫ translation E P,
    compose E m (translation E P) (translation E Q) α β =
      scaled E m c (changeMap E m h
        (compose E m (translation E Q) (translation E P) β α))

/-- Primitivity on every fibre, meaningful also on the empty base. -/
def PrimitiveUnit (m : ℕ) (c : Rˣ) : Prop :=
  c ^ m = 1 ∧ ∀ i : Fin m, i.val ≠ 0 → IsUnit ((c : R) ^ i.val - 1)

/-- A splitting over the cyclic subgroup generated by the actual doubled point.
The periodicity and group laws are equalities of the entire line sheaf. -/
def CyclicSystem (m : ℕ) (P : point E) (ι : Lift E m (inverse E))
    (A : ∀ n : ℕ, Lift E m (translation E (multiple E P n))) : Prop :=
  (∀ n, MidpointNormalized E m (multiple E P n) ι (A n) ∧
    Symmetric E m (multiple E P n) ι (A n)) ∧
  (∃ h : translation E (multiple E P 0) = 𝟙 E.curve,
    A 0 = changeMap E m h (identityLift E m)) ∧
  (∀ a b : ℕ, ∃ h : translation E (multiple E P a) ≫
      translation E (multiple E P b) = translation E (multiple E P (a+b)),
    compose E m _ _ (A a) (A b) = changeMap E m h (A (a+b))) ∧
  (∀ a : ℕ, ∃ h : translation E (multiple E P (a+m)) =
      translation E (multiple E P a),
    A (a+m) = changeMap E m h (A a))

