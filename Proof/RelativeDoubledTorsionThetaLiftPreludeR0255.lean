    (Scheme.Hom.isAffineOpen_preimage_and_isPushout_of_isPullback f fk i hi' U hU).2

  have hsum' : (∑ j, algebraMap B₁ (X.presheaf.obj (Opposite.op U)) (ι (v j)) * s j) = δ := hsum
  have hread' : ∀ ξ : Module.Dual (ResidueField B₁) V,
