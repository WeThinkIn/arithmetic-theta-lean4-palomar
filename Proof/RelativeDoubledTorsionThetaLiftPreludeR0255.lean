section ActualCubeReduction

open MonoidalCategory

/-- Points of E with test scheme E and the specified structure morphism. -/
abbrev curvePoint := SchemeHomOver E.projection E.projection

local instance curvePointCommGroup : CommGroup (curvePoint E) :=
  { E.law.pointGroup E.projection with mul_comm := E.commutative E.projection }

/-- Pullbacks of the actual normalized line along the actual represented points. -/
def pullbackPrimitive (a : curvePoint E) : E.curve.Modules :=
  (Scheme.Modules.pullback a.val).obj (primitiveThetaLine E)

lemma pullbackPrimitive_invertible (a : curvePoint E) :
    Scheme.Modules.IsInvertible (pullbackPrimitive E a) :=
  (primitiveThetaLine_invertible E).pullback _

lemma curvePoint_one_val : (1 : curvePoint E).val = E.projection ≫ zero E := by
  exact (congrArg Subtype.val (E.law.one_natural (𝟙 _) E.projection E.projection
    (Category.comp_id _))).symm

def pullbackPrimitiveUnitIso : pullbackPrimitive E 1 ≅ 𝟙_ E.curve.Modules :=
  (Scheme.Modules.pullbackCongr (curvePoint_one_val E)).app _ ≪≫
    ((Scheme.Modules.pullbackComp E.projection (zero E)).app _).symm ≪≫
    (Scheme.Modules.pullback E.projection).mapIso (primitiveRigidification E) ≪≫
    Scheme.Modules.pullbackTensorUnitObjIso E.projection

def pullbackPrimitiveInvIso (a : curvePoint E) :
    pullbackPrimitive E a⁻¹ ≅ pullbackPrimitive E a :=
  (Scheme.Modules.pullbackCongr (comp_inverse E E.projection a).symm).app _ ≪≫
    ((Scheme.Modules.pullbackComp a.val (inverse E)).app _).symm ≪≫
      (Scheme.Modules.pullback a.val).mapIso (primitiveInverseIso E)

/-- The constant E-valued point associated to the actual base section P. -/
def constantPoint (P : point E) : curvePoint E :=
  GoodReductionJacobian.schemeHomOverComp E.projection (Category.comp_id _) P

lemma constantPoint_torsion (P : point E) (n : ℕ)
    (hP : P.val ≫ E.law.schemeNsmul n = zero E) :
    constantPoint E P ^ n = 1 := by
  have h := E.law.nsmul_natural (𝟙 _) E.projection E.projection
    (Category.comp_id _) n P
  rw [(killed_iff E P n).mp hP, E.law.one_natural] at h
  change E.law.one E.projection = E.law.nsmul E.projection n (constantPoint E P) at h
  rw [nsmul_pow] at h
  exact h.symm

lemma id_mul_constantPoint_two (P : point E) :
    ((GoodReductionJacobian.RelativeGroupLaw.idPoint : curvePoint E) * constantPoint E P ^ 2).val =
      ArithmeticThetaRelativeThetaLiftsR0255.translation E P := by
  have h := E.law.nsmul_natural (𝟙 _) E.projection E.projection
    (Category.comp_id _) 2 P
  change constantPoint E (E.law.nsmul (𝟙 _) 2 P) =
    E.law.nsmul E.projection 2 (constantPoint E P) at h
  rw [nsmul_pow E E.projection (constantPoint E P) 2] at h
  rw [← h]
  rfl

/-- The concrete geometric cube statement on actual pullback sheaves.
It is proved by `actualPrimitiveCube` below. -/
def ActualPrimitiveCube : Prop :=
  ∀ a b c : curvePoint E, Nonempty
    (pullbackPrimitive E (a * b * c) ⊗
        ((pullbackPrimitive E a ⊗ pullbackPrimitive E b) ⊗ pullbackPrimitive E c) ≅
      (pullbackPrimitive E (a * b) ⊗ pullbackPrimitive E (b * c)) ⊗
        pullbackPrimitive E (c * a))

/-- Conditional reduction with the full original base, universe, section and
line preserved. The geometric cube provider is supplied by `actualPrimitiveCube` below. -/
theorem lift_of_actualPrimitiveCube (hcube : ActualPrimitiveCube E)
    (m : ℕ) (hm : 0 < m) (P : point E)
    (hP : P.val ≫ E.law.schemeNsmul (2 * m) = zero E) :
    Nonempty (Lift E m (ArithmeticThetaRelativeThetaLiftsR0255.translation E P)) := by
  obtain ⟨α⟩ := lineFamily_doubled_torsion (pullbackPrimitive E)
    (pullbackPrimitive_invertible E) ⟨pullbackPrimitiveUnitIso E⟩
    (fun a => ⟨pullbackPrimitiveInvIso E a⟩) hcube m
    GoodReductionJacobian.RelativeGroupLaw.idPoint (constantPoint E P)
    (constantPoint_torsion E P (2 * m) hP)
  let f := ArithmeticThetaRelativeThetaLiftsR0255.translation E P
  let eleft : pullbackPrimitive E
      ((GoodReductionJacobian.RelativeGroupLaw.idPoint : curvePoint E) * constantPoint E P ^ 2) ≅
        (Scheme.Modules.pullback f).obj (primitiveThetaLine E) :=
    (Scheme.Modules.pullbackCongr (id_mul_constantPoint_two E P)).app _
  let eright : pullbackPrimitive E GoodReductionJacobian.RelativeGroupLaw.idPoint ≅
      primitiveThetaLine E := (Scheme.Modules.pullbackId E.curve).app _
  exact ⟨(Scheme.Modules.pullback f).mapIso (thetaLinePowerIso E m hm) ≪≫
    Scheme.Modules.pullbackTensorPowIso f (primitiveThetaLine E) m ≪≫
    Scheme.Modules.tensorPowMapIso eleft.symm m ≪≫ α ≪≫
    Scheme.Modules.tensorPowMapIso eright m ≪≫ (thetaLinePowerIso E m hm).symm⟩

#print axioms constantPoint_torsion
#print axioms lift_of_actualPrimitiveCube

end ActualCubeReduction

