  obtain rfl : W = i ⁻¹ᵁ U := le_antisymm hW hW'
  obtain ⟨n, v, s, hsum, hread⟩ := hδ

  letI iA : Algebra B₁ Γ(X, U) := f.sectionsAlgebra U
  letI iAk : Algebra (ResidueField B₁) Γ(Xk, i ⁻¹ᵁ U) := fk.sectionsAlgebra (i ⁻¹ᵁ U)
