@[expose] public section

/-! Scheme-level preparation for the relative doubled-torsion lift.
This module constructs the global relative doubled-torsion theta lift, including
the actual relative cube comparison and its integral cancellation. -/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
universe u

namespace ArithmeticThetaRelativeThetaLiftsR0255.RelativeDoubledTorsionThetaLiftR0255

open CategoryTheory AlgebraicGeometry NeronModelInfra
open ArithmeticThetaLegendreAtlasR0176
open ArithmeticThetaOpenHodgeR0180.GlobalLevelCyclicQuotientR0180

variable {R : Type u} [CommRing R] (E : EllipticFamily R)

/-- The represented torsion equation is the torsion equation on actual sections. -/
lemma killed_iff (P : point E) (n : ℕ) :
    P.val ≫ E.law.schemeNsmul n = zero E ↔
      E.law.nsmul (𝟙 _) n P = E.law.one (𝟙 _) := by
  rw [comp_nsmul]
  exact Subtype.val_inj

/-- The doubled point in the prescribed translation is killed by m. -/
lemma doubled_killed (m : ℕ) (P : point E)
    (hP : P.val ≫ E.law.schemeNsmul (2 * m) = zero E) :
    (E.law.nsmul (𝟙 _) 2 P).val ≫ E.law.schemeNsmul m = zero E := by
  rw [nsmul_comp, ← comp_nsmul]
  exact hP

/-- Translation preserves the actual structure map. -/
lemma translation_over (P : point E) :
    ArithmeticThetaRelativeThetaLiftsR0255.translation E P ≫ E.projection =
      E.projection :=
  E.law.translate_over _

/-- Any line pulled back from the base has a canonical translation comparison. -/
def baseLineTranslationIso (P : point E) (H : (base (R := R)).Modules) :
    (Scheme.Modules.pullback (ArithmeticThetaRelativeThetaLiftsR0255.translation E P)).obj
      ((Scheme.Modules.pullback E.projection).obj H) ≅
        (Scheme.Modules.pullback E.projection).obj H :=
  (Scheme.Modules.pullbackComp _ E.projection).app H ≪≫
    (Scheme.Modules.pullbackCongr (translation_over E P)).app H

/-- An origin-divisor-line comparison suffices; the actual Hodge factor is retained. -/
def liftOfOriginLineIso (m : ℕ) (P : point E)
    (α : (Scheme.Modules.pullback
      (ArithmeticThetaRelativeThetaLiftsR0255.translation E P)).obj
        (Scheme.Modules.dual (((zero E).ker ^ m).module)) ≅
          Scheme.Modules.dual (((zero E).ker ^ m).module)) :
    Lift E m (ArithmeticThetaRelativeThetaLiftsR0255.translation E P) :=
  Scheme.Modules.pullbackTensorObjIso _ _ _ ≪≫
    MonoidalCategory.tensorIso α
      (baseLineTranslationIso E P
        (((Scheme.Modules.pullback (zero E)).obj E.projection.kaehler).tensorPow m))

/-- This includes all 2-torsion half-points, not just the identity section. -/
lemma translation_eq_id_of_two_killed (P : point E)
    (hP : P.val ≫ E.law.schemeNsmul 2 = zero E) :
    ArithmeticThetaRelativeThetaLiftsR0255.translation E P = 𝟙 E.curve := by
  unfold ArithmeticThetaRelativeThetaLiftsR0255.translation
  rw [(killed_iff E P 2).mp hP, E.law.translate_one]

/-- Canonical global lift when the doubled section is the identity. -/
def liftOfTwoKilled (m : ℕ) (P : point E)
    (hP : P.val ≫ E.law.schemeNsmul 2 = zero E) :
    Lift E m (ArithmeticThetaRelativeThetaLiftsR0255.translation E P) :=
  (Scheme.Modules.pullbackCongr (translation_eq_id_of_two_killed E P hP)).app _ ≪≫
    (Scheme.Modules.pullbackId E.curve).app _

#print axioms doubled_killed
#print axioms liftOfOriginLineIso
#print axioms liftOfTwoKilled

section QuadraticCancellation

open QuadraticMap

variable {A B : Type*} [AddCommGroup A] [AddCommGroup B]

/-- The algebraic cancellation needed after constructing the symmetric cubical
Picard class. No divisibility, torsion-freeness, or choice of roots in the target
group is used. The actual geometric provider is constructed below. -/
lemma quadratic_doubled_torsion (Q : QuadraticMap ℤ A B) (m : ℕ) (x p : A)
    (hp : (2 * m) • p = 0) : m • Q (x + (2 : ℕ) • p) = m • Q x := by
  have hB (z : A) : (2 * m) • polar Q z p = 0 := by
    change (2 * m) • (Q.polarBilin z) p = 0
    rw [← map_nsmul, hp, map_zero]
  have hq : m • ((4 : ℕ) • Q p) = 0 := by
    have h := hB p
    rw [Q.polar_self, ← mul_smul] at h
    rw [← mul_smul]
    convert h using 1 <;> congr 1 <;> omega
  have hx : m • polar Q x ((2 : ℕ) • p) = 0 := by
    change m • (Q.polarBilin x) ((2 : ℕ) • p) = 0
    rw [map_nsmul, ← mul_smul, Nat.mul_comm m 2]
    exact hB x
  have htwo : Q ((2 : ℕ) • p) = (4 : ℕ) • Q p := by
    simpa only [two_nsmul] using Q.map_add_self p
  calc
    m • Q (x + (2 : ℕ) • p) =
        m • Q x + m • Q ((2 : ℕ) • p) + m • polar Q x ((2 : ℕ) • p) := by
      simp only [polar, smul_sub]
      abel
    _ = m • Q x := by rw [htwo, hq, hx, add_zero, add_zero]

#print axioms quadratic_doubled_torsion

/-- A symmetric, identity-normalized cubical class has the required doubled
torsion invariance. This isolates the integral calculation from the geometric
theorem of the cube, including possible torsion in the Picard group. -/
lemma symmetric_cube_doubled_torsion (q : A → B) (hzero : q 0 = 0)
    (hsym : ∀ a, q (-a) = q a)
    (hcube : ∀ a b c, q (a + b + c) + (q a + q b + q c) =
      q (a + b) + q (b + c) + q (c + a))
    (m : ℕ) (x p : A) (hp : (2 * m) • p = 0) :
    m • q (x + (2 : ℕ) • p) = m • q x := by
  have hleft (a b c : A) : polar q (a + b) c = polar q a c + polar q b c :=
    polar_add_left_iff.mpr (hcube a b c)
  have hright (a b c : A) : polar q a (b + c) = polar q a b + polar q a c := by
    rw [polar_comm q a, hleft, polar_comm q b, polar_comm q c]
  have hz (a : A) : polar q a 0 = 0 := by simp only [polar, add_zero, hzero, sub_self]
  have hn (a b : A) (n : ℕ) : polar q a (n • b) = n • polar q a b := by
    induction n with
    | zero => simp only [zero_smul, hz]
    | succ n ih => rw [succ_nsmul, hright, ih, succ_nsmul]
  have hdiag : polar q p p = (2 : ℕ) • q p := by
    have h := hright p p (-p)
    rw [add_neg_cancel, hz] at h
    have hneg : polar q p (-p) = -((2 : ℕ) • q p) := by
      simp only [polar, add_neg_cancel, hzero, hsym, two_nsmul]
      abel
    rw [hneg] at h
    exact sub_eq_zero.mp (by simpa only [sub_eq_add_neg] using h.symm)
  have hB (a : A) : (2 * m) • polar q a p = 0 := by
    rw [← hn, hp, hz]
  have hq : m • ((4 : ℕ) • q p) = 0 := by
    have h := hB p
    rw [hdiag, ← mul_smul] at h
    rw [← mul_smul]
    convert h using 1 <;> congr 1 <;> omega
  have htwo : q ((2 : ℕ) • p) = (4 : ℕ) • q p := by
    have h := QuadraticMap.map_add q p p
    rw [hdiag] at h
    simpa only [two_nsmul, show (4 : ℕ) = 2 + 2 from rfl, add_nsmul] using h
  have hx : m • polar q x ((2 : ℕ) • p) = 0 := by
    rw [hn, ← mul_smul, Nat.mul_comm m 2]
    exact hB x
  rw [QuadraticMap.map_add q, smul_add, smul_add, htwo, hq, hx, add_zero, add_zero]

#print axioms symmetric_cube_doubled_torsion

end QuadraticCancellation

section ActualLineClasses

open MonoidalCategory

variable {X : Scheme.{u}}

/-- The tensor-isomorphism class of an actual invertible sheaf, as a unit in
the skeleton monoid. This retains the underlying sheaf, not just a named carrier. -/
def lineClass (M : X.Modules) (hM : Scheme.Modules.IsInvertible M) :
    (Skeleton X.Modules)ˣ where
  val := toSkeleton M
  inv := toSkeleton (Scheme.Modules.dual M)
  val_inv := by
    rw [← Skeleton.toSkeleton_tensorObj]
    exact (toSkeleton_eq_toSkeleton_iff.mpr hM.dual_monoidalV2.2).trans
      Skeleton.one_eq.symm
  inv_val := by
    rw [mul_comm, ← Skeleton.toSkeleton_tensorObj]
    exact (toSkeleton_eq_toSkeleton_iff.mpr hM.dual_monoidalV2.2).trans
      Skeleton.one_eq.symm

/-- Equality of these classes means a global sheaf isomorphism. -/
lemma lineClass_eq_iff (M N : X.Modules) (hM : Scheme.Modules.IsInvertible M)
    (hN : Scheme.Modules.IsInvertible N) :
    lineClass M hM = lineClass N hN ↔ Nonempty (M ≅ N) := by
  constructor
  · intro h
    exact toSkeleton_eq_toSkeleton_iff.mp (congrArg Units.val h)
  · intro h
    apply Units.ext
    exact toSkeleton_eq_toSkeleton_iff.mpr h

lemma lineClass_tensor (M N : X.Modules) (hM : Scheme.Modules.IsInvertible M)
    (hN : Scheme.Modules.IsInvertible N) :
    lineClass (M ⊗ N) (hM.tensor_monoidalV2 hN) = lineClass M hM * lineClass N hN := by
  apply Units.ext
  exact Skeleton.toSkeleton_tensorObj M N

lemma lineClass_unit :
    lineClass (𝟙_ X.Modules) (Scheme.Modules.isInvertible_unit X) = 1 := by
  apply Units.ext
  exact Skeleton.one_eq.symm

lemma lineClass_tensorPow (M : X.Modules) (hM : Scheme.Modules.IsInvertible M)
    (m : ℕ) : lineClass (M.tensorPow m) (hM.tensorPow m) = lineClass M hM ^ m := by
  induction m with
  | zero => exact lineClass_unit
  | succ m ih =>
    change lineClass (M.tensorPow m ⊗ M) _ = lineClass M hM ^ (m + 1)
    rw [lineClass_tensor _ _ (hM.tensorPow m) hM, ih, pow_succ]

/-- A cubical family of actual invertible sheaves yields an actual global
isomorphism after taking the prescribed tensor power. The remaining geometric
provider must instantiate every displayed isomorphism for actual pullbacks. -/
lemma lineFamily_doubled_torsion {G : Type*} [CommGroup G]
    (M : G → X.Modules) (hM : ∀ g, Scheme.Modules.IsInvertible (M g))
    (hunit : Nonempty (M 1 ≅ 𝟙_ X.Modules))
    (hinv : ∀ g, Nonempty (M g⁻¹ ≅ M g))
    (hcube : ∀ a b c, Nonempty
      (M (a * b * c) ⊗ ((M a ⊗ M b) ⊗ M c) ≅
        (M (a * b) ⊗ M (b * c)) ⊗ M (c * a)))
    (m : ℕ) (x p : G) (hp : p ^ (2 * m) = 1) :
    Nonempty ((M (x * p ^ 2)).tensorPow m ≅ (M x).tensorPow m) := by
  let q : Additive G → Additive (Skeleton X.Modules)ˣ :=
    fun a => Additive.ofMul (lineClass (M a.toMul) (hM a.toMul))
  have hz : q 0 = 0 := by
    change lineClass (M 1) (hM 1) = 1
    exact ((lineClass_eq_iff _ _ _ _).mpr hunit).trans lineClass_unit
  have hi (a : Additive G) : q (-a) = q a :=
    (lineClass_eq_iff _ _ (hM _) (hM _)).mpr (hinv a.toMul)
  have hc (a b c : Additive G) :
      q (a + b + c) + (q a + q b + q c) =
        q (a + b) + q (b + c) + q (c + a) := by
    change lineClass (M (a.toMul * b.toMul * c.toMul)) (hM _) *
        (lineClass (M a.toMul) (hM _) * lineClass (M b.toMul) (hM _) * lineClass (M c.toMul) (hM _)) =
      lineClass (M (a.toMul * b.toMul)) (hM _) * lineClass (M (b.toMul * c.toMul)) (hM _) *
        lineClass (M (c.toMul * a.toMul)) (hM _)
    have h := (lineClass_eq_iff _ _
      ((hM _).tensor_monoidalV2 (((hM _).tensor_monoidalV2 (hM _)).tensor_monoidalV2 (hM _)))
      (((hM _).tensor_monoidalV2 (hM _)).tensor_monoidalV2 (hM _))).mpr
        (hcube a.toMul b.toMul c.toMul)
    apply Units.ext
    have hv := congrArg Units.val h
    simpa only [lineClass, Units.val_mk, Units.val_mul, Skeleton.toSkeleton_tensorObj] using hv
  have h := symmetric_cube_doubled_torsion q hz hi hc m
    (Additive.ofMul x) (Additive.ofMul p) hp
  apply (lineClass_eq_iff _ _ ((hM _).tensorPow m) ((hM _).tensorPow m)).mp
  rw [lineClass_tensorPow _ (hM _) m, lineClass_tensorPow _ (hM _) m]
  exact h

#print axioms lineClass_eq_iff
#print axioms lineClass_tensor
#print axioms lineFamily_doubled_torsion

end ActualLineClasses

section ThetaPowerComparison

open MonoidalCategory

lemma originIdeal_invertible : (zero E).ker.IsInvertible := by
  letI : IsProper E.projection := E.proper
  letI : SmoothOfRelativeDimension 1 E.projection := E.smooth
  exact Scheme.Hom.isInvertible_ker_of_comp_eq_id (zero E) (E.law.one (𝟙 _)).property

lemma differential_invertible : Scheme.Modules.IsInvertible E.projection.kaehler := by
  letI : SmoothOfRelativeDimension 1 E.projection := E.smooth
  exact (Scheme.Modules.isLocallyFreeOfRank_one_iff_isInvertible _).mp
    (E.projection.isLocallyFreeOfRank_kaehler_and_topDifferentials_of_smoothOfRelativeDimension 1).1

abbrev actualHodge := (Scheme.Modules.pullback (zero E)).obj E.projection.kaehler

lemma actualHodge_invertible : Scheme.Modules.IsInvertible (actualHodge E) :=
  (differential_invertible E).pullback _

/-- The actual normalized degree-one line before inserting tensor-power-one comparisons. -/
def primitiveThetaLine : E.curve.Modules :=
  Scheme.Modules.dual (zero E).ker.module ⊗ (Scheme.Modules.pullback E.projection).obj (actualHodge E)

lemma primitiveThetaLine_invertible : Scheme.Modules.IsInvertible (primitiveThetaLine E) :=
  (originIdeal_invertible E).isInvertible_module.dual.1.tensor_monoidalV2
    ((actualHodge_invertible E).pullback _)

lemma thetaLine_invertible (m : ℕ) : Scheme.Modules.IsInvertible (thetaLine E m) :=
  ((originIdeal_invertible E).pow m).isInvertible_module.dual.1.tensor_monoidalV2
    (((actualHodge_invertible E).tensorPow m).pullback _)

variable {Y : Scheme.{u}}

/-- The ideal-power comparison is built from actual multiplication of ideal sheaves. -/
def idealPowerIso (I : Y.IdealSheafData) (hI : I.IsInvertible) :
    (m : ℕ) → (0 < m) → ((I ^ m).module ≅ I.module.tensorPow m)
  | 0, hm => (Nat.not_lt_zero _ hm).elim
  | 1, _ => by
    simpa only [pow_one] using (Scheme.Modules.tensorPowOneIso I.module).symm
  | m + 2, _ => by
    rw [pow_succ]
    exact (hI.pow (m + 1) |>.exists_tensor_iso_mul_module hI).choose.symm ≪≫
      (idealPowerIso I hI (m + 1) (Nat.succ_pos _) ⊗ᵢ Iso.refl I.module)

lemma lineClass_dual (M : Y.Modules) (hM : Scheme.Modules.IsInvertible M) :
    lineClass (Scheme.Modules.dual M) hM.dual.1 = (lineClass M hM)⁻¹ := by
  apply Units.ext
  rfl

lemma dualPowerIso_exists (M : Y.Modules) (hM : Scheme.Modules.IsInvertible M) (m : ℕ) :
    Nonempty (Scheme.Modules.dual (M.tensorPow m) ≅ (Scheme.Modules.dual M).tensorPow m) := by
  apply (lineClass_eq_iff _ _ (hM.tensorPow m).dual.1 (hM.dual.1.tensorPow m)).mp
  rw [lineClass_dual _ (hM.tensorPow m), lineClass_tensorPow M hM,
    lineClass_tensorPow _ hM.dual.1, lineClass_dual M hM, inv_pow]

lemma tensorPowerIso_exists (M N : Y.Modules) (hM : Scheme.Modules.IsInvertible M)
    (hN : Scheme.Modules.IsInvertible N) (m : ℕ) :
    Nonempty (M.tensorPow m ⊗ N.tensorPow m ≅ (M ⊗ N).tensorPow m) := by
  apply (lineClass_eq_iff _ _ ((hM.tensorPow m).tensor_monoidalV2 (hN.tensorPow m))
    ((hM.tensor_monoidalV2 hN).tensorPow m)).mp
  rw [lineClass_tensor _ _ (hM.tensorPow m) (hN.tensorPow m),
    lineClass_tensorPow M hM, lineClass_tensorPow N hN,
    lineClass_tensorPow _ (hM.tensor_monoidalV2 hN), lineClass_tensor M N hM hN, mul_pow]

/-- O(m[0]) is the m-th tensor power of O([0]), with the actual identity ideal. -/
def originLinePowerIso (m : ℕ) (hm : 0 < m) :
    Scheme.Modules.dual (((zero E).ker ^ m).module) ≅
      (Scheme.Modules.dual (zero E).ker.module).tensorPow m :=
  ((MonoidalClosed.internalHom (C := E.curve.Modules)).mapIso
    (idealPowerIso (zero E).ker (originIdeal_invertible E) m hm).symm.op).app (𝟙_ _) ≪≫
      (dualPowerIso_exists _ (originIdeal_invertible E).isInvertible_module m).some

/-- This compares the exact frozen theta line with a tensor power, over the
original base, using neither a fibrewise identification nor a Hodge frame. -/
