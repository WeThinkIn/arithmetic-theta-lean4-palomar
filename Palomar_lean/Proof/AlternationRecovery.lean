open CategoryTheory AlgebraicGeometry
def GenericDualAction : Prop := ∀ (k : Type) [Field k] [CharZero k]
    {r : ℕ} {hr : 0 < r} {T : ArithmeticThetaInfinitesimalPolygonR0129.Tower k r hr}
    (M : ArithmeticThetaProjectiveEffectivityR0135.Model k T) (s : ArithmeticThetaAlgebraizedMarkedLineR0136.baseScheme k ⟶ M.X) (d : ℕ)
    (hL : Scheme.Modules.IsInvertible (ArithmeticThetaGenericEvaluationR0140.genericPower k M s d))
    (f : ArithmeticThetaGenericEvaluationR0140.genericScheme k M ⟶ ArithmeticThetaGenericEvaluationR0140.genericScheme k M) (e : ArithmeticThetaGeometricLiftsR0141.Lift k M s d f)
    (v : Γ(Scheme.Modules.dual (ArithmeticThetaGenericEvaluationR0140.genericPower k M s d), ⊤)),
    AlgebraicGeometry.Scheme.Modules.ihomGlobalSectionsEquiv _ _
      (ArithmeticThetaSharpCoverR0194.FullLevelProjectiveRatiosR0194.ArithmeticFamily.SectionAction.globalAct f (ArithmeticThetaSharpCoverR0194.FullLevelProjectiveRatiosR0194.ArithmeticFamily.LocalTheta.dualLift f _ hL e.symm) v) =
      ArithmeticThetaGeometricLiftsR0141.act k M s d f e
        (AlgebraicGeometry.Scheme.Modules.ihomGlobalSectionsEquiv _ _ v)

open CategoryTheory CategoryTheory.MonoidalCategory AlgebraicGeometry NeronModelInfra
open ArithmeticThetaLocalWeierstrassR0203 ArithmeticThetaTateCuspsR0181
open ArithmeticThetaTateSchemeMarkingR0263 ArithmeticThetaSchemeThetaMarkingR0259
open ArithmeticThetaSharpCoverR0194.FullLevelProjectiveRatiosR0194.ArithmeticFamily
variable (hg : GenericDualAction) (hd : InducedDual) (hq : InducedSquare) (hc : ChangeInversion)
variable (k : Type) [Field k] [CharZero k] {m : ℕ} {hm : 0 < m}
 (V : TateLevel k (2*m)) {ζ : kˣ} (Q : LocalTheta.MarkedModel k m hm V ζ) (he : Even m)
namespace Scalar
open ScalarLift
include hg in
lemma matches_act (g : (family k V).curve ⟶ (family k V).curve)
    (f : genericScheme k Q.model ⟶ genericScheme k Q.model)
    (a : Lift (family k V) m g)
    (e : ArithmeticThetaGeometricLiftsR0141.Lift k Q.model Q.origin m f)
    (ha : Matches k V Q he g f a e) (v : Γ(thetaLine (family k V) m, ⊤)) :
    sectionEquiv k V Q he (SectionAction.globalAct g a v) =
      ArithmeticThetaGeometricLiftsR0141.act k Q.model Q.origin m f e
        (sectionEquiv k V Q he v) := by
  obtain ⟨h, ha⟩ := ha
  change LocalTheta.modelFunctional k Q.model Q.origin m Q.cubic _ _ _ =
    ArithmeticThetaGeometricLiftsR0141.act k Q.model Q.origin m f e
      (LocalTheta.modelFunctional k Q.model Q.origin m Q.cubic _ _ v)
  unfold LocalTheta.modelFunctional
  rw [← hg k Q.model Q.origin m (Q.ideal_invertible he) f e,
    ← ha, SectionAction.globalAct_changeLine, SectionAction.globalAct_baseChanged]
  rfl


include hg hd hq hc in
lemma matched_scalar_alternating (hζ : IsPrimitiveRoot (ζ : k) (2*m))
    (a : Lift (family k V) m (translation (family k V) (pointX k V)))
    (ha : Matches k V Q he _ Q.mapA a (Q.canonicalA he hζ))
    (ι : Lift (family k V) m (inverse (family k V)))
    (hι : NormalizedInversion (family k V) m ι)
    (v : Γ(thetaLine (family k V) m, ⊤)) :
    SectionAction.globalAct _ ι (SectionAction.globalAct _ a
      (SectionAction.globalAct _ ι (SectionAction.globalAct _ a v))) = v := by
  let eS := LocalTheta.inducedIdealLift k Q.model Q.origin m (Q.ideal_invertible he)
    Q.cubic _ (modelComparison k V Q he) Q.mapS (inverse (family k V))
    (inversion_square k V Q) (Q.canonicalS he) ι
  have hιact : ∀ w, SectionAction.globalAct _ ι (SectionAction.globalAct _ ι w) = w :=
    SectionAction.globalAct_square _ hι.2.choose ι hι.2.choose_spec
  have heS : ∀ φ, ArithmeticThetaGeometricLiftsR0141.act k Q.model Q.origin m Q.mapS eS
      (ArithmeticThetaGeometricLiftsR0141.act k Q.model Q.origin m Q.mapS eS φ) = φ :=
    hq k Q.model Q.origin m (Q.ideal_invertible he)
      Q.cubic _ (modelComparison k V Q he) Q.mapS _ (inversion_square k V Q)
      (Q.canonicalS he) ι hιact
  have hsym := (hc k Q.model Q.origin m m
    (thetaChartBound m hm he) Q.isModel Q.markedOrigin hm _
    (generic_theta_basis k m hm he Q.tower Q.model Q.isModel Q.origin Q.markedOrigin)
    Q.mapA Q.mapS
    (ArithmeticThetaGeometricLiftsR0141.GeometricScalarLiftR0141.scalarMap_over
      k Q.model Q.rotation Q.scaling Q.inversion Q.actions (ζ^2))
    (ArithmeticThetaGeometricLiftsR0141.GeometricInversionLiftR0141.inversionMap_structure
      k Q.model Q.rotation Q.scaling Q.inversion Q.actions)
    (Q.canonicalA he hζ) (Q.canonicalS he) eS
    (Q.canonical_relations he hζ).2.2.2.1 heS).mpr
      (Q.canonical_relations he hζ).2.2.2.2.1
  have hiMatch : Matches k V Q he _ Q.mapS ι eS :=
    ⟨inversion_square k V Q, (hd k Q.model Q.origin m
      (Q.ideal_invertible he) Q.cubic _ (modelComparison k V Q he) Q.mapS _
      (inversion_square k V Q) (Q.canonicalS he) ι).symm⟩
  apply (sectionEquiv k V Q he).injective
  rw [matches_act hg k V Q he _ _ ι eS hiMatch,
    matches_act hg k V Q he _ _ a _ ha,
    matches_act hg k V Q he _ _ ι eS hiMatch,
    matches_act hg k V Q he _ _ a _ ha]
  exact hsym _


end Scalar
namespace Shift
open ShiftLiftProof
include hg in
lemma matches_action
    (g : (family k V).curve ⟶ (family k V).curve)
    (f : ArithmeticThetaGenericEvaluationR0140.genericScheme k Q.model ⟶
      ArithmeticThetaGenericEvaluationR0140.genericScheme k Q.model)
    (a : Lift (family k V) m g)
    (e : ArithmeticThetaGeometricLiftsR0141.Lift k Q.model Q.origin m f)
    (ha : Matches k V Q he g f a e) (v : Γ(thetaLine (family k V) m, ⊤)) :
    sectionEquiv k V Q he (SectionAction.globalAct g a v) =
      ArithmeticThetaGeometricLiftsR0141.act k Q.model Q.origin m f e
        (sectionEquiv k V Q he v) := by
  obtain ⟨h, ha⟩ := ha
  change LocalTheta.modelFunctional k Q.model Q.origin m Q.cubic _
    (modelComparison k V Q he) (SectionAction.globalAct g a v) = _
  unfold LocalTheta.modelFunctional
  rw [← SectionAction.globalAct_baseChanged Q.cubic.hom g f h a,
    ← SectionAction.globalAct_changeLine, ha]
  exact hg k Q.model Q.origin m (Q.ideal_invertible he) f e _


include hg hd hq hc in
lemma alternating_of_matches (hζ : IsPrimitiveRoot (ζ : k) (2*m))
    (a : Lift (family k V) m (translation (family k V) (pointY k V)))
    (ha : Matches k V Q he _ Q.mapB a (Q.canonicalB he))
    (ι : Lift (family k V) m (inverse (family k V)))
    (hi : NormalizedInversion (family k V) m ι) :
    ∀ v : Γ(thetaLine (family k V) m, ⊤),
      SectionAction.globalAct _ ι (SectionAction.globalAct _ a
        (SectionAction.globalAct _ ι (SectionAction.globalAct _ a v))) = v := by
  let eS := LocalTheta.inducedIdealLift k Q.model Q.origin m (Q.ideal_invertible he)
    Q.cubic _ (modelComparison k V Q he) Q.mapS _ (inversion_commutes k V Q)
    (Q.canonicalS he) ι
  have hS : Matches k V Q he _ Q.mapS ι eS :=
    ⟨inversion_commutes k V Q,
      (hd k Q.model Q.origin m (Q.ideal_invertible he)
        Q.cubic _ (modelComparison k V Q he) Q.mapS _ (inversion_commutes k V Q)
        (Q.canonicalS he) ι).symm⟩
  have hisq : ∀ v : Γ(thetaLine (family k V) m, ⊤),
      SectionAction.globalAct _ ι (SectionAction.globalAct _ ι v) = v := by
    obtain ⟨h, hh⟩ := hi.2
    exact SectionAction.globalAct_square _ h ι hh
  have hesq := hq k Q.model Q.origin m (Q.ideal_invertible he)
    Q.cubic _ (modelComparison k V Q he) Q.mapS _ (inversion_commutes k V Q)
    (Q.canonicalS he) ι hisq
  have hsym := (hc k Q.model Q.origin m m
    (ArithmeticThetaGenericEvaluationR0140.thetaChartBound m hm he) Q.isModel Q.markedOrigin hm
    _ (ArithmeticThetaGenericEvaluationR0140.generic_theta_basis k m hm he Q.tower Q.model
      Q.isModel Q.origin Q.markedOrigin) Q.mapB Q.mapS
    (ArithmeticThetaGeometricLiftsR0141.GeometricShiftLiftR0141.shiftMap_structure k Q.model
      Q.rotation Q.scaling Q.inversion Q.actions)
    (ArithmeticThetaGeometricLiftsR0141.GeometricInversionLiftR0141.inversionMap_structure k Q.model
      Q.rotation Q.scaling Q.inversion Q.actions)
    (Q.canonicalB he) (Q.canonicalS he) eS (Q.canonical_relations he hζ).2.2.2.1 hesq).mpr
      (Q.canonical_relations he hζ).2.2.2.2.2
  intro v
  apply (sectionEquiv k V Q he).injective
  rw [matches_action hg k V Q he _ _ ι eS hS,
    matches_action hg k V Q he _ _ a (Q.canonicalB he) ha,
    matches_action hg k V Q he _ _ ι eS hS,
    matches_action hg k V Q he _ _ a (Q.canonicalB he) ha]
  exact hsym _


end Shift
