import SmoothRootCurve
import NormalizedRootSections

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite
open ArithmeticThetaKummerCover

namespace ArithmeticThetaNormalizedSections

universe u
noncomputable section

/--
The prescribed sections on the actual common-root normalization, together with
the geometric properties of that same cover.  The roots are taken in the one
field generated by the given family, and the tensor-power identities are the
canonical pullback identities.
-/
theorem smooth_proper_root_sections :
    ∀ (X : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral X]
      (k : Type u) [Field k] [CharZero k]
      (f : Quiver.Hom X (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.Smooth f] [AlgebraicGeometry.IsProper f],
      (∀ (W : X.Opens), AlgebraicGeometry.IsAffineOpen W → ∀ [Nonempty W],
        Ring.DimensionLEOne (X.presheaf.obj (Opposite.op W))) →
      ∀ (H : X.Modules), ArithmeticThetaNormalizedSections.IsLineBundle X H →
      ∀ (U : X.Opens) [Nonempty U] (e : ArithmeticThetaLineRoot.LocalFrame X H U)
        (Ω : Type u) [Field Ω] [Algebra X.functionField Ω] (n s : ℕ) (hn : 0 < n)
        (F : Fin s → (((ArithmeticThetaTensorPower.tensorPower X H n)).presheaf.obj
          (Opposite.op (⊤)))) (r : Fin s → Ω)
        (hr : (∀ j, r j ^ n = algebraMap X.functionField Ω
          (ArithmeticThetaNormalizedSections.powerCoefficient X H U e n (F j)))),
      (AlgebraicGeometry.IsFinite (ArithmeticThetaKummerCover.rootCoverMap X Ω s r) ∧
        AlgebraicGeometry.Surjective (ArithmeticThetaKummerCover.rootCoverMap X Ω s r) ∧
        AlgebraicGeometry.Smooth (CategoryTheory.CategoryStruct.comp
          (ArithmeticThetaKummerCover.rootCoverMap X Ω s r) f) ∧
        AlgebraicGeometry.IsProper (CategoryTheory.CategoryStruct.comp
          (ArithmeticThetaKummerCover.rootCoverMap X Ω s r) f) ∧
        FiniteDimensional X.functionField
          (ArithmeticThetaKummerCover.rootCover X Ω s r).functionField ∧
        Module.finrank X.functionField
          (ArithmeticThetaKummerCover.rootCover X Ω s r).functionField ≤ n ^ s) ∧
      (∃ eY : ArithmeticThetaLineRoot.LocalFrame
          (ArithmeticThetaKummerCover.rootCover X Ω s r)
          ((AlgebraicGeometry.Scheme.Modules.pullback
            (ArithmeticThetaKummerCover.rootCoverMap X Ω s r)).obj H)
          ((TopologicalSpace.Opens.map
            (ArithmeticThetaKummerCover.rootCoverMap X Ω s r).base).obj U),
        ArithmeticThetaNormalizedSections.FramePullbackCompatible
          (ArithmeticThetaKummerCover.rootCoverMap X Ω s r) H U e eY ∧
        ∃! t : Fin s →
          ((((AlgebraicGeometry.Scheme.Modules.pullback
            (ArithmeticThetaKummerCover.rootCoverMap X Ω s r)).obj H)).presheaf.obj
            (Opposite.op (⊤))),
          ∀ j,
            (ArithmeticThetaNormalizedSections.sectionCoefficient
              (ArithmeticThetaKummerCover.rootCover X Ω s r)
              ((AlgebraicGeometry.Scheme.Modules.pullback
                (ArithmeticThetaKummerCover.rootCoverMap X Ω s r)).obj H)
              ((TopologicalSpace.Opens.map
                (ArithmeticThetaKummerCover.rootCoverMap X Ω s r).base).obj U) eY (t j) =
              ArithmeticThetaKummerCover.coverRoot X Ω n s hn r
                (fun j => ArithmeticThetaNormalizedSections.powerCoefficient X H U e n (F j))
                hr j) ∧
            (ArithmeticThetaTensorPower.tensorPowerSection
              (ArithmeticThetaKummerCover.rootCover X Ω s r)
              ((AlgebraicGeometry.Scheme.Modules.pullback
                (ArithmeticThetaKummerCover.rootCoverMap X Ω s r)).obj H) n ⊤ (t j) =
              ArithmeticThetaNormalizedSections.pullbackPowerSection
                (ArithmeticThetaKummerCover.rootCoverMap X Ω s r) H n (F j))) := by
  intro X _ k _ _ f _ _ hdim H hH U _ e Ω _ _ n s hn F r hr
  obtain ⟨hnoeth, hchar, hnormal⟩ :=
    ArithmeticThetaSmoothNormality.smooth_normalization_prerequisites X k f
  letI : AlgebraicGeometry.IsLocallyNoetherian X := hnoeth
  letI : CharZero X.functionField := hchar
  have hgeom := ArithmeticThetaKummerCover.rootCover_geometry X Ω n s hn r
    (fun j => ArithmeticThetaNormalizedSections.powerCoefficient X H U e n (F j)) hr hnormal
  have hfinite := hgeom.2.1
  have hsurj := hgeom.2.2.2.1
  have hsmooth := ArithmeticThetaNormalizedCurve.rootCover_smooth X k f hdim Ω n s hn r
    (fun j => ArithmeticThetaNormalizedSections.powerCoefficient X H U e n (F j)) hr
  have hproper := ArithmeticThetaKummerCover.rootCover_proper_over X Ω n s hn r
    (fun j => ArithmeticThetaNormalizedSections.powerCoefficient X H U e n (F j)) hr hnormal
    (AlgebraicGeometry.Spec (CommRingCat.of k)) f
  have hdegree := ArithmeticThetaKummerCover.rootCover_functionField_degree X Ω n s hn r
    (fun j => ArithmeticThetaNormalizedSections.powerCoefficient X H U e n (F j)) hr
  refine ⟨⟨hfinite, hsurj, hsmooth, hproper, hdegree.1, hdegree.2⟩, ?_⟩
  exact ArithmeticThetaNormalizedSections.rootCover_regular_sections X H hH U e Ω n s hn F r hr

end
end ArithmeticThetaNormalizedSections

#print axioms ArithmeticThetaNormalizedSections.smooth_proper_root_sections
