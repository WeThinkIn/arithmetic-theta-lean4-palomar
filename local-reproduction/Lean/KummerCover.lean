import KummerDegree
import NormalizationFinite

open AlgebraicGeometry CategoryTheory TopologicalSpace
open ArithmeticThetaKummer ArithmeticThetaNormalization
  ArithmeticThetaNormalizationField ArithmeticThetaNormalizationFinite

namespace ArithmeticThetaKummerCover

universe u
noncomputable section

variable (X : Scheme.{u}) [IsIntegral X]

/-- The algebra on the actual normalization function field is its actual geometric pullback. -/
instance normalizationFunctionFieldAlgebra (E : Type u) [Field E] [Algebra X.functionField E] :
    Algebra X.functionField (extensionNormalization X E).functionField :=
  (normalizationBaseFieldMap X E).hom.toAlgebra

/-- The canonical field equivalence is an equivalence over the actual base field. -/
def normalizationFunctionFieldAlgEquiv (E : Type u) [Field E] [Algebra X.functionField E]
    [Algebra.IsAlgebraic X.functionField E] :
    (extensionNormalization X E).functionField ≃ₐ[X.functionField] E :=
  { normalizationFunctionFieldEquiv X E with
    commutes' := normalizationFunctionFieldEquiv_base_compat X E }

theorem normalizationFieldMaps_actual (E : Type u) [Field E] [Algebra X.functionField E]
    [Algebra.IsAlgebraic X.functionField E] :
    algebraMap X.functionField (extensionNormalization X E).functionField =
      (normalizationBaseFieldMap X E).hom ∧
    (normalizationFunctionFieldAlgEquiv X E).toRingHom =
      (normalizationFunctionFieldMap X E).hom := ⟨rfl, rfl⟩

theorem normalizationFunctionField_finrank (E : Type u) [Field E] [Algebra X.functionField E]
    [Algebra.IsAlgebraic X.functionField E] :
    Module.finrank X.functionField (extensionNormalization X E).functionField =
      Module.finrank X.functionField E :=
  (normalizationFunctionFieldAlgEquiv X E).toLinearEquiv.finrank_eq

variable (Ω : Type u) [Field Ω] [Algebra X.functionField Ω]

/-- The one common subfield generated by exactly the prescribed root family. -/
abbrev generatedRootField (s : ℕ) (r : Fin s → Ω) : IntermediateField X.functionField Ω :=
  IntermediateField.adjoin X.functionField (Set.range r)

/-- Every prescribed root belongs to this same generated field. -/
def generatedRoot (s : ℕ) (r : Fin s → Ω) (j : Fin s) : generatedRootField X Ω s r :=
  ⟨r j, IntermediateField.subset_adjoin _ _ (Set.mem_range_self j)⟩

theorem generatedRoot_pow (N s : ℕ) (r : Fin s → Ω) (a : Fin s → X.functionField)
    (hr : ∀ j, r j ^ N = algebraMap X.functionField Ω (a j)) (j : Fin s) :
    generatedRoot X Ω s r j ^ N =
      algebraMap X.functionField (generatedRootField X Ω s r) (a j) := by
  apply Subtype.ext
  exact hr j

theorem generatedRootField_degree (N s : ℕ) (hN : 0 < N)
    (r : Fin s → Ω) (a : Fin s → X.functionField)
    (hr : ∀ j, r j ^ N = algebraMap X.functionField Ω (a j)) :
    FiniteDimensional X.functionField (generatedRootField X Ω s r) ∧
      Module.finrank X.functionField (generatedRootField X Ω s r) ≤ N ^ s :=
  family_root_degree X.functionField Ω N s hN r a hr

/-- The actual relative normalization in the single generated field. -/
abbrev rootCover (s : ℕ) (r : Fin s → Ω) : Scheme.{u} :=
  extensionNormalization X (generatedRootField X Ω s r)

abbrev rootCoverMap (s : ℕ) (r : Fin s → Ω) : rootCover X Ω s r ⟶ X :=
  extensionFromNormalization X (generatedRootField X Ω s r)

/-- An actual rational function on the actual root cover, selected from the prescribed family. -/
def coverRoot (N s : ℕ) (hN : 0 < N) (r : Fin s → Ω) (a : Fin s → X.functionField)
    (hr : ∀ j, r j ^ N = algebraMap X.functionField Ω (a j)) (j : Fin s) :
    (rootCover X Ω s r).functionField :=
  letI := (generatedRootField_degree X Ω N s hN r a hr).1
  (normalizationFunctionFieldAlgEquiv X (generatedRootField X Ω s r)).symm
    (generatedRoot X Ω s r j)

/-- The constructed rational function evaluates to the exact prescribed ambient root. -/
theorem coverRoot_prescribed (N s : ℕ) (hN : 0 < N)
    (r : Fin s → Ω) (a : Fin s → X.functionField)
    (hr : ∀ j, r j ^ N = algebraMap X.functionField Ω (a j)) (j : Fin s) :
    ((normalizationFunctionFieldMap X (generatedRootField X Ω s r)
      (coverRoot X Ω N s hN r a hr j)) : Ω) = r j := by
  let := (generatedRootField_degree X Ω N s hN r a hr).1
  change ((normalizationFunctionFieldAlgEquiv X (generatedRootField X Ω s r))
    ((normalizationFunctionFieldAlgEquiv X (generatedRootField X Ω s r)).symm
      (generatedRoot X Ω s r j)) : Ω) = r j
  rw [AlgEquiv.apply_symm_apply]
  rfl

theorem coverRoot_pow (N s : ℕ) (hN : 0 < N)
    (r : Fin s → Ω) (a : Fin s → X.functionField)
    (hr : ∀ j, r j ^ N = algebraMap X.functionField Ω (a j)) (j : Fin s) :
    coverRoot X Ω N s hN r a hr j ^ N =
      normalizationBaseFieldMap X (generatedRootField X Ω s r) (a j) := by
  let := (generatedRootField_degree X Ω N s hN r a hr).1
  change (normalizationFunctionFieldAlgEquiv X (generatedRootField X Ω s r)).symm
    (generatedRoot X Ω s r j) ^ N = _
  rw [← map_pow, generatedRoot_pow X Ω N s r a hr]
  exact (normalizationFunctionFieldAlgEquiv X (generatedRootField X Ω s r)).symm.commutes (a j)

theorem rootCover_functionField_degree (N s : ℕ) (hN : 0 < N)
    (r : Fin s → Ω) (a : Fin s → X.functionField)
    (hr : ∀ j, r j ^ N = algebraMap X.functionField Ω (a j)) :
    FiniteDimensional X.functionField (rootCover X Ω s r).functionField ∧
      Module.finrank X.functionField (rootCover X Ω s r).functionField ≤ N ^ s := by
  have hd := generatedRootField_degree X Ω N s hN r a hr
  let := hd.1
  refine ⟨Module.Finite.equiv
    (normalizationFunctionFieldAlgEquiv X (generatedRootField X Ω s r)).symm.toLinearEquiv, ?_⟩
  rw [normalizationFunctionField_finrank X (generatedRootField X Ω s r)]
  exact hd.2

/-- Roots of actual regular base-chart functions extend over the actual normalization chart. -/
theorem coverRoot_affine_regular (N s : ℕ) (hN : 0 < N)
    (r : Fin s → Ω) (a : Fin s → X.functionField)
    (hr : ∀ j, r j ^ N = algebraMap X.functionField Ω (a j))
    (j : Fin s) (U : X.Opens) (hU : IsAffineOpen U) [Nonempty U]
    (b : Γ(X,U)) (hb : X.germToFunctionField U b = a j) :
    ∃ c : Γ(rootCover X Ω s r, rootCoverMap X Ω s r ⁻¹ᵁ U),
      (rootCover X Ω s r).germToFunctionField (rootCoverMap X Ω s r ⁻¹ᵁ U) c =
        coverRoot X Ω N s hN r a hr j := by
  let E := generatedRootField X Ω s r
  let Y := rootCover X Ω s r
  let V := rootCoverMap X Ω s r ⁻¹ᵁ U
  have hV : IsAffineOpen V := hU.preimage (rootCoverMap X Ω s r)
  let := functionField_isFractionRing_of_isAffineOpen Y V hV
  let := extensionNormalization_chart_integrallyClosed X E U hU
  apply IsIntegrallyClosed.exists_algebraMap_eq_of_isIntegral_pow hN
  apply IsIntegrallyClosed.isIntegral_iff.mpr
  refine ⟨(rootCoverMap X Ω s r).app U b, ?_⟩
  change Y.germToFunctionField V ((rootCoverMap X Ω s r).app U b) = _
  rw [coverRoot_pow X Ω N s hN r a hr]
  have hg := congr($(normalizationBaseFieldMap_germ X E U) b)
  change normalizationBaseFieldMap X E (X.germToFunctionField U b) =
    Y.germToFunctionField V ((rootCoverMap X Ω s r).app U b) at hg
  rw [← hg, hb]

/-- The same chart root is regular in each actual stalk above that base chart. -/
theorem coverRoot_stalk_regular (N s : ℕ) (hN : 0 < N)
    (r : Fin s → Ω) (a : Fin s → X.functionField)
    (hr : ∀ j, r j ^ N = algebraMap X.functionField Ω (a j))
    (j : Fin s) (U : X.Opens) (hU : IsAffineOpen U) [Nonempty U]
    (b : Γ(X,U)) (hb : X.germToFunctionField U b = a j)
    (y : rootCover X Ω s r) (hy : rootCoverMap X Ω s r y ∈ U) :
    ∃ c : (rootCover X Ω s r).presheaf.stalk y,
      algebraMap ((rootCover X Ω s r).presheaf.stalk y)
        (rootCover X Ω s r).functionField c = coverRoot X Ω N s hN r a hr j := by
  obtain ⟨c, hc⟩ := coverRoot_affine_regular X Ω N s hN r a hr j U hU b hb
  refine ⟨(rootCover X Ω s r).presheaf.germ (rootCoverMap X Ω s r ⁻¹ᵁ U) y hy c, ?_⟩
  exact (Scheme.algebraMap_germ_eq_germToFunctionField
    (X := rootCover X Ω s r) (U := rootCoverMap X Ω s r ⁻¹ᵁ U) hy c).trans hc

/-- A root is regular at a point whenever its base coefficient is regular at the image point. -/
theorem coverRoot_regular_of_base_stalk (N s : ℕ) (hN : 0 < N)
    (r : Fin s → Ω) (a : Fin s → X.functionField)
    (hr : ∀ j, r j ^ N = algebraMap X.functionField Ω (a j))
    (j : Fin s) (y : rootCover X Ω s r)
    (ha : ∃ b : X.presheaf.stalk (rootCoverMap X Ω s r y),
      algebraMap (X.presheaf.stalk (rootCoverMap X Ω s r y)) X.functionField b = a j) :
    ∃ c : (rootCover X Ω s r).presheaf.stalk y,
      algebraMap ((rootCover X Ω s r).presheaf.stalk y)
        (rootCover X Ω s r).functionField c = coverRoot X Ω N s hN r a hr j := by
  obtain ⟨b, hb⟩ := ha
  obtain ⟨U, hyU, c, hc⟩ := X.presheaf.exists_germ_eq b
  obtain ⟨V, hV, hyV, hVU⟩ := exists_isAffineOpen_mem_and_subset hyU
  let : Nonempty V := ⟨⟨_, hyV⟩⟩
  let cV := X.presheaf.map (homOfLE hVU).op c
  have hvgerm : X.presheaf.germ V (rootCoverMap X Ω s r y) hyV cV = b := by
    exact (X.presheaf.germ_res_apply (homOfLE hVU) (rootCoverMap X Ω s r y) hyV c).trans hc
  have hfield : X.germToFunctionField V cV = a j := by
    rw [← Scheme.algebraMap_germ_eq_germToFunctionField X hyV cV, hvgerm, hb]
  exact coverRoot_stalk_regular X Ω N s hN r a hr j V hV cV hfield y hyV

variable [IsLocallyNoetherian X] [CharZero X.functionField]

/-- The common-root cover is an actual finite, proper, surjective morphism of integral schemes. -/
theorem rootCover_geometry (N s : ℕ) (hN : 0 < N)
    (r : Fin s → Ω) (a : Fin s → X.functionField)
    (hr : ∀ j, r j ^ N = algebraMap X.functionField Ω (a j))
    (hX : ∀ (U : X.Opens), IsAffineOpen U → ∀ [Nonempty U], IsIntegrallyClosed Γ(X,U)) :
    IsIntegral (rootCover X Ω s r) ∧ IsFinite (rootCoverMap X Ω s r) ∧
      IsProper (rootCoverMap X Ω s r) ∧ Surjective (rootCoverMap X Ω s r) ∧
      IsLocallyNoetherian (rootCover X Ω s r) := by
  let := (generatedRootField_degree X Ω N s hN r a hr).1
  exact ⟨inferInstance,
    extensionFromNormalization_finite X (generatedRootField X Ω s r) hX,
    extensionFromNormalization_proper X (generatedRootField X Ω s r) hX,
    extensionFromNormalization_surjective X (generatedRootField X Ω s r),
    extensionNormalization_locallyNoetherian X (generatedRootField X Ω s r) hX⟩

theorem rootCover_proper_over (N s : ℕ) (hN : 0 < N)
    (r : Fin s → Ω) (a : Fin s → X.functionField)
    (hr : ∀ j, r j ^ N = algebraMap X.functionField Ω (a j))
    (hX : ∀ (U : X.Opens), IsAffineOpen U → ∀ [Nonempty U], IsIntegrallyClosed Γ(X,U))
    (S : Scheme.{u}) (f : X ⟶ S) [IsProper f] :
    IsProper (rootCoverMap X Ω s r ≫ f) := by
  let := (generatedRootField_degree X Ω N s hN r a hr).1
  exact extensionNormalization_proper_over X (generatedRootField X Ω s r) hX S f

/-- Actual algebraic-closure selection produces one finite root cover with its true field-degree bound. -/
theorem exists_closure_rootCover (N s : ℕ) (hN : 0 < N) (a : Fin s → X.functionField)
    (hX : ∀ (U : X.Opens), IsAffineOpen U → ∀ [Nonempty U], IsIntegrallyClosed Γ(X,U)) :
    ∃ r : Fin s → AlgebraicClosure X.functionField,
      (∀ j, r j ^ N = algebraMap X.functionField (AlgebraicClosure X.functionField) (a j)) ∧
      IsFinite (rootCoverMap X (AlgebraicClosure X.functionField) s r) ∧
      IsProper (rootCoverMap X (AlgebraicClosure X.functionField) s r) ∧
      Surjective (rootCoverMap X (AlgebraicClosure X.functionField) s r) ∧
      FiniteDimensional X.functionField
        (rootCover X (AlgebraicClosure X.functionField) s r).functionField ∧
      Module.finrank X.functionField
        (rootCover X (AlgebraicClosure X.functionField) s r).functionField ≤ N ^ s ∧
      ∃ t : Fin s → (rootCover X (AlgebraicClosure X.functionField) s r).functionField,
        ∀ j, t j ^ N = normalizationBaseFieldMap X
          (generatedRootField X (AlgebraicClosure X.functionField) s r) (a j) := by
  obtain ⟨r, hr, _, _⟩ := exists_closure_roots_degree X.functionField N s hN a
  have hg := rootCover_geometry X (AlgebraicClosure X.functionField) N s hN r a hr hX
  have hd := rootCover_functionField_degree X (AlgebraicClosure X.functionField) N s hN r a hr
  exact ⟨r, hr, hg.2.1, hg.2.2.1, hg.2.2.2.1, hd.1, hd.2,
    coverRoot X (AlgebraicClosure X.functionField) N s hN r a hr,
    coverRoot_pow X (AlgebraicClosure X.functionField) N s hN r a hr⟩

end
end ArithmeticThetaKummerCover
